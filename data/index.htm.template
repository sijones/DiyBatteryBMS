<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DIY Battery BMS</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='3' y='8' width='23' height='16' rx='3' fill='none' stroke='%2335c9d4' stroke-width='2.5'/%3E%3Crect x='27' y='13' width='3' height='6' rx='1.5' fill='%2335c9d4'/%3E%3Crect x='6.5' y='11.5' width='4.5' height='9' rx='1' fill='%233fbf6a'/%3E%3Crect x='12.5' y='11.5' width='4.5' height='9' rx='1' fill='%233fbf6a'/%3E%3Crect x='18.5' y='11.5' width='4.5' height='9' rx='1' fill='%233fbf6a' opacity='0.45'/%3E%3C/svg%3E">
  <style>
    /* ============================================================
       DIY Battery BMS - instrumentation panel
       Design tokens. Dark is the default (wall-mounted / night use);
       light mode is a full first-class theme, not an afterthought.
       The theme toggle writes data-theme on <html>, which wins over
       the prefers-color-scheme default in both directions.
       ============================================================ */
    :root {
      --bg:          #10151c;
      --panel:       #171e27;
      --panel-2:     #1e2732;
      --raised:      #26313f;
      --line:        #2c3746;
      --line-soft:   #232d3a;
      --text:        #e6edf5;
      --text-dim:    #94a3b4;
      --text-faint:  #6b7889;
      --accent:      #35c9d4;
      --accent-dim:  #1d7f88;
      --accent-ink:  #06222a;
      --ok:          #3fbf6a;
      --warn:        #e0a33a;
      --err:         #e5544b;
      --charge:      #3fbf6a;
      --discharge:   #e0a33a;
      --info:        #4a9fe0;
      --shadow:      0 1px 2px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.28);
      --shadow-sm:   0 1px 2px rgba(0,0,0,.35);
      --focus:       0 0 0 2px var(--bg), 0 0 0 4px var(--accent);
      --r-sm: 4px;  --r: 7px;  --r-lg: 11px;
      --mono: ui-monospace, 'Cascadia Mono', 'SF Mono', 'JetBrains Mono', Consolas, 'DejaVu Sans Mono', monospace;
      --sans: 'Segoe UI Variable Text', 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
    }

    @media (prefers-color-scheme: light) {
      :root:not([data-theme="dark"]) {
        --bg:         #eef1f5;
        --panel:      #ffffff;
        --panel-2:    #f5f7fa;
        --raised:     #e9edf3;
        --line:       #d3dae3;
        --line-soft:  #e4e9ef;
        --text:       #16202c;
        --text-dim:   #57657a;
        --text-faint: #7d8a9c;
        --accent:     #0d7f8a;
        --accent-dim: #8fd6dc;
        --accent-ink: #ffffff;
        --ok:         #1f8f4a;
        --warn:       #a8701a;
        --err:        #c33529;
        --charge:     #1f8f4a;
        --discharge:  #a8701a;
        --info:       #1a6fb5;
        --shadow:     0 1px 2px rgba(16,32,48,.06), 0 8px 24px rgba(16,32,48,.08);
        --shadow-sm:  0 1px 2px rgba(16,32,48,.08);
      }
    }

    :root[data-theme="light"] {
      --bg:         #eef1f5;
      --panel:      #ffffff;
      --panel-2:    #f5f7fa;
      --raised:     #e9edf3;
      --line:       #d3dae3;
      --line-soft:  #e4e9ef;
      --text:       #16202c;
      --text-dim:   #57657a;
      --text-faint: #7d8a9c;
      --accent:     #0d7f8a;
      --accent-dim: #8fd6dc;
      --accent-ink: #ffffff;
      --ok:         #1f8f4a;
      --warn:       #a8701a;
      --err:        #c33529;
      --charge:     #1f8f4a;
      --discharge:  #a8701a;
      --info:       #1a6fb5;
      --shadow:     0 1px 2px rgba(16,32,48,.06), 0 8px 24px rgba(16,32,48,.08);
      --shadow-sm:  0 1px 2px rgba(16,32,48,.08);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    /* Several toggled elements carry classes that set display:grid/flex, which would
       otherwise beat the UA stylesheet's [hidden] rule. Make [hidden] authoritative. */
    [hidden] { display: none !important; }

    body {
      background: var(--bg);
      /* faint grid, like a panel meter face */
      background-image:
        linear-gradient(var(--line-soft) 1px, transparent 1px),
        linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
      background-size: 44px 44px, 44px 44px;
      min-height: 100vh;
      padding: 18px;
      color: var(--text);
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.45;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 1180px;
      margin: 0 auto;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    /* ---------- Header ---------- */
    .header {
      background: var(--panel-2);
      border-bottom: 1px solid var(--line);
      padding: 14px 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .brand { display: flex; align-items: baseline; gap: 10px; flex: 1; min-width: 200px; }

    .brand h1 {
      font-size: 17px;
      font-weight: 600;
      letter-spacing: .02em;
      color: var(--text);
    }
    .brand h1 .accent { color: var(--accent); }

    .brand .subtitle {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--text-faint);
      letter-spacing: .04em;
    }

    .header-meta {
      display: flex;
      align-items: center;
      gap: 14px;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--text-dim);
      flex-wrap: wrap;
    }

    .header-meta .meta-item { display: flex; align-items: center; gap: 5px; }
    .header-meta .meta-item b { font-weight: 600; color: var(--text); }

    .icon-btn {
      background: transparent;
      border: 1px solid var(--line);
      color: var(--text-dim);
      border-radius: var(--r-sm);
      width: 30px; height: 30px;
      display: inline-flex; align-items: center; justify-content: center;
      cursor: pointer;
      font-size: 14px;
      line-height: 1;
      transition: color .15s, border-color .15s, background .15s;
      padding: 0;
    }
    .icon-btn:hover { color: var(--accent); border-color: var(--accent-dim); background: var(--raised); }

    /* ---------- Connection pill ---------- */
    .conn-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--text-dim);
      border: 1px solid var(--line);
      border-radius: 100px;
      padding: 3px 10px 3px 8px;
      letter-spacing: .03em;
    }

    .dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--err);
      flex-shrink: 0;
      transition: background .3s, box-shadow .3s;
    }
    .dot.connected { background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent); }
    .conn-status.online { color: var(--text); border-color: color-mix(in srgb, var(--ok) 40%, var(--line)); }

    /* ---------- Tabs ---------- */
    .tabs {
      display: flex;
      background: var(--panel-2);
      border-bottom: 1px solid var(--line);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .tabs::-webkit-scrollbar { display: none; }

    .tab-button {
      flex: 1 0 auto;
      min-width: 96px;
      padding: 11px 16px;
      border: none;
      background: none;
      cursor: pointer;
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--text-faint);
      transition: color .15s, background .15s;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }
    .tab-button:hover { color: var(--text); background: var(--raised); }
    .tab-button[aria-selected="true"] {
      color: var(--accent);
      border-bottom-color: var(--accent);
      background: var(--panel);
    }
    .tab-button:focus-visible { outline: none; box-shadow: var(--focus); }

    .content { padding: 20px 22px 26px; }

    .tab-pane { display: none; }
    .tab-pane.active { display: block; animation: fadeIn .22s ease both; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }

    .pane-title {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--text-faint);
      margin-bottom: 16px;
    }

    /* ---------- Forms ---------- */
    .form-group { margin-bottom: 12px; }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 14px;
    }
    .form-row.full { grid-template-columns: 1fr; }
    .form-row.col3 { grid-template-columns: repeat(3, 1fr); }
    .form-row.col4 { grid-template-columns: repeat(4, 1fr); }

    /* Dashboard readouts. A fixed column count (rather than auto-fit) so that every
       row lines up with the ones above it - auto-fit sizes each grid independently,
       which leaves 3-item rows visibly wider than 4-item rows. */
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 12px;
    }

    label {
      display: block;
      margin-bottom: 5px;
      font-weight: 500;
      color: var(--text-dim);
      font-size: 12px;
    }

    input[type="text"], input[type="textbox"], input[type="password"],
    input[type="number"], input[type="file"], select {
      width: 100%;
      padding: 8px 10px;
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      color: var(--text);
      font-family: var(--mono);
      font-size: 13px;
      transition: border-color .15s, box-shadow .15s;
    }
    input[type="file"] { font-family: var(--sans); padding: 7px 10px; }
    select { font-family: var(--sans); cursor: pointer; }

    input:focus, select:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    }

    /* Invalid / cross-field validation */
    input.invalid, select.invalid {
      border-color: var(--err);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--err) 15%, transparent);
    }
    .field-error {
      display: none;
      margin-top: 4px;
      font-size: 11.5px;
      color: var(--err);
      line-height: 1.35;
    }
    .field-error.show { display: block; }
    /* Advisory: the value is accepted but the resulting behaviour is probably
       not what was intended. Amber rather than red so it reads as a caution. */
    .field-error.warn { color: var(--warn); }
    input.warn { border-color: var(--warn); }

    input[type="checkbox"] {
      width: 17px; height: 17px;
      cursor: pointer;
      accent-color: var(--accent);
      flex-shrink: 0;
    }

    .password-wrapper { position: relative; display: flex; align-items: center; }
    .password-wrapper input { padding-right: 58px; }

    .password-toggle {
      position: absolute;
      right: 5px;
      cursor: pointer;
      color: var(--text-dim);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .04em;
      text-transform: uppercase;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      padding: 4px 8px;
      transition: color .15s, border-color .15s;
    }
    .password-toggle:hover { color: var(--accent); border-color: var(--accent-dim); }

    /* ---------- Buttons ---------- */
    button {
      padding: 9px 16px;
      background: var(--raised);
      color: var(--text);
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      cursor: pointer;
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 500;
      transition: background .15s, border-color .15s, color .15s;
    }
    button:hover { border-color: var(--accent-dim); color: var(--accent); }
    button:active { transform: translateY(1px); }
    button:focus-visible { outline: none; box-shadow: var(--focus); }
    button:disabled { opacity: .45; cursor: not-allowed; transform: none; }
    button:disabled:hover { border-color: var(--line); color: var(--text); }

    .btn-primary {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-ink);
      font-weight: 600;
    }
    .btn-primary:hover { background: color-mix(in srgb, var(--accent) 85%, #fff); color: var(--accent-ink); border-color: var(--accent); }

    .btn-danger { color: var(--err); border-color: color-mix(in srgb, var(--err) 45%, var(--line)); }
    .btn-danger:hover { background: color-mix(in srgb, var(--err) 12%, transparent); color: var(--err); border-color: var(--err); }

    .button-group { display: flex; gap: 10px; margin-top: 16px; flex-wrap: wrap; }
    .button-group button { flex: 1; min-width: 150px; }

    .checkbox-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .checkbox-row label { margin-bottom: 0; color: var(--text); font-size: 13px; }

    /* ---------- Section titles ---------- */
    .section-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 24px 0 12px;
    }
    .section-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--line);
    }
    .section-title:first-child { margin-top: 0; }

    /* ---------- Stat boxes / readouts ---------- */
    .stat-box {
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-left: 3px solid var(--accent);
      border-radius: var(--r);
      padding: 11px 13px;
      min-height: 66px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 3px;
    }
    .stat-box.stat-charge    { border-left-color: var(--charge); }
    .stat-box.stat-discharge { border-left-color: var(--discharge); }
    .stat-box.stat-status    { border-left-color: var(--info); }

    .stat-label {
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--text-faint);
    }

    .stat-value {
      font-family: var(--mono);
      font-size: 19px;
      font-weight: 600;
      color: var(--text);
      line-height: 1.15;
      font-variant-numeric: tabular-nums;
    }
    .stat-value .unit {
      font-size: 12px;
      font-weight: 400;
      color: var(--text-faint);
      margin-left: 1px;
    }
    .stat-value.sm { font-size: 14px; }

    /* semantic state classes (replaces inline .style.color writes) */
    .v-ok    { color: var(--ok) !important; }
    .v-warn  { color: var(--warn) !important; }
    .v-err   { color: var(--err) !important; }
    .v-info  { color: var(--info) !important; }
    .v-accent{ color: var(--accent) !important; }
    .v-dim   { color: var(--text-faint) !important; }

    /* ---------- Toggle switch (charge / discharge) ---------- */
    .toggle-box {
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-left: 3px solid var(--line);
      border-radius: var(--r);
      padding: 11px 13px;
      min-height: 66px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      cursor: pointer;
      transition: border-color .18s, background .18s;
      text-align: left;
      width: 100%;
      font-family: inherit;
    }
    .toggle-box:hover { background: var(--raised); border-color: var(--line); }
    .toggle-box:focus-visible { outline: none; box-shadow: var(--focus); }
    .toggle-box[aria-pressed="true"].tg-charge    { border-left-color: var(--charge); }
    .toggle-box[aria-pressed="true"].tg-discharge { border-left-color: var(--discharge); }

    .toggle-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .toggle-state {
      font-family: var(--mono);
      font-size: 14px;
      font-weight: 600;
      color: var(--text-faint);
      letter-spacing: .04em;
    }
    .toggle-box[aria-pressed="true"] .toggle-state { color: var(--ok); }

    .switch {
      position: relative;
      width: 40px; height: 22px;
      border-radius: 100px;
      background: var(--line);
      flex-shrink: 0;
      transition: background .2s;
    }
    .switch::after {
      content: '';
      position: absolute;
      top: 3px; left: 3px;
      width: 16px; height: 16px;
      border-radius: 50%;
      background: var(--text-faint);
      transition: transform .2s cubic-bezier(.3,.8,.4,1), background .2s;
    }
    .toggle-box[aria-pressed="true"] .switch { background: color-mix(in srgb, var(--ok) 40%, var(--line)); }
    .toggle-box[aria-pressed="true"] .switch::after { transform: translateX(18px); background: var(--ok); }

    /* ---------- Battery visual ---------- */
    .battery-visual {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 26px;
      margin: 8px 0 18px;
      flex-wrap: wrap;
    }

    .status-stack { display: flex; flex-direction: column; gap: 7px; min-width: 130px; }

    .status-dot-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--text-dim);
      letter-spacing: .03em;
    }

    .battery-col { display: flex; flex-direction: column; align-items: center; gap: 9px; }
    .battery-rig { display: flex; align-items: center; }

    /* ---------- SOC override notice ----------
       The firmware deliberately reports a different SOC to the inverter in a few
       cases (holding 99% until absorption completes, "never send 100%", the
       force-charge trick). Without this the dashboard and the inverter disagree
       and there is nothing on screen to explain why. */
    .soc-override {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      max-width: 280px;
      text-align: center;
      animation: fadeIn .25s ease both;
    }

    .soc-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 4px 10px;
      border-radius: 100px;
      background: color-mix(in srgb, var(--info) 14%, var(--panel));
      border: 1px solid color-mix(in srgb, var(--info) 45%, var(--line));
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: .04em;
      white-space: nowrap;
    }
    .soc-chip-label { color: var(--text-dim); text-transform: uppercase; }
    .soc-chip-value { color: var(--info); font-weight: 700; font-size: 13px; }

    .soc-why { font-size: 11.5px; color: var(--text-faint); line-height: 1.4; }

    /* Mark the gauge itself, so the real number is never read in isolation */
    .battery-container.overridden { border-color: color-mix(in srgb, var(--info) 55%, var(--line)); }
    .battery-container.overridden .battery-percentage::after {
      content: '*';
      color: var(--info);
      font-size: 20px;
      vertical-align: super;
      margin-left: 1px;
    }

    .battery-container {
      position: relative;
      width: 216px;
      height: 96px;
      border: 2px solid var(--line);
      border-radius: var(--r);
      overflow: hidden;
      background: var(--bg);
    }

    .battery-level {
      position: absolute;
      left: 0; top: 0;
      height: 100%;
      width: 0;
      background: var(--ok);
      opacity: .22;
      transition: width .6s cubic-bezier(.4,0,.2,1), background .3s;
    }
    .battery-level.low    { background: var(--err); }
    .battery-level.medium { background: var(--warn); }
    .battery-level.high   { background: var(--ok); }

    /* segment ticks over the fill, like a real gauge */
    .battery-container::after {
      content: '';
      position: absolute; inset: 0;
      background-image: linear-gradient(90deg, var(--line) 1px, transparent 1px);
      background-size: 21.6px 100%;
      opacity: .5;
      pointer-events: none;
    }

    .battery-percentage {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--mono);
      font-size: 34px;
      font-weight: 600;
      color: var(--text);
      font-variant-numeric: tabular-nums;
      z-index: 1;
    }

    .battery-tip {
      width: 5px; height: 34px;
      background: var(--line);
      border-radius: 0 3px 3px 0;
    }

    .battery-wave { position: absolute; inset: 0; display: none; z-index: 0; }
    .battery-wave.active { display: block; }
    .battery-wave.charging {
      background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ok) 30%, transparent), transparent);
      animation: sweep 2.2s linear infinite;
    }
    .battery-wave.discharging {
      background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--warn) 30%, transparent), transparent);
      animation: sweep 2.2s linear infinite reverse;
    }
    @keyframes sweep { from { transform: translateX(-100%); } to { transform: translateX(100%); } }

    /* ---------- Power flow ---------- */
    .power-flow-indicator {
      text-align: center;
      margin: 0 0 18px;
      padding: 9px 14px;
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-radius: var(--r);
    }

    .flow-text {
      font-family: var(--mono);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: .05em;
      text-transform: uppercase;
      color: var(--text-dim);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
    }
    .flow-text::before {
      content: '';
      width: 7px; height: 7px;
      border-radius: 50%;
      background: currentColor;
      flex-shrink: 0;
    }
    .flow-text.charging::before,
    .flow-text.discharging::before { animation: pulse 1.4s ease-in-out infinite; }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%      { opacity: .35; transform: scale(1.45); }
    }

    /* ---------- Absorption progress ---------- */
    .absorb-panel {
      margin: 0 0 18px;
      padding: 13px 15px;
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-left: 3px solid var(--warn);
      border-radius: var(--r);
      animation: fadeIn .25s ease both;
    }

    .absorb-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 11px;
      flex-wrap: wrap;
    }
    .absorb-title {
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--warn);
    }
    .absorb-summary {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--text);
    }

    .absorb-row {
      display: grid;
      grid-template-columns: 116px 1fr 92px;
      align-items: center;
      gap: 11px;
      margin-bottom: 7px;
    }
    .absorb-label {
      font-size: 11px;
      color: var(--text-faint);
      letter-spacing: .02em;
    }
    .absorb-track {
      height: 7px;
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: 100px;
      overflow: hidden;
    }
    .absorb-bar {
      height: 100%;
      width: 0;
      background: var(--info);
      border-radius: 100px;
      transition: width .5s cubic-bezier(.4,0,.2,1), background .3s;
    }
    /* The tail bar is the one that resets, so colour-code whether it is running */
    .absorb-bar.tail { background: var(--text-faint); }
    .absorb-bar.tail.running { background: var(--ok); }
    .absorb-val {
      font-family: var(--mono);
      font-size: 11.5px;
      color: var(--text-dim);
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    .absorb-note {
      margin-top: 9px;
      padding-top: 9px;
      border-top: 1px solid var(--line-soft);
      font-size: 11.5px;
      color: var(--text-faint);
      line-height: 1.45;
    }

    @media (max-width: 640px) {
      .absorb-row { grid-template-columns: 1fr 68px; grid-template-areas: 'label val' 'track track'; row-gap: 4px; }
      .absorb-label { grid-area: label; }
      .absorb-val { grid-area: val; }
      .absorb-track { grid-area: track; margin-bottom: 5px; }
    }

    /* ---------- Schedule editor ---------- */
    .sched-status {
      display: flex; align-items: center; gap: 9px;
      padding: 10px 14px; margin-bottom: 18px;
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-left: 3px solid var(--line);
      border-radius: var(--r);
      font-size: 13px;
    }
    .sched-status.active { border-left-color: var(--ok); }
    .sched-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-faint); flex-shrink: 0; }
    .sched-status.active .sched-dot { background: var(--ok); }

    /* Something outside has taken a lever off the schedule - amber, because it
       is a temporary state that will end on its own, not a fault. */
    .sched-override { border-left-color: var(--warn); }
    .sched-override .sched-dot { background: var(--warn); }
    .sched-ovr-clear { margin-left: auto; flex-shrink: 0; padding: 5px 10px; font-size: 11.5px; }

    .sched-noclock {
      display: flex; align-items: flex-start; gap: 11px;
      padding: 12px 14px; margin-bottom: 16px;
      background: color-mix(in srgb, var(--warn) 12%, var(--panel));
      border: 1px solid color-mix(in srgb, var(--warn) 40%, var(--line));
      border-left: 3px solid var(--warn);
      border-radius: var(--r);
      font-size: 12.5px; line-height: 1.5; color: var(--text);
    }
    .sched-noclock a { color: var(--accent); }
    .sched-noclock .warning-icon { color: var(--warn); }

    .sched-next { display: block; margin-top: 3px; font-size: 11.5px; color: var(--text-faint); }
    .sched-help { font-size: 12px; color: var(--text-faint); margin-bottom: 12px; line-height: 1.5; }
    .sched-topic { font-family: var(--mono); color: var(--text-dim); }

    .sched-table { display: flex; flex-direction: column; gap: 9px; }

    .sched-row {
      display: grid;
      /* Fields group left; the slack column keeps Remove pinned right instead of
         letting the Repeat select swallow the whole row. */
      grid-template-columns: 92px 92px minmax(130px, 210px) 84px 84px 84px 78px 1fr 34px;
      gap: 8px;
      align-items: end;
      padding: 11px 12px;
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-radius: var(--r);
    }
    .sched-row label {
      font-size: 9.5px; letter-spacing: .07em; text-transform: uppercase;
      color: var(--text-faint); margin-bottom: 3px;
    }
    .sched-row input, .sched-row select { padding: 6px 7px; font-size: 12px; }
    .sched-row .row-remove {
      grid-column: -2 / -1;
      padding: 6px 0; font-size: 15px; line-height: 1;
      color: var(--err); border-color: color-mix(in srgb, var(--err) 40%, var(--line));
    }
    .sched-row .row-remove:hover { background: color-mix(in srgb, var(--err) 12%, transparent); color: var(--err); }

    .sched-empty {
      padding: 16px; text-align: center;
      font-size: 12.5px; color: var(--text-faint);
      border: 1px dashed var(--line); border-radius: var(--r);
    }

    .sched-mqtt { display: flex; flex-direction: column; gap: 7px; }
    .sched-mqtt-row {
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
      padding: 9px 12px;
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-left: 3px solid var(--info);
      border-radius: var(--r);
      font-family: var(--mono); font-size: 12px;
    }
    .sched-mqtt-row .when { color: var(--text); }
    .sched-mqtt-row .what { color: var(--text-dim); }
    .sched-mqtt-row.now { border-left-color: var(--ok); }

    @media (max-width: 860px) {
      .sched-row {
        /* Three equal columns so the three action selects each get a usable
           width - a narrow column sized for the Remove button was clipping
           "Force" down to a couple of characters. */
        grid-template-columns: 1fr 1fr 1fr;
        grid-template-areas:
          'start  end       remove'
          'days   days      days'
          'charge discharge force'
          'soc    soc       soc';
      }
      .sched-row .f-start { grid-area: start; }
      .sched-row .f-end { grid-area: end; }
      .sched-row .f-days { grid-area: days; }
      .sched-row .f-charge { grid-area: charge; }
      .sched-row .f-discharge { grid-area: discharge; }
      .sched-row .f-force { grid-area: force; }
      .sched-row .f-soc { grid-area: soc; }
      .sched-row .row-remove { grid-area: remove; align-self: end; justify-self: end; width: 40px; height: 32px; }
    }

    /* ---------- Warnings ---------- */
    .status-warnings {
      margin: 0 0 18px;
      padding: 11px 14px;
      background: color-mix(in srgb, var(--warn) 12%, var(--panel));
      border: 1px solid color-mix(in srgb, var(--warn) 40%, var(--line));
      border-left: 3px solid var(--warn);
      border-radius: var(--r);
      animation: fadeIn .22s ease both;
    }
    .status-warnings.error {
      background: color-mix(in srgb, var(--err) 12%, var(--panel));
      border-color: color-mix(in srgb, var(--err) 40%, var(--line));
      border-left-color: var(--err);
    }

    .warning-box { display: flex; align-items: flex-start; gap: 10px; }
    .warning-icon { color: var(--warn); flex-shrink: 0; font-size: 15px; line-height: 1.3; }
    .status-warnings.error .warning-icon { color: var(--err); }

    .warning-list { display: flex; flex-direction: column; gap: 3px; font-size: 13px; color: var(--text); }
    .warning-list .why { color: var(--text-dim); font-size: 12px; }

    /* ---------- Stale data overlay ---------- */
    .content.stale .tab-pane#home .stat-box,
    .content.stale .tab-pane#home .toggle-box,
    .content.stale .tab-pane#home .battery-rig,
    .content.stale .tab-pane#home .power-flow-indicator {
      opacity: .38;
      filter: grayscale(.7);
      transition: opacity .3s, filter .3s;
    }

    .stale-banner {
      display: none;
      align-items: center;
      gap: 9px;
      margin-bottom: 16px;
      padding: 10px 14px;
      background: color-mix(in srgb, var(--err) 12%, var(--panel));
      border: 1px solid color-mix(in srgb, var(--err) 40%, var(--line));
      border-left: 3px solid var(--err);
      border-radius: var(--r);
      font-size: 13px;
      color: var(--text);
    }
    .content.stale .stale-banner { display: flex; }

    .spinner {
      width: 13px; height: 13px;
      border: 2px solid color-mix(in srgb, var(--err) 30%, transparent);
      border-top-color: var(--err);
      border-radius: 50%;
      animation: spin .8s linear infinite;
      flex-shrink: 0;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .last-update {
      text-align: center;
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1px solid var(--line-soft);
      color: var(--text-faint);
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: .03em;
    }

    /* ---------- Logs ---------- */
    .log-viewer {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--r);
      padding: 12px 14px;
      height: 480px;
      overflow-y: auto;
      font-family: var(--mono);
      font-size: 12px;
      line-height: 1.65;
      color: var(--text-dim);
    }
    .log-entry { word-wrap: break-word; white-space: pre-wrap; }
    .log-entry.error   { color: var(--err); }
    .log-entry.warning { color: var(--warn); }
    .log-entry.info    { color: var(--text); }
    .log-entry.debug   { color: var(--text-faint); }
    .log-entry.hidden  { display: none; }

    .log-controls {
      display: flex;
      gap: 10px;
      margin-bottom: 14px;
      align-items: center;
      flex-wrap: wrap;
    }
    .log-controls button { padding: 7px 13px; font-size: 12px; }
    .log-controls label {
      margin: 0;
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 12px;
      color: var(--text-dim);
    }
    .log-controls select { width: auto; padding: 6px 9px; font-size: 12px; }
    .log-spacer { flex: 1; }

    /* ---------- Danger zone ---------- */
    .danger-zone {
      margin-top: 26px;
      border: 1px solid color-mix(in srgb, var(--err) 35%, var(--line));
      border-radius: var(--r);
      overflow: hidden;
      background: color-mix(in srgb, var(--err) 5%, var(--panel));
    }
    .danger-zone > summary {
      padding: 11px 14px;
      cursor: pointer;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--err);
      list-style: none;
      display: flex;
      align-items: center;
      gap: 8px;
      user-select: none;
    }
    .danger-zone > summary::-webkit-details-marker { display: none; }
    .danger-zone > summary::before { content: '\25B8'; transition: transform .2s; }
    .danger-zone[open] > summary::before { transform: rotate(90deg); }
    .danger-zone > summary:focus-visible { outline: none; box-shadow: var(--focus); }
    .danger-body { padding: 0 14px 14px; border-top: 1px solid color-mix(in srgb, var(--err) 22%, var(--line)); }
    .danger-body p { font-size: 12.5px; color: var(--text-dim); margin: 12px 0; }

    /* ---------- Modal dialog (replaces confirm/alert) ---------- */
    .modal-backdrop {
      position: fixed; inset: 0;
      background: rgba(4,8,13,.66);
      backdrop-filter: blur(2px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 3000;
    }
    .modal-backdrop.show { display: flex; animation: fadeIn .16s ease both; }

    .modal {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow);
      max-width: 430px;
      width: 100%;
      padding: 20px;
    }
    .modal h3 { font-size: 15px; margin-bottom: 9px; color: var(--text); font-weight: 600; }
    .modal p  { font-size: 13px; color: var(--text-dim); margin-bottom: 15px; line-height: 1.5; }
    .modal .modal-actions { display: flex; gap: 9px; justify-content: flex-end; }
    .modal .modal-actions button { flex: 0 0 auto; min-width: 92px; }
    .modal label { font-size: 12px; }
    .modal input { margin-bottom: 15px; }

    /* ---------- Toast ---------- */
    .toast {
      position: fixed;
      bottom: 18px; right: 18px;
      background: var(--raised);
      color: var(--text);
      border: 1px solid var(--line);
      border-left: 3px solid var(--accent);
      padding: 11px 16px;
      border-radius: var(--r);
      box-shadow: var(--shadow);
      opacity: 0;
      transform: translateY(6px);
      pointer-events: none;
      transition: opacity .2s, transform .2s;
      z-index: 4000;
      min-width: 170px;
      max-width: min(380px, calc(100vw - 36px));
      font-size: 13px;
      font-weight: 500;
    }
    .toast.show { opacity: 1; transform: none; }
    .toast.success { border-left-color: var(--ok); }
    .toast.pending { border-left-color: var(--warn); }
    .toast.error   { border-left-color: var(--err); }

    /* ---------- Unsaved-changes bar ---------- */
    .unsaved-bar {
      display: none;
      align-items: center;
      gap: 11px;
      margin-bottom: 16px;
      padding: 9px 13px;
      background: color-mix(in srgb, var(--warn) 11%, var(--panel));
      border: 1px solid color-mix(in srgb, var(--warn) 38%, var(--line));
      border-left: 3px solid var(--warn);
      border-radius: var(--r);
      font-size: 12.5px;
      color: var(--text);
    }
    .unsaved-bar.show { display: flex; }
    .unsaved-bar button { padding: 5px 12px; font-size: 12px; }
    .unsaved-bar .spacer { flex: 1; }

    /* ---------- Firmware progress ---------- */
    .progress-track {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      overflow: hidden;
      height: 24px;
    }
    .progress-bar {
      background: var(--accent);
      color: var(--accent-ink);
      height: 100%;
      width: 0;
      transition: width .3s;
      text-align: center;
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 600;
      line-height: 22px;
    }
    .progress-bar.ok   { background: var(--ok); }
    .progress-bar.err  { background: var(--err); }
    .progress-bar.warn { background: var(--warn); }

    /* ---------- Tooltips (tap-friendly) ---------- */
    .tip {
      position: relative;
      cursor: help;
      border-bottom: 1px dotted var(--text-faint);
    }
    .tip .tip-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 14px; height: 14px;
      margin-left: 4px;
      border-radius: 50%;
      border: 1px solid var(--line);
      background: var(--raised);
      color: var(--text-faint);
      font-size: 9px;
      font-weight: 700;
      cursor: pointer;
      vertical-align: middle;
      padding: 0;
      line-height: 1;
    }
    .tip .tip-btn:hover { color: var(--accent); border-color: var(--accent-dim); }

    /* One shared bubble, positioned in viewport coordinates by JS, rather than a
       ::after on each .tip. The page container clips its overflow, so a bubble
       anchored inside it was cut off for fields near a panel edge or on a top row,
       leaving the text unreadable with no way to scroll to the rest. Fixed
       positioning escapes the clip; positionTip() then keeps it on screen. */
    .tip-pop {
      position: fixed;
      top: 0; left: 0;
      background: var(--raised);
      color: var(--text);
      border: 1px solid var(--line);
      padding: 8px 10px;
      border-radius: var(--r-sm);
      box-shadow: var(--shadow);
      font-size: 12px;
      font-weight: 400;
      line-height: 1.45;
      letter-spacing: normal;
      text-transform: none;
      text-align: left;
      white-space: normal;
      max-width: min(320px, calc(100vw - 24px));
      opacity: 0;
      pointer-events: none;
      transition: opacity .16s;
      z-index: 2000;
    }
    .tip-pop.show { opacity: 1; }

    /* ---------- WiFi ---------- */
    .wifi-controls { display: flex; gap: 10px; }
    .wifi-controls select { flex: 1; font-family: var(--mono); font-size: 12px; }
    .wifi-controls button { flex: 0 0 auto; }

    /* ---------- Responsive ---------- */
    @media (max-width: 860px) {
      .form-row.col4 { grid-template-columns: 1fr 1fr; }
      .form-row.col3 { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 640px) {
      body { padding: 0; background-image: none; }
      .container { border-radius: 0; border-left: none; border-right: none; min-height: 100vh; }
      .header { padding: 12px 14px; gap: 10px; }
      .brand { min-width: 0; flex: 1 1 100%; }
      .header-meta { flex: 1 1 100%; font-size: 10.5px; gap: 10px; }
      .content { padding: 16px 14px 22px; }
      /* Config inputs go full width - they need the room for labels + values.
         Dashboard readouts stay 2-up, which fits comfortably even at 320px. */
      .form-row, .form-row.col3, .form-row.col4 { grid-template-columns: 1fr; gap: 11px; margin-bottom: 11px; }
      .form-row.col4 { grid-template-columns: 1fr 1fr; }
      .stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-bottom: 10px; }

      /* Wrap the tabs rather than scrolling them: a hidden horizontal scroll gives
         no hint that Firmware exists off-screen. */
      .tabs { flex-wrap: wrap; overflow-x: visible; }
      .tab-button { flex: 1 0 33.333%; }
      .stat-box { min-height: 58px; padding: 9px 11px; }
      .stat-value { font-size: 17px; }
      .toggle-box { min-height: 58px; padding: 9px 11px; gap: 7px; }
      .toggle-state { font-size: 13px; }
      .switch { width: 34px; height: 19px; }
      .switch::after { width: 13px; height: 13px; }
      .toggle-box[aria-pressed="true"] .switch::after { transform: translateX(15px); }
      .tab-button { min-width: 0; flex: 0 0 auto; padding: 10px 13px; font-size: 11px; }
      .battery-visual { gap: 16px; }
      .battery-container { width: 172px; height: 78px; }
      .battery-percentage { font-size: 27px; }
      .battery-tip { height: 26px; }
      .status-stack { flex-direction: row; flex-wrap: wrap; justify-content: center; min-width: 0; gap: 12px; }
      .button-group { flex-direction: column; }
      .button-group button { min-width: 0; }
      .log-viewer { height: 62vh; }
      .toast { left: 12px; right: 12px; bottom: 12px; max-width: none; }
    }

    /* ---------- Motion / contrast preferences ---------- */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }
    }

    /* Fallback for browsers without color-mix(): the mixes above degrade to
       transparent, so restore solid borders/backgrounds for the key surfaces. */
    @supports not (color: color-mix(in srgb, red 50%, blue)) {
      .status-warnings { background: var(--panel-2); border-color: var(--warn); }
      .status-warnings.error { background: var(--panel-2); border-color: var(--err); }
      .stale-banner { background: var(--panel-2); border-color: var(--err); }
      .unsaved-bar { background: var(--panel-2); border-color: var(--warn); }
      .danger-zone { background: var(--panel); border-color: var(--err); }
      .danger-body { border-top-color: var(--err); }
      .btn-danger { border-color: var(--err); }
      .dot.connected { box-shadow: none; }
      .toggle-box[aria-pressed="true"] .switch { background: var(--ok); }
      input:focus, select:focus { box-shadow: 0 0 0 3px var(--accent-dim); }
    }
  </style>
</head>
<body>
  <div class="container">
    <header class="header">
      <div class="brand">
        <h1>DIY<span class="accent">/</span>BATTERY BMS</h1>
        <span class="subtitle">Inverter Bridge</span>
      </div>
      <div class="header-meta">
        <span class="meta-item" id="hostMeta" hidden><b id="hostName">--</b></span>
        <span class="meta-item" id="fwMeta" hidden>fw <b id="fwHeader">--</b></span>
        <span class="conn-status" id="connPill">
          <span class="dot" id="connDot"></span><span id="connText">Offline</span>
        </span>
        <button class="icon-btn" id="themeBtn" onclick="cycleTheme()" title="Switch theme" aria-label="Switch colour theme">&#9681;</button>
      </div>
    </header>

    <nav class="tabs" role="tablist" aria-label="Sections">
      <button class="tab-button" role="tab" id="tab-home"     aria-selected="true"  aria-controls="home"     onclick="switchTab('home')">Home</button>
      <button class="tab-button" role="tab" id="tab-bms"      aria-selected="false" aria-controls="bms"      onclick="switchTab('bms')">BMS</button>
      <button class="tab-button" role="tab" id="tab-schedule" aria-selected="false" aria-controls="schedule" onclick="switchTab('schedule')">Schedule</button>
      <button class="tab-button" role="tab" id="tab-settings" aria-selected="false" aria-controls="settings" onclick="switchTab('settings')">Settings</button>
      <button class="tab-button" role="tab" id="tab-wifimqtt" aria-selected="false" aria-controls="wifimqtt" onclick="switchTab('wifimqtt')">WiFi/MQTT</button>
      <button class="tab-button" role="tab" id="tab-logs"     aria-selected="false" aria-controls="logs"     onclick="switchTab('logs')">Logs</button>
      <button class="tab-button" role="tab" id="tab-firmware" aria-selected="false" aria-controls="firmware" onclick="switchTab('firmware')">Firmware</button>
    </nav>

    <main class="content" id="content">
      <!-- Edits apply to the running device immediately, but only persist across a
           reboot once written to EEPROM. This makes that distinction visible. -->
      <div class="unsaved-bar" id="unsavedBar">
        <span><b>Unsaved changes.</b> Applied now, but will be lost on reboot.</span>
        <span class="spacer"></span>
        <button class="btn-primary" onclick="saveAll()">Save to EEPROM</button>
      </div>

      <!-- Home Tab -->
      <section id="home" class="tab-pane active" role="tabpanel" aria-labelledby="tab-home">

        <!-- Shown whenever the socket is down: the readouts below are frozen, not live -->
        <div class="stale-banner">
          <span class="spinner"></span>
          <span><b>Connection lost.</b> Readings below are from <span id="staleSince">the last update</span> and are not live.</span>
        </div>

        <div class="battery-visual">
          <div class="status-stack">
            <div class="status-dot-row" id="inverterStatusRow" hidden>
              <span class="dot" id="inverterDot"></span><span>Inverter</span>
            </div>
            <div class="status-dot-row">
              <span class="dot" id="shuntDot"></span><span>Shunt Data</span>
            </div>
            <div class="status-dot-row">
              <span class="dot" id="mqttDot"></span><span>MQTT</span>
            </div>
          </div>

          <div class="battery-col">
            <div class="battery-rig">
              <div class="battery-container" role="img" id="batteryGauge" aria-label="Battery state of charge 0%">
                <div class="battery-level" id="batteryLevel"></div>
                <div class="battery-wave" id="batteryWave"></div>
                <div class="battery-percentage" id="batteryPercentage">0%</div>
              </div>
              <div class="battery-tip"></div>
            </div>

            <!-- Only appears when the SOC on the CAN bus differs from the real pack SOC -->
            <div class="soc-override" id="socOverride" hidden>
              <span class="soc-chip">
                <span class="soc-chip-label">Inverter is told</span>
                <span class="soc-chip-value" id="reportedSocValue">99%</span>
              </span>
              <span class="soc-why" id="socOverrideWhy"></span>
            </div>
          </div>
        </div>

        <div class="power-flow-indicator">
          <div id="powerFlowText" class="flow-text">Idle</div>
        </div>

        <!-- Absorption ends on whichever finishes first: the tail-current hold, or the
             max absorption timeout. Both are shown because the tail timer resets every
             time current rises back above the threshold, which is otherwise invisible
             and makes a long absorption look stuck. -->
        <div class="absorb-panel" id="absorbPanel" hidden>
          <div class="absorb-head">
            <span class="absorb-title">Absorption</span>
            <span class="absorb-summary" id="absorbSummary"></span>
          </div>

          <div class="absorb-row">
            <span class="absorb-label">Tail current hold</span>
            <div class="absorb-track"><div class="absorb-bar tail" id="tailBar"></div></div>
            <span class="absorb-val" id="tailVal">--</span>
          </div>

          <div class="absorb-row">
            <span class="absorb-label">Max absorption</span>
            <div class="absorb-track"><div class="absorb-bar" id="absorbBar"></div></div>
            <span class="absorb-val" id="absorbVal">--</span>
          </div>

          <div class="absorb-note" id="absorbNote"></div>
        </div>

        <div id="statusWarnings" class="status-warnings" hidden>
          <div class="warning-box">
            <span class="warning-icon">&#9888;</span>
            <div class="warning-list" id="warningText"></div>
          </div>
        </div>

        <div class="stat-grid">
          <div class="stat-box stat-status">
            <div class="stat-label">Battery Voltage</div>
            <div class="stat-value"><span id="battvoltage">0</span><span class="unit">V</span></div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Battery Current</div>
            <div class="stat-value"><span id="battcurrent">0</span><span class="unit">A</span></div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Power</div>
            <div class="stat-value"><span id="battpower">0</span><span class="unit">W</span></div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Time to Go</div>
            <div class="stat-value"><span id="timetogo">--</span></div>
          </div>
        </div>

        <div class="stat-grid">
          <div class="stat-box stat-charge">
            <div class="stat-label">Charge Phase</div>
            <div class="stat-value sm" id="chargephaseStatus">--</div>
          </div>
          <div class="stat-box stat-charge">
            <div class="stat-label">Absorption Adjust</div>
            <div class="stat-value"><span id="chargeadjust">0</span><span class="unit">A</span></div>
          </div>
          <div class="stat-box stat-charge">
            <div class="stat-label">Charge Limit</div>
            <div class="stat-value"><span id="chargecurrent">0</span><span class="unit">A</span></div>
          </div>
          <div class="stat-box stat-discharge">
            <div class="stat-label">Discharge Limit</div>
            <div class="stat-value"><span id="dischargecurrent">0</span><span class="unit">A</span></div>
          </div>
        </div>

        <div id="tempRow" class="stat-grid" hidden>
          <div class="stat-box stat-status">
            <div class="stat-label">Battery Temp</div>
            <div class="stat-value"><span id="batttemp">--</span><span class="unit">&deg;C</span></div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Inverter Temp</div>
            <div class="stat-value"><span id="mqttinvertertemp">--</span><span class="unit">&deg;C</span></div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Fan PWM</div>
            <div class="stat-value"><span id="fanpwm">0</span><span class="unit">%</span></div>
          </div>
        </div>

        <div class="stat-grid">
          <button type="button" class="toggle-box tg-charge" id="chargeToggle"
                  aria-pressed="false" onclick="toggleChargeEnable()">
            <span class="toggle-text">
              <span class="stat-label">Charge</span>
              <span class="toggle-state" id="chargeenabledStatus">OFF</span>
            </span>
            <span class="switch" aria-hidden="true"></span>
          </button>
          <button type="button" class="toggle-box tg-discharge" id="dischargeToggle"
                  aria-pressed="false" onclick="toggleDischargeEnable()">
            <span class="toggle-text">
              <span class="stat-label">Discharge</span>
              <span class="toggle-state" id="dischargeenabledStatus">OFF</span>
            </span>
            <span class="switch" aria-hidden="true"></span>
          </button>
        </div>

        <div class="last-update">
          Last updated <span id="lastUpdate">--</span>
        </div>
      </section>
      
      <!-- BMS Tab -->
      <section id="bms" class="tab-pane" role="tabpanel" aria-labelledby="tab-bms">
        <div class="section-title">Voltage Configuration</div>
        <div class="form-row">
          <div class="form-group">
            <label for="chargevoltage"><span class="tip" data-tip="Target voltage the inverter will charge to. Sent to inverter via CAN as the maximum battery voltage.">Charge Voltage (V):</span></label>
            <input type="number" id="chargevoltage" min="0" max="65" step="0.1" onchange="EnqueueUpdate('chargevoltage')" onkeypress="HandleEnter(event, 'chargevoltage')">
            <div class="field-error" id="err_chargevoltage"></div>
          </div>
          <div class="form-group">
            <label for="dischargevoltage"><span class="tip" data-tip="Minimum voltage before discharge is disabled to protect the battery.">Discharge Voltage (V):</span></label>
            <input type="number" id="dischargevoltage" min="0" max="65" step="0.1" onchange="EnqueueUpdate('dischargevoltage')" onkeypress="HandleEnter(event, 'dischargevoltage')">
            <div class="field-error" id="err_dischargevoltage"></div>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label for="overvoltage"><span class="tip" data-tip="Hard safety cutoff. Charging is immediately disabled if battery voltage reaches this level.">Battery Over Voltage (V):</span></label>
            <input type="number" id="overvoltage" min="0" max="65" step="0.1" onchange="EnqueueUpdate('overvoltage')" onkeypress="HandleEnter(event, 'overvoltage')">
            <div class="field-error" id="err_overvoltage"></div>
          </div>
        </div>
        
        <div class="section-title">Current Configuration</div>
        <div class="form-row">
          <div class="form-group">
            <label for="maxchargecurrent"><span class="tip" data-tip="Maximum charge current sent to the inverter during bulk charging.">Max Charge (A):</span></label>
            <input type="number" id="maxchargecurrent" min="0" max="500" step="0.1" onchange="EnqueueUpdate('maxchargecurrent')" onkeypress="HandleEnter(event, 'maxchargecurrent')">
            <div class="field-error" id="err_maxchargecurrent"></div>
          </div>
          <div class="form-group">
            <label for="maxdischargecurrent"><span class="tip" data-tip="Maximum discharge current allowed. Sent to the inverter as the discharge limit.">Max Discharge (A):</span></label>
            <input type="number" id="maxdischargecurrent" min="0" max="500" step="0.1" onchange="EnqueueUpdate('maxdischargecurrent')" onkeypress="HandleEnter(event, 'maxdischargecurrent')">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label for="adjuststep"><span class="tip" data-tip="Amount to increase or decrease the charge current each step during absorption phase to hold voltage steady.">Charge Adjust Step (A):</span></label>
            <input type="number" id="adjuststep" min="0" max="100" step="0.1" onchange="EnqueueUpdate('adjuststep')" onkeypress="HandleEnter(event, 'adjuststep')">
          </div>
          <div class="form-group">
            <label for="minchargecurr"><span class="tip" data-tip="Lowest charge current allowed during absorption. The adjust step won't reduce below this value. Do not set this too low: many inverters ignore a limit of a few hundred milliamps, and a limit at or near zero while the voltage target stays high leaves them no way to shed surplus power - some respond by discharging the battery. A few amps is a safer floor than a fraction of one.">Min Charge (A):</span></label>
            <input type="number" id="minchargecurr" min="0" max="100" step="0.1" onchange="EnqueueUpdate('minchargecurr')" onkeypress="HandleEnter(event, 'minchargecurr')">
            <div class="field-error" id="err_minchargecurr"></div>
          </div>
        </div>
        
        <div class="form-row full">
          <div class="form-group">
            <label for="batterycapacity"><span class="tip" data-tip="Total battery capacity in amp hours. Used to calculate slow charge current limits (capacity / divider).">Battery Capacity (Ah):</span></label>
            <input type="number" id="batterycapacity" min="0" max="9999" step="0.1" onchange="EnqueueUpdate('batterycapacity')" onkeypress="HandleEnter(event, 'batterycapacity')">
          </div>
        </div>
        
        <div class="section-title">SOC Limits</div>
        <div class="form-row">
          <div class="form-group">
            <label for="lowsoclimit"><span class="tip" data-tip="Discharge is disabled when SOC drops to or below this percentage. Set 0 to disable.">Low SOC (Stop Discharge):</span></label>
            <input type="number" id="lowsoclimit" min="0" max="100" onchange="EnqueueUpdate('lowsoclimit')" onkeypress="HandleEnter(event, 'lowsoclimit')">
            <div class="field-error" id="err_lowsoclimit"></div>
          </div>
          <div class="form-group">
            <label for="highsoclimit"><span class="tip" data-tip="Charging is disabled when SOC reaches this percentage. Set 100 to disable.">High SOC (Stop Charge):</span></label>
            <input type="number" id="highsoclimit" min="0" max="100" onchange="EnqueueUpdate('highsoclimit')" onkeypress="HandleEnter(event, 'highsoclimit')">
            <div class="field-error" id="err_highsoclimit"></div>
          </div>
        </div>
        
        <div class="section-title">Slow Charge Configuration</div>
        <div class="form-row col4">
          <div class="form-group">
            <label for="slowchargesoc1"><span class="tip" data-tip="When SOC reaches this %, charge current is reduced to capacity / divider 1.">Slow Charge SOC 1:</span></label>
            <input type="number" id="slowchargesoc1" onchange="EnqueueUpdate('slowchargesoc1')" onkeypress="HandleEnter(event, 'slowchargesoc1')">
          </div>
          <div class="form-group">
            <label for="slowchargesoc1div"><span class="tip" data-tip="Capacity divider for slow charge 1. Charge current = capacity / this value. E.g. 100Ah / 2 = C/2 (50A).">Divider 1:</span></label>
            <input type="number" id="slowchargesoc1div" onchange="EnqueueUpdate('slowchargesoc1div')" onkeypress="HandleEnter(event, 'slowchargesoc1div')">
          </div>
          <div class="form-group">
            <label for="slowchargesoc2"><span class="tip" data-tip="Second slow charge threshold. When SOC reaches this %, charge current is reduced further using divider 2.">Slow Charge SOC 2:</span></label>
            <input type="number" id="slowchargesoc2" onchange="EnqueueUpdate('slowchargesoc2')" onkeypress="HandleEnter(event, 'slowchargesoc2')">
          </div>
          <div class="form-group">
            <label for="slowchargesoc2div"><span class="tip" data-tip="Capacity divider for slow charge 2. Charge current = capacity / this value.">Divider 2:</span></label>
            <input type="number" id="slowchargesoc2div" onchange="EnqueueUpdate('slowchargesoc2div')" onkeypress="HandleEnter(event, 'slowchargesoc2div')">
          </div>
        </div>

        <div class="section-title">CC-CV Charging Configuration</div>
        <div class="form-row">
          <div class="form-group">
            <label for="tailcurrent"><span class="tip" data-tip="During absorption, when charge current drops below this for the tail duration, the battery is considered full.">Tail Current (A):</span></label>
            <input type="number" id="tailcurrent" min="0" max="100" step="0.1" onchange="EnqueueUpdate('tailcurrent')" onkeypress="HandleEnter(event, 'tailcurrent')">
          </div>
          <div class="form-group">
            <label for="tailduration"><span class="tip" data-tip="How long current must stay below the tail threshold before absorption is considered complete.">Tail Duration (seconds):</span></label>
            <input type="number" id="tailduration" min="0" max="3600" onchange="EnqueueUpdate('tailduration')" onkeypress="HandleEnter(event, 'tailduration')">
          </div>
        </div>

        <div class="form-row col3">
          <div class="form-group">
            <label for="maxabsorptiontime"><span class="tip" data-tip="Safety timeout. Absorption phase ends after this many minutes even if tail current hasn't been reached.">Max Absorption Time (min):</span></label>
            <input type="number" id="maxabsorptiontime" min="0" max="1440" onchange="EnqueueUpdate('maxabsorptiontime')" onkeypress="HandleEnter(event, 'maxabsorptiontime')">
          </div>
          <div class="form-group">
            <label for="rechargesoc"><span class="tip" data-tip="After charge completes, a new bulk charge cycle starts when SOC drops below this percentage.">Recharge SOC (%):</span></label>
            <input type="number" id="rechargesoc" min="0" max="100" onchange="EnqueueUpdate('rechargesoc')" onkeypress="HandleEnter(event, 'rechargesoc')">
            <div class="field-error" id="err_rechargesoc"></div>
          </div>
          <div class="form-group">
            <label for="rechargevoltageoffset"><span class="tip" data-tip="Voltage drop from target that triggers a new bulk charge cycle. Also used to detect significant voltage drops during absorption.">Recharge V Offset (V):</span></label>
            <input type="number" id="rechargevoltageoffset" min="0" max="10" step="0.1" onchange="EnqueueUpdate('rechargevoltageoffset')" onkeypress="HandleEnter(event, 'rechargevoltageoffset')">
            <div class="field-error" id="err_rechargevoltageoffset"></div>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="floatvoltage"><span class="tip" data-tip="Voltage held after absorption finishes, instead of stopping the charge outright. Set 0 to disable the float stage and end the cycle at Complete as before. Typical LiFePO4 float is 3.375-3.40 V per cell (54.0-54.4 V for 16S).">Float Voltage (V):</span></label>
            <input type="number" id="floatvoltage" min="0" max="65" step="0.1" onchange="EnqueueUpdate('floatvoltage')" onkeypress="HandleEnter(event, 'floatvoltage')">
            <div class="field-error" id="err_floatvoltage"></div>
          </div>
          <div class="form-group">
            <label for="floatcurrent"><span class="tip" data-tip="Charge current allowance sent to the inverter during float. Keep it above zero: an inverter given a voltage target it cannot charge towards has no way to shed surplus power, and some respond by discharging the battery.">Float Current (A):</span></label>
            <input type="number" id="floatcurrent" min="0" max="100" step="0.1" onchange="EnqueueUpdate('floatcurrent')" onkeypress="HandleEnter(event, 'floatcurrent')">
            <div class="field-error" id="err_floatcurrent"></div>
          </div>
        </div>

        <div class="section-title">Temperature Protection</div>
        <div class="form-row">
          <div class="checkbox-row">
            <input type="checkbox" id="tempprotection" onchange="SendJSONUpdate('tempprotection'); toggleTempConfig();">
            <label for="tempprotection"><span class="tip" data-tip="Enable temperature-based charge and discharge cutoffs using the shunt temperature sensor.">Temperature Protection Enabled</span></label>
          </div>
          <div class="checkbox-row">
            <input type="checkbox" id="showtempdashboard" onchange="SendJSONUpdate('showtempdashboard')">
            <label for="showtempdashboard">Show Temperature on Dashboard</label>
          </div>
        </div>
        <div id="tempConfigFields" style="display:none;">
          <div class="form-row">
            <div class="form-group">
              <label for="batttempsrc"><span class="tip" data-tip="Select where battery temperature data comes from. VE.Direct uses the shunt sensor, MQTT subscribes to an external topic.">Battery Temp Source:</span></label>
              <select id="batttempsrc" onchange="SendJSONUpdate('batttempsrc'); toggleMqttTempTopics();">
                <option value="0">VE.Direct</option>
                <option value="1">MQTT</option>
              </select>
            </div>
            <div class="form-group" id="mqttBattTopicGroup" style="display:none;">
              <label for="mqttbatttopic"><span class="tip" data-tip="External MQTT topic to subscribe to for battery temperature (e.g. solar_assistant/battery_1/temperature/state).">MQTT Battery Temp Topic:</span></label>
              <input type="text" id="mqttbatttopic" onchange="EnqueueUpdate('mqttbatttopic')" onkeypress="HandleEnter(event, 'mqttbatttopic')">
            </div>
          </div>
          <div class="form-row col4">
            <div class="form-group">
              <label for="chargehightemp"><span class="tip" data-tip="Charging is disabled above this temperature.">Chg High (&deg;C):</span></label>
              <input type="number" id="chargehightemp" min="-20" max="60" onchange="EnqueueUpdate('chargehightemp')" onkeypress="HandleEnter(event, 'chargehightemp')">
              <div class="field-error" id="err_chargehightemp"></div>
            </div>
            <div class="form-group">
              <label for="chargelowtemp"><span class="tip" data-tip="Charging is disabled below this temperature. Important for lithium batteries which should not charge below 0°C.">Chg Low (&deg;C):</span></label>
              <input type="number" id="chargelowtemp" min="-40" max="45" onchange="EnqueueUpdate('chargelowtemp')" onkeypress="HandleEnter(event, 'chargelowtemp')">
              <div class="field-error" id="err_chargelowtemp"></div>
            </div>
            <div class="form-group">
              <label for="dischargehightemp"><span class="tip" data-tip="Discharging is disabled above this temperature.">Dchg High (&deg;C):</span></label>
              <input type="number" id="dischargehightemp" min="-20" max="70" onchange="EnqueueUpdate('dischargehightemp')" onkeypress="HandleEnter(event, 'dischargehightemp')">
              <div class="field-error" id="err_dischargehightemp"></div>
            </div>
            <div class="form-group">
              <label for="dischargelowtemp"><span class="tip" data-tip="Discharging is disabled below this temperature.">Dchg Low (&deg;C):</span></label>
              <input type="number" id="dischargelowtemp" min="-40" max="45" onchange="EnqueueUpdate('dischargelowtemp')" onkeypress="HandleEnter(event, 'dischargelowtemp')">
              <div class="field-error" id="err_dischargelowtemp"></div>
            </div>
          </div>
        </div>

        <div class="section-title">Advanced Settings</div>
        <div class="form-row">
          <div class="checkbox-row">
            <input type="checkbox" id="autocharge" onchange="SendJSONUpdate('autocharge')">
            <label for="autocharge"><span class="tip" data-tip="Enable active current management during absorption phase. Steps charge current up/down to hold voltage at target.">Smart Adjust Enabled</span></label>
          </div>
          <div class="form-group">
            <label for="smartinterval"><span class="tip" data-tip="Seconds between each charge current adjustment during absorption. Higher = slower, smoother adjustments.">Smart Interval (seconds):</span></label>
            <input type="number" id="smartinterval" onchange="EnqueueUpdate('smartinterval')" onkeypress="HandleEnter(event, 'smartinterval')">
          </div>
        </div>
        
        <div class="button-group">
          <button class="btn-primary" onclick="saveAll()">Save to EEPROM</button>
          <button onclick="rebootBMS()">Reboot &amp; Apply</button>
        </div>
      </section>

      <!-- Schedule Tab -->
      <section id="schedule" class="tab-pane" role="tabpanel" aria-labelledby="tab-schedule">

        <div class="sched-noclock" id="schedNoClock" hidden>
          <span class="warning-icon">&#9888;</span>
          <div>
            <b>Scheduling is inactive until the clock is set.</b>
            Windows are stored, but nothing will run without a synced clock -
            the device would otherwise be working from the wrong date and time.
            Set an NTP server under <a href="#settings" onclick="switchTab('settings')">Settings</a>,
            then check Clock Sync on the Firmware tab.
          </div>
        </div>

        <div class="sched-status" id="schedStatus">
          <span class="sched-dot" id="schedDot"></span>
          <span>
            <span id="schedStatusText">No schedule active</span>
            <span class="sched-next" id="schedNextText"></span>
          </span>
        </div>

        <div class="sched-status sched-override" id="schedOverride" hidden>
          <span class="sched-dot"></span>
          <span>
            <span id="schedOverrideText"></span>
            <span class="sched-next" id="schedOverrideNext"></span>
          </span>
          <button class="sched-ovr-clear" onclick="clearOverride()">Return to Schedule</button>
        </div>

        <div class="section-title">Repeating Windows</div>
        <p class="sched-help">
          Saved on the device and used whenever no Home Assistant schedule is active.
          Times are in 5 minute steps and use the timezone set under Settings.
        </p>

        <div class="sched-table" id="schedRows"></div>

        <div class="button-group">
          <button onclick="addScheduleRow()">Add Window</button>
          <button class="btn-primary" onclick="saveSchedule()">Save Schedule</button>
        </div>

        <div class="section-title">From Home Assistant</div>
        <p class="sched-help">
          Pushed over MQTT to <span class="sched-topic" id="schedTopic">&lt;topic&gt;/set/Schedule</span>,
          held in memory only and never written to flash. These take priority over the
          repeating windows above, and expire on their own once their end time passes.
        </p>
        <div class="sched-mqtt" id="schedMqttList"></div>

        <div class="section-title">Outside Control</div>
        <p class="sched-help">
          Charge, discharge and force charge can also be driven from outside the schedule - the
          Dashboard toggles, Home Assistant over MQTT, or a supervisor such as PowerPilot on the
          WebSocket. Whatever does so takes that one lever off the schedule for the timeout below,
          then control reverts on its own. The timeout is the safety net: a controller that crashes
          or drops off the network cannot leave the battery sitting on its last command.
        </p>
        <div class="form-row">
          <div class="form-group">
            <label for="overridetimeout"><span class="tip" data-tip="Seconds an outside command holds a lever off the schedule. A supervisor should re-send well inside this. 0 disables the hold entirely, so the schedule always wins.">Override Timeout (s):</span></label>
            <input type="number" id="overridetimeout" min="0" max="3600" onchange="EnqueueUpdate('overridetimeout')" onkeypress="HandleEnter(event, 'overridetimeout')">
          </div>
        </div>
      </section>

      <!-- Settings Tab -->
      <section id="settings" class="tab-pane" role="tabpanel" aria-labelledby="tab-settings">
        <div class="section-title">CAN Bus Configuration</div>
        <div class="form-row">
          <div class="checkbox-row">
            <input type="checkbox" id="canbusenabled" onchange="SendJSONUpdate('canbusenabled')">
            <label for="canbusenabled"><span class="tip" data-tip="Enable CAN bus communication with the inverter. Disable if no inverter is connected.">CAN Bus Enabled</span></label>
          </div>
          <div class="form-group">
            <label for="canprotocol"><span class="tip" data-tip="Select the CAN protocol for your inverter. Pylontech 1.2 sends 0x359/0x35C request flags (most compatible). Pylontech 1.3 sends 0x35A/0x35F per official spec. SMA uses different voltage scaling. Victron adds alarm messages. Growatt/SolArk uses Pylontech 1.2 format.">Inverter Protocol:</span></label>
            <select id="canprotocol" onchange="SendJSONUpdate('canprotocol')">
              <option value="0">Pylontech 1.2</option>
              <option value="1">Pylontech 1.3</option>
              <option value="2">SMA</option>
              <option value="3">Victron</option>
              <option value="4">Growatt / SolArk</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          {{CAN_CONFIG_FIELDS}}
        </div>

        <div class="section-title">Victron Configuration</div>
        <div class="form-row">
          <div class="form-group">
            <label for="victronrxpin"><span class="tip" data-tip="GPIO pin connected to the Victron shunt TX line (VE.Direct data in).">Victron RX Pin:</span></label>
