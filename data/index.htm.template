<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DIY Battery BMS</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='3' y='8' width='23' height='16' rx='3' fill='none' stroke='%2335c9d4' stroke-width='2.5'/%3E%3Crect x='27' y='13' width='3' height='6' rx='1.5' fill='%2335c9d4'/%3E%3Crect x='6.5' y='11.5' width='4.5' height='9' rx='1' fill='%233fbf6a'/%3E%3Crect x='12.5' y='11.5' width='4.5' height='9' rx='1' fill='%233fbf6a'/%3E%3Crect x='18.5' y='11.5' width='4.5' height='9' rx='1' fill='%233fbf6a' opacity='0.45'/%3E%3C/svg%3E">
  <style>
    /* ============================================================
       DIY Battery BMS - instrumentation panel
       Design tokens. Dark is the default (wall-mounted / night use);
       light mode is a full first-class theme, not an afterthought.
       The theme toggle writes data-theme on <html>, which wins over
       the prefers-color-scheme default in both directions.
       ============================================================ */
    :root {
      --bg:          #10151c;
      --panel:       #171e27;
      --panel-2:     #1e2732;
      --raised:      #26313f;
      --line:        #2c3746;
      --line-soft:   #232d3a;
      --text:        #e6edf5;
      --text-dim:    #94a3b4;
      --text-faint:  #6b7889;
      --accent:      #35c9d4;
      --accent-dim:  #1d7f88;
      --accent-ink:  #06222a;
      --ok:          #3fbf6a;
      --warn:        #e0a33a;
      --err:         #e5544b;
      --charge:      #3fbf6a;
      --discharge:   #e0a33a;
      --info:        #4a9fe0;
      --shadow:      0 1px 2px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.28);
      --shadow-sm:   0 1px 2px rgba(0,0,0,.35);
      --focus:       0 0 0 2px var(--bg), 0 0 0 4px var(--accent);
      --r-sm: 4px;  --r: 7px;  --r-lg: 11px;
      --mono: ui-monospace, 'Cascadia Mono', 'SF Mono', 'JetBrains Mono', Consolas, 'DejaVu Sans Mono', monospace;
      --sans: 'Segoe UI Variable Text', 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
    }

    @media (prefers-color-scheme: light) {
      :root:not([data-theme="dark"]) {
        --bg:         #eef1f5;
        --panel:      #ffffff;
        --panel-2:    #f5f7fa;
        --raised:     #e9edf3;
        --line:       #d3dae3;
        --line-soft:  #e4e9ef;
        --text:       #16202c;
        --text-dim:   #57657a;
        --text-faint: #7d8a9c;
        --accent:     #0d7f8a;
        --accent-dim: #8fd6dc;
        --accent-ink: #ffffff;
        --ok:         #1f8f4a;
        --warn:       #a8701a;
        --err:        #c33529;
        --charge:     #1f8f4a;
        --discharge:  #a8701a;
        --info:       #1a6fb5;
        --shadow:     0 1px 2px rgba(16,32,48,.06), 0 8px 24px rgba(16,32,48,.08);
        --shadow-sm:  0 1px 2px rgba(16,32,48,.08);
      }
    }

    :root[data-theme="light"] {
      --bg:         #eef1f5;
      --panel:      #ffffff;
      --panel-2:    #f5f7fa;
      --raised:     #e9edf3;
      --line:       #d3dae3;
      --line-soft:  #e4e9ef;
      --text:       #16202c;
      --text-dim:   #57657a;
      --text-faint: #7d8a9c;
      --accent:     #0d7f8a;
      --accent-dim: #8fd6dc;
      --accent-ink: #ffffff;
      --ok:         #1f8f4a;
      --warn:       #a8701a;
      --err:        #c33529;
      --charge:     #1f8f4a;
      --discharge:  #a8701a;
      --info:       #1a6fb5;
      --shadow:     0 1px 2px rgba(16,32,48,.06), 0 8px 24px rgba(16,32,48,.08);
      --shadow-sm:  0 1px 2px rgba(16,32,48,.08);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    /* Several toggled elements carry classes that set display:grid/flex, which would
       otherwise beat the UA stylesheet's [hidden] rule. Make [hidden] authoritative. */
    [hidden] { display: none !important; }

    body {
      background: var(--bg);
      min-height: 100vh;
      padding: 18px;
      color: var(--text);
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.45;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 1180px;
      margin: 0 auto;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    /* ---------- Header ---------- */
    .header {
      background: var(--panel-2);
      border-bottom: 1px solid var(--line);
      padding: 14px 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .brand { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 200px; }

    /* State-of-charge mark: three cells draining left to right, the full one
       accented. Drawn from currentColor and --accent through classes rather
       than fill= attributes, because CSS variables are not valid in SVG
       presentation attributes - that is what lets one copy follow both themes. */
    .brand-mark { width: 23px; height: 23px; flex: none; color: var(--text); }
    .brand-mark .lvl-full { fill: var(--accent); }
    .brand-mark .lvl      { fill: currentColor; }
    .brand-mark .lvl-low  { fill: currentColor; opacity: .45; }

    .brand-words { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }

    /* Set the way the device already names itself - the hostname, the MQTT
       client id, the discovery node - rather than as a product wordmark. */
    .brand h1 {
      font-family: var(--mono);
      font-size: 15px;
      font-weight: 500;
      letter-spacing: .01em;
      color: var(--text);
    }
    .brand h1 .accent { color: var(--accent); }

    .brand .subtitle {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--text-faint);
      letter-spacing: .04em;
    }

    .header-meta {
      display: flex;
      align-items: center;
      gap: 14px;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--text-dim);
      flex-wrap: wrap;
    }

    .header-meta .meta-item { display: flex; align-items: center; gap: 5px; }
    .header-meta .meta-item b { font-weight: 600; color: var(--text); }

    .icon-btn {
      background: transparent;
      border: 1px solid var(--line);
      color: var(--text-dim);
      border-radius: var(--r-sm);
      width: 30px; height: 30px;
      display: inline-flex; align-items: center; justify-content: center;
      cursor: pointer;
      font-size: 14px;
      line-height: 1;
      transition: color .15s, border-color .15s, background .15s;
      padding: 0;
    }
    .icon-btn:hover { color: var(--accent); border-color: var(--accent-dim); background: var(--raised); }

    /* ---------- Connection pill ---------- */
    .conn-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--text-dim);
      border: 1px solid var(--line);
      border-radius: 100px;
      padding: 3px 10px 3px 8px;
      letter-spacing: .03em;
    }

    .dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--err);
      flex-shrink: 0;
      transition: background .3s, box-shadow .3s;
    }
    .dot.connected { background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent); }
    .conn-status.online { color: var(--text); border-color: color-mix(in srgb, var(--ok) 40%, var(--line)); }

    /* ---------- Tabs ---------- */
    .tabs {
      display: flex;
      background: var(--panel-2);
      border-bottom: 1px solid var(--line);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .tabs::-webkit-scrollbar { display: none; }

    .tab-button {
      flex: 1 0 auto;
      min-width: 96px;
      padding: 11px 16px;
      border: none;
      background: none;
      cursor: pointer;
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--text-faint);
      transition: color .15s, background .15s;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }
    .tab-button:hover { color: var(--text); background: var(--raised); }
    .tab-button[aria-selected="true"] {
      color: var(--accent);
      border-bottom-color: var(--accent);
      background: var(--panel);
    }
    .tab-button:focus-visible { outline: none; box-shadow: var(--focus); }

    .content { padding: 20px 22px 26px; }

    .tab-pane { display: none; }
    .tab-pane.active { display: block; animation: fadeIn .22s ease both; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }

    .pane-title {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--text-faint);
      margin-bottom: 16px;
    }

    /* ---------- Forms ---------- */
    .form-group { margin-bottom: 12px; }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 14px;
    }
    .form-row.full { grid-template-columns: 1fr; }
    .form-row.col3 { grid-template-columns: repeat(3, 1fr); }
    .form-row.col4 { grid-template-columns: repeat(4, 1fr); }

    /* Dashboard readouts. A fixed column count (rather than auto-fit) so that every
       row lines up with the ones above it - auto-fit sizes each grid independently,
       which leaves 3-item rows visibly wider than 4-item rows. */
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 12px;
    }

    label {
      display: block;
      margin-bottom: 5px;
      font-weight: 500;
      color: var(--text-dim);
      font-size: 12px;
    }

    input[type="text"], input[type="textbox"], input[type="password"],
    input[type="number"], input[type="file"], select {
      width: 100%;
      padding: 8px 10px;
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      color: var(--text);
      font-family: var(--mono);
      font-size: 13px;
      transition: border-color .15s, box-shadow .15s;
    }
    input[type="file"] { font-family: var(--sans); padding: 7px 10px; }
    select { font-family: var(--sans); cursor: pointer; }

    input:focus, select:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    }

    /* Invalid / cross-field validation */
    input.invalid, select.invalid {
      border-color: var(--err);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--err) 15%, transparent);
    }
    .field-error {
      display: none;
      margin-top: 4px;
      font-size: 11.5px;
      color: var(--err);
      line-height: 1.35;
    }
    .field-error.show { display: block; }
    /* Advisory: the value is accepted but the resulting behaviour is probably
       not what was intended. Amber rather than red so it reads as a caution. */
    .field-error.warn { color: var(--warn); }
    /* Neutral guidance: nothing is wrong, this is just what the battery setup
       above works out for the field. Muted so it never reads as a problem. */
    .field-error.info { color: var(--text-faint); }
    /* Always-on hint for a field the firmware fills in for itself. Same muted
       treatment as .field-error.info, but not driven by validation. */
    .field-note {
      margin-top: 4px;
      font-size: 11.5px;
      color: var(--text-faint);
      line-height: 1.35;
    }
    input.warn { border-color: var(--warn); }

    /* ---------- Battery setup recommender ---------- */
    .setup-summary {
      margin: 2px 0 12px;
      padding: 9px 11px;
      border: 1px solid var(--line);
      border-left: 3px solid var(--accent);
      border-radius: var(--r-sm);
      background: var(--raised);
      font-size: 12px;
      line-height: 1.5;
      color: var(--text-dim);
    }
    .setup-actions { margin-bottom: 18px; }

    /* An external controller is holding the current below what is configured.
       Amber because nothing is wrong, but the operator needs to know why the
       inverter is not using the ceiling they set. */
    .ctrl-note {
      margin: -6px 0 16px;
      padding: 9px 11px;
      border: 1px solid var(--line);
      border-left: 3px solid var(--warn);
      border-radius: var(--r-sm);
      background: var(--raised);
      font-size: 12px;
      line-height: 1.5;
      color: var(--text-dim);
    }
    /* The apply dialog lists one change per line, so its newlines have to survive */
    #modalBody { white-space: pre-line; }

    input[type="checkbox"] {
      width: 17px; height: 17px;
      cursor: pointer;
      accent-color: var(--accent);
      flex-shrink: 0;
    }

    .password-wrapper { position: relative; display: flex; align-items: center; }
    .password-wrapper input { padding-right: 58px; }

    .password-toggle {
      position: absolute;
      right: 5px;
      cursor: pointer;
      color: var(--text-dim);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .04em;
      text-transform: uppercase;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      padding: 4px 8px;
      transition: color .15s, border-color .15s;
    }
    .password-toggle:hover { color: var(--accent); border-color: var(--accent-dim); }

    /* ---------- Buttons ---------- */
    button {
      padding: 9px 16px;
      background: var(--raised);
      color: var(--text);
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      cursor: pointer;
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 500;
      transition: background .15s, border-color .15s, color .15s;
    }
    button:hover { border-color: var(--accent-dim); color: var(--accent); }
    button:active { transform: translateY(1px); }
    button:focus-visible { outline: none; box-shadow: var(--focus); }
    button:disabled { opacity: .45; cursor: not-allowed; transform: none; }
    button:disabled:hover { border-color: var(--line); color: var(--text); }

    .btn-primary {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-ink);
      font-weight: 600;
    }
    .btn-primary:hover { background: color-mix(in srgb, var(--accent) 85%, #fff); color: var(--accent-ink); border-color: var(--accent); }

    .btn-danger { color: var(--err); border-color: color-mix(in srgb, var(--err) 45%, var(--line)); }
    .btn-danger:hover { background: color-mix(in srgb, var(--err) 12%, transparent); color: var(--err); border-color: var(--err); }

    .button-group { display: flex; gap: 10px; margin-top: 16px; flex-wrap: wrap; }
    .button-group button { flex: 1; min-width: 150px; }

    .checkbox-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .checkbox-row label { margin-bottom: 0; color: var(--text); font-size: 13px; }

    /* ---------- Section titles ---------- */
    .section-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 24px 0 12px;
    }
    .section-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--line);
    }
    .section-title:first-child { margin-top: 0; }

    /* ---------- Stat boxes / readouts ---------- */
    .stat-box {
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-left: 3px solid var(--accent);
      border-radius: var(--r);
      padding: 11px 13px;
      min-height: 66px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 3px;
    }
    .stat-box.stat-charge    { border-left-color: var(--charge); }
    .stat-box.stat-discharge { border-left-color: var(--discharge); }
    .stat-box.stat-status    { border-left-color: var(--info); }

    .stat-label {
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--text-faint);
    }

    .stat-value {
      font-family: var(--mono);
      font-size: 19px;
      font-weight: 600;
      color: var(--text);
      line-height: 1.15;
      font-variant-numeric: tabular-nums;
    }
    .stat-value .unit {
      font-size: 12px;
      font-weight: 400;
      color: var(--text-faint);
      margin-left: 1px;
    }
    .stat-value.sm { font-size: 14px; }
    /* A figure that happens to be a link still reads as a figure: same face,
       same weight, same colour as its neighbours, with the underline left to
       hover. Left to the browser it arrives blue and underlined and looks like
       a mistake in a row of readings. The warn class still wins when the panel
       is flagging a newer version. */
    .stat-value a { color: inherit; text-decoration: none; border-bottom: 1px dotted var(--text-faint); }
    .stat-value a:hover { color: var(--accent); border-bottom-color: var(--accent); }

    /* semantic state classes (replaces inline .style.color writes) */
    .v-ok    { color: var(--ok) !important; }
    .v-warn  { color: var(--warn) !important; }
    .v-err   { color: var(--err) !important; }
    .v-info  { color: var(--info) !important; }
    .v-accent{ color: var(--accent) !important; }
    .v-dim   { color: var(--text-faint) !important; }

    /* ---------- Toggle switch (charge / discharge / force charge) ---------- */
    .toggle-box {
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-left: 3px solid var(--line);
      border-radius: var(--r);
      padding: 11px 13px;
      min-height: 66px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      cursor: pointer;
      transition: border-color .18s, background .18s;
      text-align: left;
      width: 100%;
      font-family: inherit;
    }
    .toggle-box:hover { background: var(--raised); border-color: var(--line); }
    .toggle-box:focus-visible { outline: none; box-shadow: var(--focus); }
    .toggle-box[aria-pressed="true"].tg-charge    { border-left-color: var(--charge); }
    .toggle-box[aria-pressed="true"].tg-discharge { border-left-color: var(--discharge); }
    .toggle-box[aria-pressed="true"].tg-force     { border-left-color: var(--err); }

    .toggle-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .toggle-state {
      font-family: var(--mono);
      font-size: 14px;
      font-weight: 600;
      color: var(--text-faint);
      letter-spacing: .04em;
    }
    .toggle-box[aria-pressed="true"] .toggle-state { color: var(--ok); }

    .switch {
      position: relative;
      width: 40px; height: 22px;
      border-radius: 100px;
      background: var(--line);
      flex-shrink: 0;
      transition: background .2s;
    }
    .switch::after {
      content: '';
      position: absolute;
      top: 3px; left: 3px;
      width: 16px; height: 16px;
      border-radius: 50%;
      background: var(--text-faint);
      transition: transform .2s cubic-bezier(.3,.8,.4,1), background .2s;
    }
    .toggle-box[aria-pressed="true"] .switch { background: color-mix(in srgb, var(--ok) 40%, var(--line)); }
    .toggle-box[aria-pressed="true"] .switch::after { transform: translateX(18px); background: var(--ok); }

    /* Force charge is an intervention rather than a healthy running state, so it
       goes on in the alarm colour instead of the usual green. */
    .toggle-box[aria-pressed="true"].tg-force .toggle-state { color: var(--err); }
    .toggle-box[aria-pressed="true"].tg-force .switch { background: color-mix(in srgb, var(--err) 40%, var(--line)); }
    .toggle-box[aria-pressed="true"].tg-force .switch::after { background: var(--err); }

    /* ---------- Battery visual ---------- */
    .battery-visual {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 26px;
      margin: 8px 0 18px;
      flex-wrap: wrap;
    }

    .status-stack { display: flex; flex-direction: column; gap: 7px; min-width: 130px; }

    .status-dot-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--mono);
      font-size: 11px;
      color: var(--text-dim);
      letter-spacing: .03em;
    }

    .battery-col { display: flex; flex-direction: column; align-items: center; gap: 9px; }
    .battery-rig { display: flex; align-items: center; }

    /* ---------- SOC override notice ----------
       The firmware deliberately reports a different SOC to the inverter in a few
       cases (holding 99% until absorption completes, "never send 100%", the
       force-charge trick). Without this the dashboard and the inverter disagree
       and there is nothing on screen to explain why. */
    .soc-override {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      max-width: 280px;
      text-align: center;
      animation: fadeIn .25s ease both;
    }

    .soc-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 4px 10px;
      border-radius: 100px;
      background: color-mix(in srgb, var(--info) 14%, var(--panel));
      border: 1px solid color-mix(in srgb, var(--info) 45%, var(--line));
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: .04em;
      white-space: nowrap;
    }
    .soc-chip-label { color: var(--text-dim); text-transform: uppercase; }
    .soc-chip-value { color: var(--info); font-weight: 700; font-size: 13px; }

    .soc-why { font-size: 11.5px; color: var(--text-faint); line-height: 1.4; }

    /* Mark the gauge itself, so the real number is never read in isolation */
    .battery-container.overridden { border-color: color-mix(in srgb, var(--info) 55%, var(--line)); }
    .battery-container.overridden .battery-percentage::after {
      content: '*';
      color: var(--info);
      font-size: 20px;
      vertical-align: super;
      margin-left: 1px;
    }

    .battery-container {
      position: relative;
      width: 216px;
      height: 96px;
      border: 2px solid var(--line);
      border-radius: var(--r);
      overflow: hidden;
      background: var(--bg);
    }

    .battery-level {
      position: absolute;
      left: 0; top: 0;
      height: 100%;
      width: 0;
      background: var(--ok);
      opacity: .22;
      transition: width .6s cubic-bezier(.4,0,.2,1), background .3s;
    }
    .battery-level.low    { background: var(--err); }
    .battery-level.medium { background: var(--warn); }
    .battery-level.high   { background: var(--ok); }

    /* segment ticks over the fill, like a real gauge */
    .battery-container::after {
      content: '';
      position: absolute; inset: 0;
      background-image: linear-gradient(90deg, var(--line) 1px, transparent 1px);
      background-size: 21.6px 100%;
      opacity: .5;
      pointer-events: none;
    }

    .battery-percentage {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--mono);
      font-size: 34px;
      font-weight: 600;
      color: var(--text);
      font-variant-numeric: tabular-nums;
      z-index: 1;
    }

    .battery-tip {
      width: 5px; height: 34px;
      background: var(--line);
      border-radius: 0 3px 3px 0;
    }

    .battery-wave { position: absolute; inset: 0; display: none; z-index: 0; }
    .battery-wave.active { display: block; }
    .battery-wave.charging {
      background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ok) 30%, transparent), transparent);
      animation: sweep 2.2s linear infinite;
    }
    .battery-wave.discharging {
      background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--warn) 30%, transparent), transparent);
      animation: sweep 2.2s linear infinite reverse;
    }
    @keyframes sweep { from { transform: translateX(-100%); } to { transform: translateX(100%); } }

    /* ---------- Power flow ---------- */
    .power-flow-indicator {
      text-align: center;
      margin: 0 0 18px;
      padding: 9px 14px;
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-radius: var(--r);
    }

    .flow-text {
      font-family: var(--mono);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: .05em;
      text-transform: uppercase;
      color: var(--text-dim);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
    }
    .flow-text::before {
      content: '';
      width: 7px; height: 7px;
      border-radius: 50%;
      background: currentColor;
      flex-shrink: 0;
    }
    .flow-text.charging::before,
    .flow-text.discharging::before { animation: pulse 1.4s ease-in-out infinite; }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%      { opacity: .35; transform: scale(1.45); }
    }

    /* ---------- Absorption progress ---------- */
    .absorb-panel {
      margin: 0 0 18px;
      padding: 13px 15px;
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-left: 3px solid var(--warn);
      border-radius: var(--r);
      animation: fadeIn .25s ease both;
    }

    .absorb-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 11px;
      flex-wrap: wrap;
    }
    .absorb-title {
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--warn);
    }
    .absorb-summary {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--text);
    }

    .absorb-row {
      display: grid;
      grid-template-columns: 116px 1fr 92px;
      align-items: center;
      gap: 11px;
      margin-bottom: 7px;
    }
    .absorb-label {
      font-size: 11px;
      color: var(--text-faint);
      letter-spacing: .02em;
    }
    .absorb-track {
      height: 7px;
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: 100px;
      overflow: hidden;
    }
    .absorb-bar {
      height: 100%;
      width: 0;
      background: var(--info);
      border-radius: 100px;
      transition: width .5s cubic-bezier(.4,0,.2,1), background .3s;
    }
    /* The tail bar is the one that resets, so colour-code whether it is running */
    .absorb-bar.tail { background: var(--text-faint); }
    .absorb-bar.tail.running { background: var(--ok); }
    .absorb-val {
      font-family: var(--mono);
      font-size: 11.5px;
      color: var(--text-dim);
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    .absorb-note {
      margin-top: 9px;
      padding-top: 9px;
      border-top: 1px solid var(--line-soft);
      font-size: 11.5px;
      color: var(--text-faint);
      line-height: 1.45;
    }

    @media (max-width: 640px) {
      .absorb-row { grid-template-columns: 1fr 68px; grid-template-areas: 'label val' 'track track'; row-gap: 4px; }
      .absorb-label { grid-area: label; }
      .absorb-val { grid-area: val; }
      .absorb-track { grid-area: track; margin-bottom: 5px; }
    }

    /* ---------- Schedule editor ---------- */
    .sched-status {
      display: flex; align-items: center; gap: 9px;
      padding: 10px 14px; margin-bottom: 18px;
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-left: 3px solid var(--line);
      border-radius: var(--r);
      font-size: 13px;
    }
    .sched-status.active { border-left-color: var(--ok); }
    .sched-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-faint); flex-shrink: 0; }
    .sched-status.active .sched-dot { background: var(--ok); }

    /* Something outside has taken a lever off the schedule - amber, because it
       is a temporary state that will end on its own, not a fault. */
    .sched-override { border-left-color: var(--warn); }
    .sched-override .sched-dot { background: var(--warn); }
    .sched-ovr-clear { margin-left: auto; flex-shrink: 0; padding: 5px 10px; font-size: 11.5px; }

    .sched-noclock {
      display: flex; align-items: flex-start; gap: 11px;
      padding: 12px 14px; margin-bottom: 16px;
      background: color-mix(in srgb, var(--warn) 12%, var(--panel));
      border: 1px solid color-mix(in srgb, var(--warn) 40%, var(--line));
      border-left: 3px solid var(--warn);
      border-radius: var(--r);
      font-size: 12.5px; line-height: 1.5; color: var(--text);
    }
    .sched-noclock a { color: var(--accent); }
    .sched-noclock .warning-icon { color: var(--warn); }

    .sched-next { display: block; margin-top: 3px; font-size: 11.5px; color: var(--text-faint); }
    .sched-help { font-size: 12px; color: var(--text-faint); margin-bottom: 12px; line-height: 1.5; }
    .sched-topic { font-family: var(--mono); color: var(--text-dim); }

    .sched-table { display: flex; flex-direction: column; gap: 9px; }
    .sched-count { align-self: center; font-size: 12px; color: var(--text-faint); flex: none; }
    .sched-count.full { color: var(--warn); }

    .fw-download { margin-bottom: 12px; }
    .fw-download a { font-size: 13px; font-weight: 500; }
    .fw-download-note { display: block; margin-top: 2px; font-size: 11.5px; color: var(--text-faint); }
    .fw-download-note.new { color: var(--warn); }

    .sched-row {
      display: grid;
      /* Fields group left; the slack column keeps Remove pinned right instead of
         letting the Repeat select swallow the whole row. */
      grid-template-columns: 92px 92px minmax(130px, 210px) 84px 84px 84px 78px 1fr 34px;
      gap: 8px;
      align-items: end;
      padding: 11px 12px;
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-radius: var(--r);
    }
    .sched-row label {
      font-size: 9.5px; letter-spacing: .07em; text-transform: uppercase;
      color: var(--text-faint); margin-bottom: 3px;
    }
    .sched-row input, .sched-row select { padding: 6px 7px; font-size: 12px; }
    .sched-row .row-remove {
      grid-column: -2 / -1;
      padding: 6px 0; font-size: 15px; line-height: 1;
      color: var(--err); border-color: color-mix(in srgb, var(--err) 40%, var(--line));
    }
    .sched-row .row-remove:hover { background: color-mix(in srgb, var(--err) 12%, transparent); color: var(--err); }

    .sched-empty {
      padding: 16px; text-align: center;
      font-size: 12.5px; color: var(--text-faint);
      border: 1px dashed var(--line); border-radius: var(--r);
    }

    .sched-mqtt { display: flex; flex-direction: column; gap: 7px; }
    .sched-mqtt-row {
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
      padding: 9px 12px;
      background: var(--panel-2);
      border: 1px solid var(--line-soft);
      border-left: 3px solid var(--info);
      border-radius: var(--r);
      font-family: var(--mono); font-size: 12px;
    }
    .sched-mqtt-row .when { color: var(--text); }
    .sched-mqtt-row .what { color: var(--text-dim); }
    .sched-mqtt-row.now { border-left-color: var(--ok); }

    @media (max-width: 860px) {
      .sched-row {
        /* Three equal columns so the three action selects each get a usable
           width - a narrow column sized for the Remove button was clipping
           "Force" down to a couple of characters. */
        grid-template-columns: 1fr 1fr 1fr;
        grid-template-areas:
          'start  end       remove'
          'days   days      days'
          'charge discharge force'
          'soc    soc       soc';
      }
      .sched-row .f-start { grid-area: start; }
      .sched-row .f-end { grid-area: end; }
      .sched-row .f-days { grid-area: days; }
      .sched-row .f-charge { grid-area: charge; }
      .sched-row .f-discharge { grid-area: discharge; }
      .sched-row .f-force { grid-area: force; }
      .sched-row .f-soc { grid-area: soc; }
      .sched-row .row-remove { grid-area: remove; align-self: end; justify-self: end; width: 40px; height: 32px; }
    }

    /* ---------- Warnings ---------- */
    .status-warnings {
      margin: 0 0 18px;
      padding: 11px 14px;
      background: color-mix(in srgb, var(--warn) 12%, var(--panel));
      border: 1px solid color-mix(in srgb, var(--warn) 40%, var(--line));
      border-left: 3px solid var(--warn);
      border-radius: var(--r);
      animation: fadeIn .22s ease both;
    }
    .status-warnings.error {
      background: color-mix(in srgb, var(--err) 12%, var(--panel));
      border-color: color-mix(in srgb, var(--err) 40%, var(--line));
      border-left-color: var(--err);
    }

    .warning-box { display: flex; align-items: flex-start; gap: 10px; }
    .warning-icon { color: var(--warn); flex-shrink: 0; font-size: 15px; line-height: 1.3; }
    .status-warnings.error .warning-icon { color: var(--err); }

    .warning-list { display: flex; flex-direction: column; gap: 3px; font-size: 13px; color: var(--text); }
    .warning-list .why { color: var(--text-dim); font-size: 12px; }

    /* ---------- Stale data overlay ---------- */
    .content.stale .tab-pane#home .stat-box,
    .content.stale .tab-pane#home .toggle-box,
    .content.stale .tab-pane#home .battery-rig,
    .content.stale .tab-pane#home .power-flow-indicator {
      opacity: .38;
      filter: grayscale(.7);
      transition: opacity .3s, filter .3s;
    }

    .stale-banner {
      display: none;
      align-items: center;
      gap: 9px;
      margin-bottom: 16px;
      padding: 10px 14px;
      background: color-mix(in srgb, var(--err) 12%, var(--panel));
      border: 1px solid color-mix(in srgb, var(--err) 40%, var(--line));
      border-left: 3px solid var(--err);
      border-radius: var(--r);
      font-size: 13px;
      color: var(--text);
    }
    .content.stale .stale-banner { display: flex; }

    .spinner {
      width: 13px; height: 13px;
      border: 2px solid color-mix(in srgb, var(--err) 30%, transparent);
      border-top-color: var(--err);
      border-radius: 50%;
      animation: spin .8s linear infinite;
      flex-shrink: 0;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .last-update {
      text-align: center;
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1px solid var(--line-soft);
      color: var(--text-faint);
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: .03em;
    }

    /* ---------- Logs ---------- */
    .log-viewer {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--r);
      padding: 12px 14px;
      height: 480px;
      overflow-y: auto;
      font-family: var(--mono);
      font-size: 12px;
      line-height: 1.65;
      color: var(--text-dim);
    }
    .log-entry { word-wrap: break-word; white-space: pre-wrap; }
    .log-entry.error   { color: var(--err); }
    .log-entry.warning { color: var(--warn); }
    .log-entry.info    { color: var(--text); }
    .log-entry.debug   { color: var(--text-faint); }
    .log-entry.hidden  { display: none; }

    .log-controls {
      display: flex;
      gap: 10px;
      margin-bottom: 14px;
      align-items: center;
      flex-wrap: wrap;
    }
    .log-controls button { padding: 7px 13px; font-size: 12px; }
    .log-controls label {
      margin: 0;
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 12px;
      color: var(--text-dim);
    }
    .log-controls select { width: auto; padding: 6px 9px; font-size: 12px; }
    .log-spacer { flex: 1; }

    /* ---------- Danger zone ---------- */
    .danger-zone {
      margin-top: 26px;
      border: 1px solid color-mix(in srgb, var(--err) 35%, var(--line));
      border-radius: var(--r);
      overflow: hidden;
      background: color-mix(in srgb, var(--err) 5%, var(--panel));
    }
    .danger-zone > summary {
      padding: 11px 14px;
      cursor: pointer;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--err);
      list-style: none;
      display: flex;
      align-items: center;
      gap: 8px;
      user-select: none;
    }
    .danger-zone > summary::-webkit-details-marker { display: none; }
    .danger-zone > summary::before { content: '\25B8'; transition: transform .2s; }
    .danger-zone[open] > summary::before { transform: rotate(90deg); }
    .danger-zone > summary:focus-visible { outline: none; box-shadow: var(--focus); }
    .danger-body { padding: 0 14px 14px; border-top: 1px solid color-mix(in srgb, var(--err) 22%, var(--line)); }
    .danger-body p { font-size: 12.5px; color: var(--text-dim); margin: 12px 0; }

    /* ---------- Modal dialog (replaces confirm/alert) ---------- */
    .modal-backdrop {
      position: fixed; inset: 0;
      background: rgba(4,8,13,.66);
      backdrop-filter: blur(2px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 3000;
    }
    .modal-backdrop.show { display: flex; animation: fadeIn .16s ease both; }

    .modal {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow);
      max-width: 430px;
      width: 100%;
      padding: 20px;
    }
    .modal h3 { font-size: 15px; margin-bottom: 9px; color: var(--text); font-weight: 600; }
    .modal p  { font-size: 13px; color: var(--text-dim); margin-bottom: 15px; line-height: 1.5; }
    .modal .modal-actions { display: flex; gap: 9px; justify-content: flex-end; }
    .modal .modal-actions button { flex: 0 0 auto; min-width: 92px; }
    .modal label { font-size: 12px; }
    .modal input { margin-bottom: 15px; }

    /* ---------- Toast ---------- */
    .toast {
      position: fixed;
      bottom: 18px; right: 18px;
      background: var(--raised);
      color: var(--text);
      border: 1px solid var(--line);
      border-left: 3px solid var(--accent);
      padding: 11px 16px;
      border-radius: var(--r);
      box-shadow: var(--shadow);
      opacity: 0;
      transform: translateY(6px);
      pointer-events: none;
      transition: opacity .2s, transform .2s;
      z-index: 4000;
      min-width: 170px;
      max-width: min(380px, calc(100vw - 36px));
      font-size: 13px;
      font-weight: 500;
    }
    .toast.show { opacity: 1; transform: none; }
    .toast.success { border-left-color: var(--ok); }
    .toast.pending { border-left-color: var(--warn); }
    .toast.error   { border-left-color: var(--err); }

    /* ---------- Unsaved-changes bar ---------- */
    .unsaved-bar {
      display: none;
      align-items: center;
      gap: 11px;
      margin-bottom: 16px;
      padding: 9px 13px;
      background: color-mix(in srgb, var(--warn) 11%, var(--panel));
      border: 1px solid color-mix(in srgb, var(--warn) 38%, var(--line));
      border-left: 3px solid var(--warn);
      border-radius: var(--r);
      font-size: 12.5px;
      color: var(--text);
    }
    .unsaved-bar.show { display: flex; }
    .unsaved-bar button { padding: 5px 12px; font-size: 12px; }
    .unsaved-bar .spacer { flex: 1; }

    /* ---------- Firmware progress ---------- */
    .progress-track {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      overflow: hidden;
      height: 24px;
    }
    .progress-bar {
      background: var(--accent);
      color: var(--accent-ink);
      height: 100%;
      width: 0;
      transition: width .3s;
      text-align: center;
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 600;
      line-height: 22px;
    }
    .progress-bar.ok   { background: var(--ok); }
    .progress-bar.err  { background: var(--err); }
    .progress-bar.warn { background: var(--warn); }

    /* ---------- Tooltips (tap-friendly) ---------- */
    .tip {
      position: relative;
      cursor: help;
      border-bottom: 1px dotted var(--text-faint);
    }
    .tip .tip-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 14px; height: 14px;
      margin-left: 4px;
      border-radius: 50%;
      border: 1px solid var(--line);
      background: var(--raised);
      color: var(--text-faint);
      font-size: 9px;
      font-weight: 700;
      cursor: pointer;
      vertical-align: middle;
      padding: 0;
      line-height: 1;
    }
    .tip .tip-btn:hover { color: var(--accent); border-color: var(--accent-dim); }

    /* One shared bubble, positioned in viewport coordinates by JS, rather than a
       ::after on each .tip. The page container clips its overflow, so a bubble
       anchored inside it was cut off for fields near a panel edge or on a top row,
       leaving the text unreadable with no way to scroll to the rest. Fixed
       positioning escapes the clip; positionTip() then keeps it on screen. */
    .tip-pop {
      position: fixed;
      top: 0; left: 0;
      background: var(--raised);
      color: var(--text);
      border: 1px solid var(--line);
      padding: 8px 10px;
      border-radius: var(--r-sm);
      box-shadow: var(--shadow);
      font-size: 12px;
      font-weight: 400;
      line-height: 1.45;
      letter-spacing: normal;
      text-transform: none;
      text-align: left;
      white-space: normal;
      max-width: min(320px, calc(100vw - 24px));
      opacity: 0;
      pointer-events: none;
      transition: opacity .16s;
      z-index: 2000;
    }
    .tip-pop.show { opacity: 1; }

    /* ---------- WiFi ---------- */
    .wifi-controls { display: flex; gap: 10px; }
    .wifi-controls select { flex: 1; font-family: var(--mono); font-size: 12px; }
    .wifi-controls button { flex: 0 0 auto; }

    /* ---------- Responsive ---------- */
    @media (max-width: 860px) {
      .form-row.col4 { grid-template-columns: 1fr 1fr; }
      .form-row.col3 { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 640px) {
      body { padding: 0; }
      .container { border-radius: 0; border-left: none; border-right: none; min-height: 100vh; }
      .header { padding: 12px 14px; gap: 10px; }
      .brand { min-width: 0; flex: 1 1 100%; }
      .header-meta { flex: 1 1 100%; font-size: 10.5px; gap: 10px; }
      .content { padding: 16px 14px 22px; }
      /* Config inputs go full width - they need the room for labels + values.
         Dashboard readouts stay 2-up, which fits comfortably even at 320px. */
      .form-row, .form-row.col3, .form-row.col4 { grid-template-columns: 1fr; gap: 11px; margin-bottom: 11px; }
      .form-row.col4 { grid-template-columns: 1fr 1fr; }
      .stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-bottom: 10px; }

      /* Wrap the tabs rather than scrolling them: a hidden horizontal scroll gives
         no hint that Firmware exists off-screen. */
      .tabs { flex-wrap: wrap; overflow-x: visible; }
      .tab-button { flex: 1 0 33.333%; }
      .stat-box { min-height: 58px; padding: 9px 11px; }
      .stat-value { font-size: 17px; }
      .toggle-box { min-height: 58px; padding: 9px 11px; gap: 7px; }
      .toggle-state { font-size: 13px; }
      .switch { width: 34px; height: 19px; }
      .switch::after { width: 13px; height: 13px; }
      .toggle-box[aria-pressed="true"] .switch::after { transform: translateX(15px); }
      .tab-button { min-width: 0; flex: 0 0 auto; padding: 10px 13px; font-size: 11px; }
      .battery-visual { gap: 16px; }
      .battery-container { width: 172px; height: 78px; }
      .battery-percentage { font-size: 27px; }
      .battery-tip { height: 26px; }
      .status-stack { flex-direction: row; flex-wrap: wrap; justify-content: center; min-width: 0; gap: 12px; }
      .button-group { flex-direction: column; }
      .button-group button { min-width: 0; }
      .log-viewer { height: 62vh; }
      .toast { left: 12px; right: 12px; bottom: 12px; max-width: none; }
    }

    /* ---------- Motion / contrast preferences ---------- */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }
    }

    /* Fallback for browsers without color-mix(): the mixes above degrade to
       transparent, so restore solid borders/backgrounds for the key surfaces. */
    @supports not (color: color-mix(in srgb, red 50%, blue)) {
      .status-warnings { background: var(--panel-2); border-color: var(--warn); }
      .status-warnings.error { background: var(--panel-2); border-color: var(--err); }
      .stale-banner { background: var(--panel-2); border-color: var(--err); }
      .unsaved-bar { background: var(--panel-2); border-color: var(--warn); }
      .danger-zone { background: var(--panel); border-color: var(--err); }
      .danger-body { border-top-color: var(--err); }
      .btn-danger { border-color: var(--err); }
      .dot.connected { box-shadow: none; }
      .toggle-box[aria-pressed="true"] .switch { background: var(--ok); }
      .toggle-box[aria-pressed="true"].tg-force .switch { background: var(--err); }
      input:focus, select:focus { box-shadow: 0 0 0 3px var(--accent-dim); }
    }
  </style>
</head>
<body>
  <div class="container">
    <header class="header">
      <div class="brand">
        <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
          <rect class="lvl-full" x="3" y="4" width="18" height="4.6" rx="2.3"/>
          <rect class="lvl" x="3" y="10.2" width="12.5" height="4.6" rx="2.3"/>
          <rect class="lvl-low" x="3" y="16.4" width="7" height="4.6" rx="2.3"/>
        </svg>
        <div class="brand-words">
          <h1>diy<span class="accent">-</span>battery<span class="accent">-</span>bms</h1>
          <span class="subtitle">Inverter Bridge</span>
        </div>
      </div>
      <div class="header-meta">
        <span class="meta-item" id="hostMeta" hidden><b id="hostName">--</b></span>
        <span class="meta-item" id="fwMeta" hidden>fw <b id="fwHeader">--</b></span>
        <span class="conn-status" id="connPill">
          <span class="dot" id="connDot"></span><span id="connText">Offline</span>
        </span>
        <button class="icon-btn" id="themeBtn" onclick="cycleTheme()" title="Switch theme" aria-label="Switch colour theme">&#9681;</button>
      </div>
    </header>

    <nav class="tabs" role="tablist" aria-label="Sections">
      <button class="tab-button" role="tab" id="tab-home"     aria-selected="true"  aria-controls="home"     onclick="switchTab('home')">Home</button>
      <button class="tab-button" role="tab" id="tab-bms"      aria-selected="false" aria-controls="bms"      onclick="switchTab('bms')">BMS</button>
      <button class="tab-button" role="tab" id="tab-schedule" aria-selected="false" aria-controls="schedule" onclick="switchTab('schedule')">Schedule</button>
      <button class="tab-button" role="tab" id="tab-settings" aria-selected="false" aria-controls="settings" onclick="switchTab('settings')">Settings</button>
      <button class="tab-button" role="tab" id="tab-wifimqtt" aria-selected="false" aria-controls="wifimqtt" onclick="switchTab('wifimqtt')">WiFi/BLE/MQTT</button>
      <button class="tab-button" role="tab" id="tab-logs"     aria-selected="false" aria-controls="logs"     onclick="switchTab('logs')">Logs</button>
      <button class="tab-button" role="tab" id="tab-firmware" aria-selected="false" aria-controls="firmware" onclick="switchTab('firmware')">Firmware</button>
    </nav>

    <main class="content" id="content">
      <!-- Edits apply to the running device immediately, but only persist across a
           reboot once written to EEPROM. This makes that distinction visible. -->
      <div class="unsaved-bar" id="unsavedBar">
        <span><b>Unsaved changes.</b> Applied now, but will be lost on reboot.</span>
        <span class="spacer"></span>
        <button class="btn-primary" onclick="saveAll()">Save to EEPROM</button>
      </div>

      <!-- Home Tab -->
      <section id="home" class="tab-pane active" role="tabpanel" aria-labelledby="tab-home">

        <!-- Shown whenever the socket is down: the readouts below are frozen, not live -->
        <div class="stale-banner">
          <span class="spinner"></span>
          <span><b>Connection lost.</b> Readings below are from <span id="staleSince">the last update</span> and are not live.</span>
        </div>

        <div class="battery-visual">
          <div class="status-stack">
            <div class="status-dot-row" id="inverterStatusRow" hidden>
              <span class="dot" id="inverterDot"></span><span>Inverter</span>
            </div>
            <div class="status-dot-row">
              <span class="dot" id="shuntDot"></span><span>Shunt Data</span>
            </div>
            <div class="status-dot-row">
              <span class="dot" id="mqttDot"></span><span>MQTT</span>
            </div>
          </div>

          <div class="battery-col">
            <div class="battery-rig">
              <div class="battery-container" role="img" id="batteryGauge" aria-label="Battery state of charge 0%">
                <div class="battery-level" id="batteryLevel"></div>
                <div class="battery-wave" id="batteryWave"></div>
                <div class="battery-percentage" id="batteryPercentage">0%</div>
              </div>
              <div class="battery-tip"></div>
            </div>

            <!-- Only appears when the SOC on the CAN bus differs from the real pack SOC -->
            <div class="soc-override" id="socOverride" hidden>
              <span class="soc-chip">
                <span class="soc-chip-label">Inverter is told</span>
                <span class="soc-chip-value" id="reportedSocValue">99%</span>
              </span>
              <span class="soc-why" id="socOverrideWhy"></span>
            </div>
          </div>
        </div>

        <div class="power-flow-indicator">
          <div id="powerFlowText" class="flow-text">Idle</div>
        </div>

        <!-- Absorption ends on whichever finishes first: the tail-current hold, or the
             max absorption timeout. Both are shown because the tail timer resets every
             time current rises back above the threshold, which is otherwise invisible
             and makes a long absorption look stuck. -->
        <div class="absorb-panel" id="absorbPanel" hidden>
          <div class="absorb-head">
            <span class="absorb-title">Absorption</span>
            <span class="absorb-summary" id="absorbSummary"></span>
          </div>

          <div class="absorb-row">
            <span class="absorb-label">Tail current hold</span>
            <div class="absorb-track"><div class="absorb-bar tail" id="tailBar"></div></div>
            <span class="absorb-val" id="tailVal">--</span>
          </div>

          <div class="absorb-row">
            <span class="absorb-label">Max absorption</span>
            <div class="absorb-track"><div class="absorb-bar" id="absorbBar"></div></div>
            <span class="absorb-val" id="absorbVal">--</span>
          </div>

          <div class="absorb-note" id="absorbNote"></div>
        </div>

        <div id="statusWarnings" class="status-warnings" hidden>
          <div class="warning-box">
            <span class="warning-icon">&#9888;</span>
            <div class="warning-list" id="warningText"></div>
          </div>
        </div>

        <div class="stat-grid">
          <div class="stat-box stat-status">
            <div class="stat-label">Battery Voltage</div>
            <div class="stat-value"><span id="battvoltage">0</span><span class="unit">V</span></div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Battery Current</div>
            <div class="stat-value"><span id="battcurrent">0</span><span class="unit">A</span></div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Power</div>
            <div class="stat-value"><span id="battpower">0</span><span class="unit">W</span></div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Time to Go</div>
            <div class="stat-value"><span id="timetogo">--</span></div>
          </div>
        </div>

        <div class="stat-grid">
          <div class="stat-box stat-charge">
            <div class="stat-label">Charge Phase</div>
            <div class="stat-value sm" id="chargephaseStatus">--</div>
          </div>
          <div class="stat-box stat-charge">
            <div class="stat-label">Absorption Adjust</div>
            <div class="stat-value"><span id="chargeadjust">0</span><span class="unit">A</span></div>
          </div>
          <div class="stat-box stat-charge">
            <div class="stat-label">Charge Limit</div>
            <div class="stat-value"><span id="chargecurrent">0</span><span class="unit">A</span></div>
          </div>
          <div class="stat-box stat-discharge">
            <div class="stat-label">Discharge Limit</div>
            <div class="stat-value"><span id="dischargecurrent">0</span><span class="unit">A</span></div>
          </div>
        </div>

        <div id="tempRow" class="stat-grid" hidden>
          <div class="stat-box stat-status">
            <div class="stat-label">Battery Temp</div>
            <div class="stat-value"><span id="batttemp">--</span><span class="unit">&deg;C</span></div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Inverter Temp</div>
            <div class="stat-value"><span id="mqttinvertertemp">--</span><span class="unit">&deg;C</span></div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Fan PWM</div>
            <div class="stat-value"><span id="fanpwm">0</span><span class="unit">%</span></div>
          </div>
        </div>

        <div class="stat-grid">
          <button type="button" class="toggle-box tg-charge" id="chargeToggle"
                  aria-pressed="false" onclick="toggleChargeEnable()">
            <span class="toggle-text">
              <span class="stat-label">Charge</span>
              <span class="toggle-state" id="chargeenabledStatus">OFF</span>
            </span>
            <span class="switch" aria-hidden="true"></span>
          </button>
          <button type="button" class="toggle-box tg-discharge" id="dischargeToggle"
                  aria-pressed="false" onclick="toggleDischargeEnable()">
            <span class="toggle-text">
              <span class="stat-label">Discharge</span>
              <span class="toggle-state" id="dischargeenabledStatus">OFF</span>
            </span>
            <span class="switch" aria-hidden="true"></span>
          </button>
          <button type="button" class="toggle-box tg-force" id="forceToggle"
                  aria-pressed="false" onclick="toggleForceCharge()">
            <span class="toggle-text">
              <span class="stat-label">Force Charge</span>
              <span class="toggle-state" id="forcechargeStatus">OFF</span>
            </span>
            <span class="switch" aria-hidden="true"></span>
          </button>
        </div>

        <div class="last-update">
          Last updated <span id="lastUpdate">--</span>
        </div>
      </section>
      
      <!-- BMS Tab -->
      <section id="bms" class="tab-pane" role="tabpanel" aria-labelledby="tab-bms">
        <div class="section-title">Battery Setup</div>
        <div class="form-row col3">
          <div class="form-group">
            <label for="batchem"><span class="tip" data-tip="Cell chemistry. Sets the per-cell voltages every recommendation below is derived from, so get this right first.">Chemistry:</span></label>
            <select id="batchem" onchange="onBatterySetupChange()">
              <option value="lfp">LiFePO4</option>
              <option value="nmc">Li-ion (NMC/NCA)</option>
              <option value="lto">LTO</option>
            </select>
          </div>
          <div class="form-group">
            <label for="batcells"><span class="tip" data-tip="Number of cells wired in series - 16 for a typical 48V LiFePO4 pack. Parallel strings do not count here; they go into capacity.">Cells in Series (S):</span></label>
            <input type="number" id="batcells" min="1" max="64" step="1" oninput="onBatterySetupChange()">
          </div>
          <div class="form-group">
            <label for="batterycapacity"><span class="tip" data-tip="Total usable capacity in amp hours, counting all parallel strings. Drives the tail, float and slow-charge currents as well as the slow charge dividers.">Battery Capacity (Ah):</span></label>
            <input type="number" id="batterycapacity" min="0" max="9999" step="0.1" oninput="onBatterySetupChange()" onchange="EnqueueUpdate('batterycapacity')" onkeypress="HandleEnter(event, 'batterycapacity')">
          </div>
        </div>
        <div class="setup-summary" id="setupSummary"></div>
        <div class="setup-actions">
          <button type="button" onclick="applyRecommended()">Apply Recommended Values</button>
        </div>

        <div class="section-title">Voltage Configuration</div>
        <div class="form-row">
          <div class="form-group">
            <label for="chargevoltage"><span class="tip" data-tip="Target voltage the inverter will charge to. Sent to inverter via CAN as the maximum battery voltage.">Charge Voltage (V):</span></label>
            <input type="number" id="chargevoltage" min="0" max="65" step="0.1" onchange="EnqueueUpdate('chargevoltage')" onkeypress="HandleEnter(event, 'chargevoltage')">
            <div class="field-error" id="err_chargevoltage"></div>
          </div>
          <div class="form-group">
            <label for="dischargevoltage"><span class="tip" data-tip="Minimum voltage before discharge is disabled to protect the battery.">Discharge Voltage (V):</span></label>
            <input type="number" id="dischargevoltage" min="0" max="65" step="0.1" onchange="EnqueueUpdate('dischargevoltage')" onkeypress="HandleEnter(event, 'dischargevoltage')">
            <div class="field-error" id="err_dischargevoltage"></div>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label for="overvoltage"><span class="tip" data-tip="Hard safety cutoff. Charging is immediately disabled if battery voltage reaches this level.">Battery Over Voltage (V):</span></label>
            <input type="number" id="overvoltage" min="0" max="65" step="0.1" onchange="EnqueueUpdate('overvoltage')" onkeypress="HandleEnter(event, 'overvoltage')">
            <div class="field-error" id="err_overvoltage"></div>
          </div>
        </div>
        
        <div class="section-title">Current Configuration</div>
        <div class="form-row">
          <div class="form-group">
            <label for="maxchargecurrent"><span class="tip" data-tip="Maximum charge current sent to the inverter during bulk charging.">Max Charge (A):</span></label>
            <input type="number" id="maxchargecurrent" min="0" max="500" step="0.1" onchange="EnqueueUpdate('maxchargecurrent')" onkeypress="HandleEnter(event, 'maxchargecurrent')">
            <div class="field-error" id="err_maxchargecurrent"></div>
          </div>
          <div class="form-group">
            <label for="maxdischargecurrent"><span class="tip" data-tip="Maximum discharge current allowed. Sent to the inverter as the discharge limit.">Max Discharge (A):</span></label>
            <input type="number" id="maxdischargecurrent" min="0" max="500" step="0.1" onchange="EnqueueUpdate('maxdischargecurrent')" onkeypress="HandleEnter(event, 'maxdischargecurrent')">
          </div>
        </div>
        <div class="ctrl-note" id="ctrlRequestBox" hidden></div>
        
        <div class="form-row">
          <div class="form-group">
            <label for="adjuststep"><span class="tip" data-tip="Amount to increase or decrease the charge current each step during absorption phase to hold voltage steady.">Charge Adjust Step (A):</span></label>
            <input type="number" id="adjuststep" min="0" max="100" step="0.1" onchange="EnqueueUpdate('adjuststep')" onkeypress="HandleEnter(event, 'adjuststep')">
          </div>
          <div class="form-group">
            <label for="minchargecurr"><span class="tip" data-tip="Lowest charge current allowed during absorption. The adjust step won't reduce below this value. Do not set this too low: many inverters ignore a limit of a few hundred milliamps, and a limit at or near zero while the voltage target stays high leaves them no way to shed surplus power - some respond by discharging the battery. A few amps is a safer floor than a fraction of one.">Min Charge (A):</span></label>
            <input type="number" id="minchargecurr" min="0" max="100" step="0.1" onchange="EnqueueUpdate('minchargecurr')" onkeypress="HandleEnter(event, 'minchargecurr')">
            <div class="field-error" id="err_minchargecurr"></div>
          </div>
        </div>

        <div class="section-title">SOC Limits</div>
        <div class="form-row">
          <div class="form-group">
            <label for="lowsoclimit"><span class="tip" data-tip="Discharge is disabled when SOC drops to or below this percentage. Set 0 to disable.">Low SOC (Stop Discharge):</span></label>
            <input type="number" id="lowsoclimit" min="0" max="100" onchange="EnqueueUpdate('lowsoclimit')" onkeypress="HandleEnter(event, 'lowsoclimit')">
            <div class="field-error" id="err_lowsoclimit"></div>
          </div>
          <div class="form-group">
            <label for="highsoclimit"><span class="tip" data-tip="Charging is disabled when SOC reaches this percentage. Set 100 to disable.">High SOC (Stop Charge):</span></label>
            <input type="number" id="highsoclimit" min="0" max="100" onchange="EnqueueUpdate('highsoclimit')" onkeypress="HandleEnter(event, 'highsoclimit')">
            <div class="field-error" id="err_highsoclimit"></div>
          </div>
        </div>
        
        <div class="section-title">Slow Charge Configuration</div>
        <div class="form-row col4">
          <div class="form-group">
            <label for="slowchargesoc1"><span class="tip" data-tip="When SOC reaches this %, charge current is reduced to capacity / divider 1.">Slow Charge SOC 1:</span></label>
            <input type="number" id="slowchargesoc1" onchange="EnqueueUpdate('slowchargesoc1')" onkeypress="HandleEnter(event, 'slowchargesoc1')">
          </div>
          <div class="form-group">
            <label for="slowchargesoc1div"><span class="tip" data-tip="Capacity divider for slow charge 1. Charge current = capacity / this value. E.g. 100Ah / 2 = C/2 (50A).">Divider 1:</span></label>
            <input type="number" id="slowchargesoc1div" onchange="EnqueueUpdate('slowchargesoc1div')" onkeypress="HandleEnter(event, 'slowchargesoc1div')">
          </div>
          <div class="form-group">
            <label for="slowchargesoc2"><span class="tip" data-tip="Second slow charge threshold. When SOC reaches this %, charge current is reduced further using divider 2.">Slow Charge SOC 2:</span></label>
            <input type="number" id="slowchargesoc2" onchange="EnqueueUpdate('slowchargesoc2')" onkeypress="HandleEnter(event, 'slowchargesoc2')">
          </div>
          <div class="form-group">
            <label for="slowchargesoc2div"><span class="tip" data-tip="Capacity divider for slow charge 2. Charge current = capacity / this value.">Divider 2:</span></label>
            <input type="number" id="slowchargesoc2div" onchange="EnqueueUpdate('slowchargesoc2div')" onkeypress="HandleEnter(event, 'slowchargesoc2div')">
          </div>
        </div>

        <div class="section-title">CC-CV Charging Configuration</div>
        <div class="form-row">
          <div class="form-group">
            <label for="tailcurrent"><span class="tip" data-tip="During absorption, when charge current drops below this for the tail duration, the battery is considered full.">Tail Current (A):</span></label>
            <input type="number" id="tailcurrent" min="0" max="100" step="0.1" onchange="EnqueueUpdate('tailcurrent')" onkeypress="HandleEnter(event, 'tailcurrent')">
          </div>
          <div class="form-group">
            <label for="tailduration"><span class="tip" data-tip="How long current must stay below the tail threshold before absorption is considered complete.">Tail Duration (seconds):</span></label>
            <input type="number" id="tailduration" min="0" max="3600" onchange="EnqueueUpdate('tailduration')" onkeypress="HandleEnter(event, 'tailduration')">
          </div>
        </div>

        <div class="form-row col3">
          <div class="form-group">
            <label for="maxabsorptiontime"><span class="tip" data-tip="Safety timeout. Absorption phase ends after this many minutes even if tail current hasn't been reached.">Max Absorption Time (min):</span></label>
            <input type="number" id="maxabsorptiontime" min="0" max="1440" onchange="EnqueueUpdate('maxabsorptiontime')" onkeypress="HandleEnter(event, 'maxabsorptiontime')">
          </div>
          <div class="form-group">
            <label for="rechargesoc"><span class="tip" data-tip="After charge completes, a new bulk charge cycle starts when SOC drops below this percentage.">Recharge SOC (%):</span></label>
            <input type="number" id="rechargesoc" min="0" max="100" onchange="EnqueueUpdate('rechargesoc')" onkeypress="HandleEnter(event, 'rechargesoc')">
            <div class="field-error" id="err_rechargesoc"></div>
          </div>
          <div class="form-group">
            <label for="rechargevoltageoffset"><span class="tip" data-tip="Voltage drop from target that triggers a new bulk charge cycle. Also used to detect significant voltage drops during absorption.">Recharge V Offset (V):</span></label>
            <input type="number" id="rechargevoltageoffset" min="0" max="10" step="0.1" onchange="EnqueueUpdate('rechargevoltageoffset')" onkeypress="HandleEnter(event, 'rechargevoltageoffset')">
            <div class="field-error" id="err_rechargevoltageoffset"></div>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="floatvoltage"><span class="tip" data-tip="Voltage held after absorption finishes, instead of stopping the charge outright. Leave at 0 and it is worked out from the charge voltage (1.5% below, which suits LiFePO4, NMC and LTO alike). Setting it at or above the charge voltage turns the float stage off, and the cycle ends at Complete with a 0 A limit - some inverters answer that by discharging the pack or shutting down their PV.">Float Voltage (V):</span></label>
            <input type="number" id="floatvoltage" min="0" max="65" step="0.1" onchange="EnqueueUpdate('floatvoltage')" onkeypress="HandleEnter(event, 'floatvoltage')">
            <div class="field-note" id="note_floatvoltage"></div>
            <div class="field-error" id="err_floatvoltage"></div>
          </div>
          <div class="form-group">
            <label for="floatcurrent"><span class="tip" data-tip="Charge current allowance sent to the inverter during float. Never drops below Min Charge Current, since an allowance the inverter cannot act on rounds back to the 0 A that float exists to avoid.">Float Current (A):</span></label>
            <input type="number" id="floatcurrent" min="0" max="100" step="0.1" onchange="EnqueueUpdate('floatcurrent')" onkeypress="HandleEnter(event, 'floatcurrent')">
            <div class="field-error" id="err_floatcurrent"></div>
          </div>
        </div>

        <div class="section-title">Temperature Protection</div>
        <div class="form-row">
          <div class="checkbox-row">
            <input type="checkbox" id="tempprotection" onchange="SendJSONUpdate('tempprotection'); toggleTempConfig();">
            <label for="tempprotection"><span class="tip" data-tip="Enable temperature-based charge and discharge cutoffs using the shunt temperature sensor.">Temperature Protection Enabled</span></label>
          </div>
          <div class="checkbox-row">
            <input type="checkbox" id="showtempdashboard" onchange="SendJSONUpdate('showtempdashboard')">
            <label for="showtempdashboard">Show Temperature on Dashboard</label>
          </div>
        </div>
        <div id="tempConfigFields" style="display:none;">
          <div class="form-row">
            <div class="form-group">
              <label for="batttempsrc"><span class="tip" data-tip="Select where battery temperature data comes from. VE.Direct uses the shunt sensor, MQTT subscribes to an external topic.">Battery Temp Source:</span></label>
              <select id="batttempsrc" onchange="SendJSONUpdate('batttempsrc'); toggleMqttTempTopics();">
                <option value="0">VE.Direct</option>
                <option value="1">MQTT</option>
              </select>
            </div>
            <div class="form-group" id="mqttBattTopicGroup" style="display:none;">
              <label for="mqttbatttopic"><span class="tip" data-tip="External MQTT topic to subscribe to for battery temperature (e.g. solar_assistant/battery_1/temperature/state).">MQTT Battery Temp Topic:</span></label>
              <input type="text" id="mqttbatttopic" onchange="EnqueueUpdate('mqttbatttopic')" onkeypress="HandleEnter(event, 'mqttbatttopic')">
            </div>
          </div>
          <div class="form-row col4">
            <div class="form-group">
              <label for="chargehightemp"><span class="tip" data-tip="Charging is disabled above this temperature.">Chg High (&deg;C):</span></label>
              <input type="number" id="chargehightemp" min="-20" max="60" onchange="EnqueueUpdate('chargehightemp')" onkeypress="HandleEnter(event, 'chargehightemp')">
              <div class="field-error" id="err_chargehightemp"></div>
            </div>
            <div class="form-group">
              <label for="chargelowtemp"><span class="tip" data-tip="Charging is disabled below this temperature. Important for lithium batteries which should not charge below 0°C.">Chg Low (&deg;C):</span></label>
              <input type="number" id="chargelowtemp" min="-40" max="45" onchange="EnqueueUpdate('chargelowtemp')" onkeypress="HandleEnter(event, 'chargelowtemp')">
              <div class="field-error" id="err_chargelowtemp"></div>
            </div>
            <div class="form-group">
              <label for="dischargehightemp"><span class="tip" data-tip="Discharging is disabled above this temperature.">Dchg High (&deg;C):</span></label>
              <input type="number" id="dischargehightemp" min="-20" max="70" onchange="EnqueueUpdate('dischargehightemp')" onkeypress="HandleEnter(event, 'dischargehightemp')">
              <div class="field-error" id="err_dischargehightemp"></div>
            </div>
            <div class="form-group">
              <label for="dischargelowtemp"><span class="tip" data-tip="Discharging is disabled below this temperature.">Dchg Low (&deg;C):</span></label>
              <input type="number" id="dischargelowtemp" min="-40" max="45" onchange="EnqueueUpdate('dischargelowtemp')" onkeypress="HandleEnter(event, 'dischargelowtemp')">
              <div class="field-error" id="err_dischargelowtemp"></div>
            </div>
          </div>
        </div>

        <div class="section-title">Advanced Settings</div>
        <div class="form-row">
          <div class="checkbox-row">
            <input type="checkbox" id="autocharge" onchange="SendJSONUpdate('autocharge')">
            <label for="autocharge"><span class="tip" data-tip="Enable active current management during absorption phase. Steps charge current up/down to hold voltage at target.">Smart Adjust Enabled</span></label>
          </div>
          <div class="form-group">
            <label for="smartinterval"><span class="tip" data-tip="Seconds between each charge current adjustment during absorption. Higher = slower, smoother adjustments.">Smart Interval (seconds):</span></label>
            <input type="number" id="smartinterval" onchange="EnqueueUpdate('smartinterval')" onkeypress="HandleEnter(event, 'smartinterval')">
          </div>
        </div>
        
        <div class="button-group">
          <button class="btn-primary" onclick="saveAll()">Save to EEPROM</button>
          <button onclick="rebootBMS()">Reboot &amp; Apply</button>
        </div>
      </section>

      <!-- Schedule Tab -->
      <section id="schedule" class="tab-pane" role="tabpanel" aria-labelledby="tab-schedule">

        <div class="sched-noclock" id="schedNoClock" hidden>
          <span class="warning-icon">&#9888;</span>
          <div>
            <b>Scheduling is inactive until the clock is set.</b>
            Windows are stored, but nothing will run without a synced clock -
            the device would otherwise be working from the wrong date and time.
            Set an NTP server under <a href="#settings" onclick="switchTab('settings')">Settings</a>,
            then check Clock Sync on the Firmware tab.
          </div>
        </div>

        <div class="sched-status" id="schedStatus">
          <span class="sched-dot" id="schedDot"></span>
          <span>
            <span id="schedStatusText">No schedule active</span>
            <span class="sched-next" id="schedNextText"></span>
          </span>
        </div>

        <div class="sched-status sched-override" id="schedOverride" hidden>
          <span class="sched-dot"></span>
          <span>
            <span id="schedOverrideText"></span>
            <span class="sched-next" id="schedOverrideNext"></span>
          </span>
          <button class="sched-ovr-clear" onclick="clearOverride()">Return to Schedule</button>
        </div>

        <div class="section-title">Repeating Windows</div>
        <p class="sched-help">
          Saved on the device and used whenever no Home Assistant schedule is active.
          Times are in 5 minute steps and use the timezone set under Settings.
        </p>

        <div class="sched-table" id="schedRows"></div>

        <div class="button-group">
          <button id="schedAdd" onclick="addScheduleRow()">Add Window</button>
          <button class="btn-primary" onclick="saveSchedule()">Save Schedule</button>
          <span id="schedCount" class="sched-count"></span>
        </div>

        <div class="section-title">From Home Assistant</div>
        <p class="sched-help">
          Pushed over MQTT to <span class="sched-topic" id="schedTopic">&lt;topic&gt;/set/Schedule</span>,
          held in memory only and never written to flash. These take priority over the
          repeating windows above, and expire on their own once their end time passes.
        </p>
        <div class="sched-mqtt" id="schedMqttList"></div>

        <div class="section-title">Outside Control</div>
        <p class="sched-help">
          Charge, discharge and force charge can also be driven from outside the schedule - the
          Dashboard toggles, Home Assistant over MQTT, or a supervisor such as PowerPilot on the
          WebSocket. Whatever does so takes that one lever off the schedule for the timeout below,
          then control reverts on its own. The timeout is the safety net: a controller that crashes
          or drops off the network cannot leave the battery sitting on its last command.
        </p>
        <div class="form-row">
          <div class="form-group">
            <label for="overridetimeout"><span class="tip" data-tip="Seconds an outside command holds a lever off the schedule. A supervisor should re-send well inside this. 0 disables the hold entirely, so the schedule always wins.">Override Timeout (s):</span></label>
            <input type="number" id="overridetimeout" min="0" max="3600" onchange="EnqueueUpdate('overridetimeout')" onkeypress="HandleEnter(event, 'overridetimeout')">
          </div>
          <div class="form-group">
            <label for="requesttimeout"><span class="tip" data-tip="Seconds a charge or discharge current request from an outside controller stays in force. When it lapses the configured Max Charge and Max Discharge return. This one cannot be disabled: a request that never expires could leave the battery pinned at 0 A after the controller stopped.">Current Request Timeout (s):</span></label>
            <input type="number" id="requesttimeout" min="30" max="3600" onchange="EnqueueUpdate('requesttimeout')" onkeypress="HandleEnter(event, 'requesttimeout')">
          </div>
        </div>
      </section>

      <!-- Settings Tab -->
      <section id="settings" class="tab-pane" role="tabpanel" aria-labelledby="tab-settings">
        <div class="section-title">CAN Bus Configuration</div>
        <div class="form-row">
          <div class="checkbox-row">
            <input type="checkbox" id="canbusenabled" onchange="SendJSONUpdate('canbusenabled')">
            <label for="canbusenabled"><span class="tip" data-tip="Enable CAN bus communication with the inverter. Disable if no inverter is connected.">CAN Bus Enabled</span></label>
          </div>
          <div class="form-group">
            <label for="canprotocol"><span class="tip" data-tip="Select the CAN protocol for your inverter. Pylontech 1.2 sends 0x359/0x35C request flags (most compatible). Pylontech 1.3 sends 0x35A/0x35F per official spec, plus 0x35C if Request Flags is enabled. SMA uses different voltage scaling. Victron adds alarm messages. Growatt/SolArk uses Pylontech 1.2 format.">Inverter Protocol:</span></label>
            <select id="canprotocol" onchange="SendJSONUpdate('canprotocol')">
              <option value="0">Pylontech 1.2</option>
              <option value="1">Pylontech 1.3</option>
              <option value="2">SMA</option>
              <option value="3">Victron</option>
              <option value="4">Growatt / SolArk</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          {{CAN_CONFIG_FIELDS}}
        </div>

        <div class="section-title">Victron Configuration</div>
        <div class="form-row">
          <div class="form-group">
            <label for="shuntsource"><span class="tip" data-tip="Where battery voltage, current and SOC come from. Prefer Serial reads the shunt over the wired VE.Direct link. Prefer BLE listens to the shunt's Bluetooth broadcasts instead, with no wire at all. Takes effect after a reboot, because Bluetooth is only started when BLE is preferred. The device address and encryption key are set on the WiFi/BLE/MQTT tab.">Shunt Source:</span></label>
            <select id="shuntsource" onchange="SendJSONUpdate('shuntsource'); toggleBleConfig()">
              <option value="0">Prefer Serial (VE.Direct)</option>
              <option value="1">Prefer BLE (Bluetooth)</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="checkbox-row">
            <input type="checkbox" id="blefallback" onchange="SendJSONUpdate('blefallback'); toggleBleConfig()">
            <label for="blefallback"><span class="tip" data-tip="Only applies when BLE is preferred. If no BLE advert decodes for 15 seconds, use the VE.Direct serial input until it comes back - for a shunt at the edge of Bluetooth range where the wire is still connected. Both switches are written to the log, so a source change is never silent. Leave off if nothing is wired to the VE.Direct pins.">Allow fallback to the other source when the preferred one goes quiet</span></label>
          </div>
        </div>
        <div class="form-row">
          <div id="bleSetupHint" class="field-error"></div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="victronrxpin"><span class="tip" data-tip="GPIO pin connected to the Victron shunt TX line (VE.Direct data in). Required - this is the only VE.Direct connection the BMS needs.">Victron RX Pin:</span></label>
            <input type="number" id="victronrxpin" onchange="EnqueueUpdate('victronrxpin')" onkeypress="HandleEnter(event, 'victronrxpin')">
          </div>
          <div class="form-group">
            <label for="victrontxpin"><span class="tip" data-tip="Optional. GPIO pin connected to the Victron shunt RX line. Nothing is ever sent to the shunt (passive listen only), so leave this blank unless you have a reason to wire it. Clearing it frees the pin.">Victron TX Pin (optional):</span></label>
            <input type="number" id="victrontxpin" placeholder="Not used" onchange="EnqueueUpdate('victrontxpin')" onkeypress="HandleEnter(event, 'victrontxpin')">
          </div>
        </div>
        
        <div class="section-title">Inverter Tricks</div>
        <div class="form-row">
          <div class="checkbox-row">
            <input type="checkbox" id="soctrickenabled" onchange="SendJSONUpdate('soctrickenabled')">
            <label for="soctrickenabled"><span class="tip" data-tip="When force charge is active, reports SOC as 1/10 actual value to the inverter. Makes the inverter charge harder.">SOC Trick Enable (1/10 SOC)</span></label>
          </div>
          <div class="checkbox-row">
            <input type="checkbox" id="requestflagsenabled" onchange="SendJSONUpdate('requestflagsenabled')">
            <label for="requestflagsenabled"><span class="tip" data-tip="Send charge/discharge enable and force charge flags in the 0x35C CAN message. Required for some inverters. On Pylontech 1.3 this also adds 0x35C to the messages sent, since the 1.3 spec drops it.">Request Flags (0x35C Status)</span></label>
          </div>
        </div>
        <div class="form-row">
          <div class="checkbox-row">
            <input type="checkbox" id="never100soc" onchange="SendJSONUpdate('never100soc')">
            <label for="never100soc"><span class="tip" data-tip="Some inverters shut down solar export when 100% SOC is received. Enable this to always send 99% max over CAN bus. Internal SOC tracking and charge control still uses the real value.">Never Send 100% SOC</span></label>
          </div>
          <div class="checkbox-row">
            <input type="checkbox" id="requestfullcharge" onchange="toggleRequestFullCharge(this.checked)">
            <label for="requestfullcharge"><span class="tip" data-tip="Asks the inverter to take its next charge all the way to 100% instead of stopping at its own SOC limit, so the pack can rebalance and reset SOC. This does not start a charge - use force charge for that. Not saved: it clears on reboot. Needs Request Flags enabled.">Request Full Charge</span></label>
          </div>
        </div>
        
        <div class="section-title">Fan Control</div>
        <div class="form-row">
          {{FAN_PIN_FIELD}}
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="fantempsrc"><span class="tip" data-tip="Select fan control mode. Disabled uses current-based control. MQTT Inverter Temp uses linear temperature control from an external MQTT topic.">Fan Temp Source:</span></label>
            <select id="fantempsrc" onchange="SendJSONUpdate('fantempsrc'); toggleMqttTempTopics();">
              <option value="0">Disabled</option>
              <option value="1">MQTT Inverter Temp</option>
            </select>
          </div>
          <div class="form-group" id="mqttInvTopicGroup" style="display:none;">
            <label for="mqttinvtopic"><span class="tip" data-tip="External MQTT topic to subscribe to for inverter temperature (e.g. solar_assistant/inverter_1/device_temperature/state).">MQTT Inverter Temp Topic:</span></label>
            <input type="text" id="mqttinvtopic" onchange="EnqueueUpdate('mqttinvtopic')" onkeypress="HandleEnter(event, 'mqttinvtopic')">
          </div>
        </div>
        <div class="form-row" id="fanTempSettingsGroup" style="display:none;">
          <div class="form-group">
            <label for="fanofftemp"><span class="tip" data-tip="Temperature below which the fan turns off completely.">Fan Off Temperature (&deg;C):</span></label>
            <input type="number" id="fanofftemp" min="0" max="80" onchange="EnqueueUpdate('fanofftemp')" onkeypress="HandleEnter(event, 'fanofftemp')">
            <div class="field-error" id="err_fanofftemp"></div>
          </div>
          <div class="form-group">
            <label for="fanfulltemp"><span class="tip" data-tip="Temperature at which the fan runs at full speed. Linear ramp between off and full.">Fan Full Speed Temperature (&deg;C):</span></label>
            <input type="number" id="fanfulltemp" min="0" max="80" onchange="EnqueueUpdate('fanfulltemp')" onkeypress="HandleEnter(event, 'fanfulltemp')">
            <div class="field-error" id="err_fanfulltemp"></div>
          </div>
        </div>

        <div class="section-title">Other Settings</div>
        <div class="checkbox-row">
          <input type="checkbox" id="lcdenabled" onchange="SendJSONUpdate('lcdenabled')">
          <label for="lcdenabled"><span class="tip" data-tip="Enable the I2C LCD display for showing battery status on the device.">LCD Enabled</span></label>
        </div>
        
        <div class="section-title">Network Configuration</div>
        <div class="form-row">
          <div class="form-group">
            <label for="ntpserver"><span class="tip" data-tip="Time server for clock sync, used for log and syslog timestamps. One address, or two separated by a comma. Leave blank to use only the server offered by DHCP.">NTP Server:</span></label>
            <input type="textbox" id="ntpserver" placeholder="0.uk.pool.ntp.org" onchange="EnqueueUpdate('ntpserver')" onkeypress="HandleEnter(event, 'ntpserver')">
            <div class="checkbox-row">
              <input type="checkbox" id="ntpfromdhcp" onchange="SendJSONUpdate('ntpfromdhcp')">
              <label for="ntpfromdhcp"><span class="tip" data-tip="Use the time server your router hands out with the DHCP lease (option 42). Tried first, with anything typed above as the fallback, so a device with nothing configured still gets a clock. Takes effect after a reboot.">Get NTP server from DHCP</span></label>
            </div>
          </div>
          <div class="form-group">
            <label for="tzpreset"><span class="tip" data-tip="Sets the local time used for log and syslog timestamps. Daylight saving is handled automatically. Pick a region, or choose Custom and enter your own POSIX TZ string.">Timezone:</span></label>
            <select id="tzpreset" onchange="applyTzPreset()">
              <option value="GMT0BST,M3.5.0/1,M10.5.0">United Kingdom (GMT/BST)</option>
              <option value="UTC0">UTC (no daylight saving)</option>
              <option value="GMT0IST,M3.5.0/1,M10.5.0">Ireland (GMT/IST)</option>
              <option value="WET0WEST,M3.5.0/1,M10.5.0">Portugal (WET/WEST)</option>
              <option value="CET-1CEST,M3.5.0,M10.5.0/3">Central Europe (CET/CEST)</option>
              <option value="EET-2EEST,M3.5.0/3,M10.5.0/4">Eastern Europe (EET/EEST)</option>
              <option value="EST5EDT,M3.2.0,M11.1.0">US Eastern</option>
              <option value="CST6CDT,M3.2.0,M11.1.0">US Central</option>
              <option value="MST7MDT,M3.2.0,M11.1.0">US Mountain</option>
              <option value="PST8PDT,M3.2.0,M11.1.0">US Pacific</option>
              <option value="AEST-10AEDT,M10.1.0,M4.1.0/3">Australia (Sydney)</option>
              <option value="NZST-12NZDT,M9.5.0,M4.1.0/3">New Zealand</option>
              <option value="SAST-2">South Africa</option>
              <option value="__custom__">Custom…</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="timezone"><span class="tip" data-tip="The POSIX TZ string actually stored on the device. Set automatically by the dropdown above, or type your own.">TZ String:</span></label>
          <input type="textbox" id="timezone" onchange="EnqueueUpdate('timezone'); syncTzPreset();" onkeypress="HandleEnter(event, 'timezone')">
          <div class="field-error" id="err_timezone"></div>
        </div>

        <div class="section-title">Remote Logging (Syslog)</div>
        <div class="checkbox-row">
          <input type="checkbox" id="syslogenabled" onchange="SendJSONUpdate('syslogenabled')">
          <label for="syslogenabled"><span class="tip" data-tip="Forward the same log lines shown on the Logs tab to a syslog collector over UDP. Applies immediately, no reboot needed.">Send logs to a syslog server</span></label>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="syslogserver"><span class="tip" data-tip="IP address of your syslog collector, e.g. 192.168.1.10. Must be an IP address - hostnames are not resolved, to keep logging off the DNS path.">Syslog Server IP:</span></label>
            <input type="textbox" id="syslogserver" placeholder="192.168.1.10" onchange="EnqueueUpdate('syslogserver')" onkeypress="HandleEnter(event, 'syslogserver')">
            <div class="field-error" id="err_syslogserver"></div>
          </div>
          <div class="form-group">
            <label for="syslogport"><span class="tip" data-tip="UDP port of the syslog collector. The standard port is 514.">Syslog Port:</span></label>
            <input type="number" id="syslogport" min="1" max="65535" onchange="EnqueueUpdate('syslogport')" onkeypress="HandleEnter(event, 'syslogport')">
          </div>
        </div>
        
        <div class="section-title">Backup & Restore</div>
        <div class="button-group">
          <button onclick="exportSettings()">Export Settings</button>
          <button onclick="document.getElementById('importFile').click()">Import Settings</button>
          <input type="file" id="importFile" accept=".json" style="display:none" onchange="importSettings(this)">
        </div>

        <div class="button-group">
          <button onclick="rebootBMS()">Reboot &amp; Apply</button>
        </div>

        <!-- Destructive actions live behind a disclosure and a typed confirmation,
             so a factory reset can't be a mis-click away from Save. -->
        <details class="danger-zone">
          <summary>Danger Zone</summary>
          <div class="danger-body">
            <p>These actions erase stored configuration and cannot be undone. You will
               need to reconfigure the device afterwards.</p>
            <div class="button-group" style="margin-top:0">
              <button class="btn-danger" onclick="eraseAll()">Factory Reset</button>
              <button class="btn-danger" onclick="erasekeepwifi()">Factory Reset, Keep WiFi</button>
            </div>
          </div>
        </details>
      </section>

      <!-- WiFi/MQTT Tab -->
      <section id="wifimqtt" class="tab-pane" role="tabpanel" aria-labelledby="tab-wifimqtt">
        <div class="section-title">WiFi Configuration</div>
        <div class="form-group">
          <label for="wifissid">WiFi Network:</label>
          <div class="wifi-controls">
            <select id="wifissid"></select>
            <button onclick="GetWifiList()">Scan</button>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label for="wifipass">WiFi Password:</label>
            <div class="password-wrapper">
              <input type="password" id="wifipass" onkeypress="HandleEnter(event, 'SaveWifiConfig')">
              <button type="button" class="password-toggle" onclick="togglePassword('wifipass')">Show</button>
            </div>
          </div>
          <div class="form-group">
            <label for="wifihostname"><span class="tip" data-tip="Local network name for this device. Access the web UI at http://hostname.local">mDNS Hostname:</span></label>
            <input type="textbox" id="wifihostname" onkeypress="HandleEnter(event, 'SaveWifiConfig')">
          </div>
        </div>
        
        <div class="form-group">
          <button onclick="SaveWifiConfig()" class="save-btn">Save WiFi Configuration</button>
        </div>

        <div class="section-title">Victron BLE Shunt</div>
        <!-- Always shown, so the shunt can be paired and tested before BLE is
             made the preferred source over in Settings > Victron Configuration.
             bleSourceHint says which way that preference is currently set. -->
        <div class="form-row">
          <div id="bleSourceHint" class="field-error"></div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label><span class="tip" data-tip="Listens for nearby Victron devices for 8 seconds. The advert header is not encrypted, so devices are found before any key is entered.">Find your shunt:</span></label>
            <button id="bleScanBtn" onclick="startBleScan()">Scan for Victron devices</button>
            <div id="bleScanStatus" class="field-error"></div>
            <div id="bleFoundList"></div>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="blemac"><span class="tip" data-tip="Bluetooth address of your SmartShunt. Filled in by the Scan button, or type it as aa:bb:cc:dd:ee:ff.">Device Address:</span></label>
            <input type="textbox" id="blemac" placeholder="aa:bb:cc:dd:ee:ff" onchange="EnqueueUpdate('blemac')" onkeypress="HandleEnter(event, 'blemac')">
          </div>
          <div class="form-group">
            <label for="blekey"><span class="tip" data-tip="32 hex characters, from VictronConnect: connect to the shunt, then Settings > Product info > Instant readout via Bluetooth > Show. This is the only thing protecting the shunt's broadcasts, so it is stored but never sent back to the browser.">Encryption Key:</span></label>
            <div class="password-wrap">
              <input type="password" id="blekey" placeholder="32 hex characters" onchange="EnqueueUpdate('blekey')" onkeypress="HandleEnter(event, 'blekey')">
              <button class="password-toggle" onclick="togglePassword('blekey')">Show</button>
            </div>
            <div id="bleKeyState" class="field-error"></div>
          </div>
        </div>

        <div class="stat-grid">
          <div class="stat-box stat-status">
            <div class="stat-label">BLE Status</div>
            <div class="stat-value sm" id="bleStatus">--</div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Adverts Decoded</div>
            <div class="stat-value sm" id="bleAdverts">--</div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Rejected</div>
            <div class="stat-value sm" id="bleFailures">--</div>
          </div>
        </div>

        <div class="section-title">MQTT Server Configuration</div>
        <div class="form-row">
          <div class="form-group">
            <label for="mqttserverip">MQTT Server IP:</label>
            <input type="textbox" id="mqttserverip" onchange="EnqueueUpdate('mqttserverip')" onkeypress="HandleEnter(event, 'mqttserverip')">
          </div>
          <div class="form-group">
            <label for="mqttport">MQTT Port:</label>
            <input type="number" id="mqttport" onchange="EnqueueUpdate('mqttport')" onkeypress="HandleEnter(event, 'mqttport')">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label for="mqttclientid"><span class="tip" data-tip="Unique client name for this device on the MQTT broker. Must be different from other devices.">MQTT Client ID:</span></label>
            <input type="textbox" id="mqttclientid" onchange="EnqueueUpdate('mqttclientid')" onkeypress="HandleEnter(event, 'mqttclientid')">
          </div>
          <div class="form-group">
            <label for="mqtttopic"><span class="tip" data-tip="Base MQTT topic for publishing data. E.g. 'diybms' publishes to diybms/V, diybms/SOC, etc.">MQTT Topic:</span></label>
            <input type="textbox" id="mqtttopic" onchange="EnqueueUpdate('mqtttopic')" onkeypress="HandleEnter(event, 'mqtttopic')">
          </div>
        </div>
        
        <div class="section-title">MQTT Authentication (Optional)</div>
        <div class="form-row">
          <div class="form-group">
            <label for="mqttuser">MQTT Username:</label>
            <input type="textbox" id="mqttuser" onchange="EnqueueUpdate('mqttuser')" onkeypress="HandleEnter(event, 'mqttuser')">
          </div>
          <div class="form-group">
            <label for="mqttpass">MQTT Password:</label>
            <div class="password-wrapper">
              <input type="password" id="mqttpass" onchange="EnqueueUpdate('mqttpass')" onkeypress="HandleEnter(event, 'mqttpass')">
              <button type="button" class="password-toggle" onclick="togglePassword('mqttpass')">Show</button>
            </div>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label for="velooptime"><span class="tip" data-tip="How often battery data is published to MQTT and the web UI is refreshed.">MQTT Refresh Rate (seconds):</span></label>
            <input type="number" id="velooptime" onchange="EnqueueUpdate('velooptime')" onkeypress="HandleEnter(event, 'velooptime')">
          </div>
        </div>
        
        <div class="button-group">
          <button onclick="rebootBMS()">Reboot &amp; Apply</button>
        </div>
      </section>

      <!-- Logs Tab -->
      <section id="logs" class="tab-pane" role="tabpanel" aria-labelledby="tab-logs">
        <div class="pane-title">System Logs</div>
        <div class="log-controls">
          <label for="loglevel">Level</label>
          <select id="loglevel" onchange="applyLogFilter()">
            <option value="all">All</option>
            <option value="info">Info &amp; above</option>
            <option value="warning">Warnings &amp; above</option>
            <option value="error">Errors only</option>
            <option value="can">CAN frames only</option>
            <option value="ble">BLE adverts only</option>
          </select>
          <label><input type="checkbox" id="autoscroll" checked> Auto-scroll</label>
          <label><input type="checkbox" id="logpause"> Pause</label>
          <label><input type="checkbox" id="cansniffer" onchange="SendJSONUpdate('cansniffer'); syncSnifferFilter()"><span class="tip" data-tip="Log every CAN frame received, with its data bytes, so you can see what another BMS puts on the bus. While this is on the device sends NOTHING to the inverter, so it can be clipped onto someone else's BMS-to-inverter bus without the two fighting over the same message IDs - but do not leave it on for your own inverter. Turns itself off after 30 minutes, and a reboot always clears it. Repeated identical frames are logged once, then every 30s.">CAN sniffer</span></label>
          <label><input type="checkbox" id="blesniffer" onchange="SendJSONUpdate('blesniffer'); syncSnifferFilter('ble')"><span class="tip" data-tip="Log every Victron BLE advertisement seen nearby, with its raw bytes. The advert header is not encrypted, so this works before any key is entered - use it to confirm a shunt is in range and being decoded correctly. Starts Bluetooth if it is not already running. Runtime only: a reboot clears it.">BLE sniffer</span></label>
          <span class="log-spacer"></span>
          <button onclick="copyLogs()">Copy</button>
          <button onclick="downloadLogs()">Download</button>
          <button onclick="clearLogs()">Clear</button>
        </div>
        <div class="log-viewer" id="logviewer"></div>
      </section>

      <!-- Firmware Tab -->
      <section id="firmware" class="tab-pane" role="tabpanel" aria-labelledby="tab-firmware">
        <div class="section-title">DIY Battery BMS</div>
        <div class="stat-grid">
          <div class="stat-box stat-status">
            <div class="stat-label">Version</div>
            <div class="stat-value sm" id="fwVersionBms">--</div>
          </div>
          <!-- What the website has for this exact board, filled in by the
               browser rather than the device. Stays "--" when there is no route
               out, which is a truthful answer: this board does not know. -->
          <div class="stat-box stat-status">
            <div class="stat-label">Downloadable Version</div>
            <div class="stat-value sm" id="fwDownloadable">--</div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Build Target</div>
            <div class="stat-value sm" id="fwBuild">--</div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">App Partition</div>
            <div class="stat-value sm" id="fwPartition">--</div>
          </div>
        </div>

        <div id="partitionWarn" class="status-warnings error" hidden>
          <div class="warning-box">
            <span class="warning-icon">&#9888;</span>
            <div class="warning-list">
              <div>Running the pre-3.0 partition table<span class="why"> — this device was updated over the air, which cannot replace the partition table itself</span></div>
              <div>Over-the-air updates will fail once the firmware outgrows the old 1.25MB slot<span class="why"> — re-flash over USB with bootloader.bin, partitions.bin and firmware.bin to move across. Your settings are held in NVS, which the new layout leaves exactly where it was, so they are kept.</span></div>
            </div>
          </div>
        </div>
        <div class="form-group">
          <!-- Where to get the file, next to the box that wants one. The device
               cannot fetch its own firmware - TLS plus a 1.7MB image needs more
               internal heap than a board without PSRAM has - but it knows
               exactly which of the builds it is, so it hands that to the site
               and the site hands back the one right file. -->
          <div id="fwDownloadRow" class="fw-download" hidden>
            <a id="fwDownloadLink" href="#" target="_blank" rel="noopener">Get the latest firmware for this board</a>
            <span class="fw-download-note" id="fwDownloadNote">opens diy.power-pilot.uk, then choose the downloaded file below</span>
          </div>
          <label for="firmwareFile">Firmware image (.bin or .bin.gz)</label>
          <input type="file" accept=".bin,.bin.gz" id="firmwareFile" style="margin-bottom:10px">
          <button id="firmwareBtn" class="btn-primary" onclick="uploadFirmware()">Update Firmware</button>
          <div id="fwProgress" hidden style="margin-top:12px">
            <div class="progress-track">
              <div id="fwProgressBar" class="progress-bar">0%</div>
            </div>
          </div>
        </div>

        <div class="section-title">Victron Smart Shunt</div>
        <div class="stat-grid">
          <div class="stat-box stat-status">
            <div class="stat-label">Model</div>
            <div class="stat-value sm" id="devModel">--</div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Firmware</div>
            <div class="stat-value sm" id="devFW">--</div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Serial Number</div>
            <div class="stat-value sm" id="devSerial">--</div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Product ID</div>
            <div class="stat-value sm" id="devPID">--</div>
          </div>
        </div>

        <div class="section-title">ESP32 Diagnostics</div>
        <div class="stat-grid">
          <div class="stat-box stat-status">
            <div class="stat-label">Uptime</div>
            <div class="stat-value sm" id="uptimeInfo">--</div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Heap Free / Total</div>
            <div class="stat-value sm" id="heapInfo">--</div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">CAN Failures</div>
            <div class="stat-value sm" id="canFailInfo">0</div>
          </div>
          <div class="stat-box stat-status">
            <div class="stat-label">Clock Sync</div>
            <div class="stat-value sm" id="ntpSyncInfo">--</div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <!-- Replaces native confirm()/alert(): non-blocking, themed, and able to require
       a typed phrase for irreversible actions. -->
  <div class="modal-backdrop" id="modalBackdrop" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal">
      <h3 id="modalTitle">Confirm</h3>
      <p id="modalBody"></p>
      <div id="modalConfirmWrap" hidden>
        <label for="modalConfirmInput">Type <b id="modalPhrase">ERASE</b> to continue</label>
        <input type="text" id="modalConfirmInput" autocomplete="off" spellcheck="false">
      </div>
      <div class="modal-actions">
        <button id="modalCancel" onclick="closeModal(false)">Cancel</button>
        <button id="modalOk" class="btn-primary" onclick="closeModal(true)">Confirm</button>
      </div>
    </div>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script>
    var gateway = `ws://${window.location.hostname}/ws`; 
    var websocket;
    const PIN_FIELDS = ['victronrxpin','victrontxpin','can_rx_pin','can_tx_pin','can_en_pin','canbuscspin','fanpin','onewirepin'];
    // Pins that are allowed to be unset. These show blank rather than 0, and send 0
    // when cleared so the firmware unassigns the pin instead of ignoring the update.
    const OPTIONAL_PIN_FIELDS = ['victrontxpin'];
    /* Sent to the device but never written to NVS, so they must not raise the
       unsaved-changes bar - there is nothing to save. Controls on the Logs tab
       are covered separately by where they sit, not by name. */
    const TRANSIENT_FIELDS = ['manualallowcharge','manualallowdischarge'];
    // Fields displayed in human units (V/A/Ah) but stored internally in mV/mA - multiply by 1000
    // on send, divide by 1000 on receive. Backend storage format is unchanged.
    const UNIT_CONVERT_FIELDS = {
      'chargevoltage': 1000, 'dischargevoltage': 1000, 'overvoltage': 1000,
      'maxchargecurrent': 1000, 'maxdischargecurrent': 1000,
      'minchargecurr': 1000, 'adjuststep': 1000, 'batterycapacity': 1000,
      'tailcurrent': 1000, 'rechargevoltageoffset': 1000,
      'floatvoltage': 1000, 'floatcurrent': 1000
    };
    const UNIT_DECIMALS = 1;

    // Populate a field from a server value, scaling to display units where required
    function SetFieldValue(fieldId, rawValue) {
      const el = document.getElementById(fieldId);
      if (!el) return;
      if (OPTIONAL_PIN_FIELDS.includes(fieldId) && Number(rawValue) === 0) {
        el.value = '';   // unassigned, show the "Not used" placeholder
        AckUpdate(fieldId);
        return;
      }
      const scale = UNIT_CONVERT_FIELDS[fieldId];
      el.value = scale ? (rawValue / scale).toFixed(UNIT_DECIMALS) : rawValue;
      AckUpdate(fieldId);
    }
    
    // Toggle password visibility
    function togglePassword(fieldId) {
      const input = document.getElementById(fieldId);
      const button = input.parentElement.querySelector('.password-toggle');
      if (input.type === 'password') {
        input.type = 'text';
        button.textContent = 'Hide';
      } else {
        input.type = 'password';
        button.textContent = 'Show';
      }
    }
    
    // Queue and debounce system
    const DEBOUNCE_DELAY = 400;
    const ACK_TIMEOUT = 5000;
    const MAX_RETRIES = 3;
    const sendQueue = [];
    const debounceTimers = {};
    const pendingAcks = {};
    let toastTimer = null;
    let savedWifiSSID = '';  // Currently saved WiFi SSID, as hex - see below

    /* An SSID is raw octets in whatever encoding the router felt like, not text,
       so it travels as hex and the <option> value IS that hex. Only what the user
       reads is decoded. Anything that saves an SSID must send the hex back - a
       name that survived a trip through UTF-8 is not necessarily the same name. */
    function ssidHexToText(hex) {
      if (!hex) return '';
      const bytes = new Uint8Array(hex.length >> 1);
      for (let i = 0; i < bytes.length; i++) bytes[i] = parseInt(hex.substr(i * 2, 2), 16);
      // Not fatal: undecodable bytes become U+FFFD so the name is still readable
      return new TextDecoder('utf-8').decode(bytes);
    }
    function ssidTextToHex(text) {
      if (!text) return '';
      let out = '';
      for (const b of new TextEncoder().encode(text)) out += b.toString(16).padStart(2, '0');
      return out;
    }

    window.addEventListener('load', onLoad);

    const TAB_IDS = ['home','bms','schedule','settings','wifimqtt','logs','firmware'];

    function switchTab(tabName, skipHash) {
      if (TAB_IDS.indexOf(tabName) < 0) tabName = 'home';

      document.querySelectorAll('.tab-pane').forEach(function(pane) {
        pane.classList.toggle('active', pane.id === tabName);
      });
      document.querySelectorAll('.tab-button').forEach(function(btn) {
        btn.setAttribute('aria-selected', btn.id === 'tab-' + tabName ? 'true' : 'false');
      });

      // Keep the tab in the URL so a refresh or bookmark lands in the same place
      if (!skipHash && location.hash !== '#' + tabName) {
        history.replaceState(null, '', '#' + tabName);
      }

      // Once per connection, not once per visit to the tab - the backlog overlaps
      // whatever is already on screen, so re-requesting it just stacks duplicates.
      if (tabName === 'logs' && !logsRequested
          && websocket && websocket.readyState === WebSocket.OPEN) {
        logsRequested = true;
        websocket.send('GetLogs()');
      }
    }

    // Arrow-key navigation across the tablist, per the WAI-ARIA tabs pattern
    function initTabKeys() {
      const btns = TAB_IDS.map(function(t) { return document.getElementById('tab-' + t); });
      btns.forEach(function(btn, i) {
        if (!btn) return;
        btn.addEventListener('keydown', function(e) {
          let next = -1;
          if (e.key === 'ArrowRight') next = (i + 1) % btns.length;
          else if (e.key === 'ArrowLeft') next = (i - 1 + btns.length) % btns.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = btns.length - 1;
          if (next >= 0) {
            e.preventDefault();
            btns[next].focus();
            switchTab(TAB_IDS[next]);
          }
        });
      });
    }

    /* ---------- Theme ---------- */
    // Cycles auto -> light -> dark. "auto" removes the attribute so the
    // prefers-color-scheme media query takes over again.
    const THEME_ICON = { auto: '◑', light: '☀', dark: '☾' };

    function applyTheme(mode) {
      if (mode === 'auto') document.documentElement.removeAttribute('data-theme');
      else document.documentElement.setAttribute('data-theme', mode);
      const btn = document.getElementById('themeBtn');
      if (btn) {
        btn.textContent = THEME_ICON[mode];
        btn.title = 'Theme: ' + mode + ' (click to change)';
      }
      try { localStorage.setItem('bmsTheme', mode); } catch (e) {}
    }

    function cycleTheme() {
      let cur = 'auto';
      try { cur = localStorage.getItem('bmsTheme') || 'auto'; } catch (e) {}
      applyTheme(cur === 'auto' ? 'light' : (cur === 'light' ? 'dark' : 'auto'));
    }

    function initTheme() {
      let saved = 'auto';
      try { saved = localStorage.getItem('bmsTheme') || 'auto'; } catch (e) {}
      applyTheme(saved);
    }

    /* ---------- Schedule editor ----------
       Rows live in the DOM and are only serialised on Save, so a half-typed row
       never reaches the device. Day masks match the SCHED_* bits in Schedule.h. */
    const SCHED_DAY_PRESETS = [
      { label: 'Every day', mask: 127 },
      { label: 'Weekdays',  mask: 62  },
      { label: 'Weekends',  mask: 65  },
      { label: 'Monday',    mask: 2   },
      { label: 'Tuesday',   mask: 4   },
      { label: 'Wednesday', mask: 8   },
      { label: 'Thursday',  mask: 16  },
      { label: 'Friday',    mask: 32  },
      { label: 'Saturday',  mask: 64  },
      { label: 'Sunday',    mask: 1   }
    ];

    function minsToHHMM(m) {
      m = Math.max(0, Math.min(1439, m | 0));
      return String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0');
    }

    function hhmmToMins(v) {
      const p = (v || '').split(':');
      if (p.length < 2) return 0;
      // Clamp to 5 minute steps, matching what the firmware stores
      return Math.floor((Number(p[0]) * 60 + Number(p[1])) / 5) * 5;
    }

    // -1 leave alone, 0 off, 1 on - mirrors SchedWindow in Schedule.h
    function triSelect(cls, value) {
      let h = '<select class="' + cls + '">';
      [['-1', 'Leave'], ['1', 'On'], ['0', 'Off']].forEach(function (o) {
        h += '<option value="' + o[0] + '"' + (String(value) === o[0] ? ' selected' : '') + '>' + o[1] + '</option>';
      });
      return h + '</select>';
    }

    function scheduleRowHtml(w) {
      const days = SCHED_DAY_PRESETS.map(function (d) {
        return '<option value="' + d.mask + '"' + (d.mask === w.days ? ' selected' : '') + '>' + d.label + '</option>';
      }).join('');
      return '<div class="f-start"><label>Start</label><input type="time" step="300" class="s-start" value="' + minsToHHMM(w.start) + '"></div>'
        + '<div class="f-end"><label>End</label><input type="time" step="300" class="s-end" value="' + minsToHHMM(w.end) + '"></div>'
        + '<div class="f-days"><label>Repeat</label><select class="s-days">' + days + '</select></div>'
        + '<div class="f-charge"><label>Charge</label>' + triSelect('s-charge', w.charge) + '</div>'
        + '<div class="f-discharge"><label>Discharge</label>' + triSelect('s-discharge', w.discharge) + '</div>'
        + '<div class="f-force"><label>Force</label>' + triSelect('s-force', w.force) + '</div>'
        + '<div class="f-soc"><label>Target %</label><input type="number" class="s-soc" min="0" max="100" value="' + (w.targetsoc || '') + '" placeholder="off"></div>'
        + '<button class="row-remove" title="Remove this window" aria-label="Remove window" onclick="this.parentElement.remove(); updateSchedCount();">&times;</button>';
    }

    /* Matches SCHED_MAX_UI in Schedule.h. The device keeps the first eight and
       drops the rest without a word - setUiFromJson() simply breaks out of its
       loop - so a ninth window could be filled in, saved, and quietly vanish.
       Stopping at the limit here is the difference between a rule and a
       disappearance. Keep the two in step if the firmware's limit changes. */
    const SCHED_MAX_UI = 8;

    function schedRowCount() {
      return document.querySelectorAll('#schedRows .sched-row').length;
    }

    function updateSchedCount() {
      const n = schedRowCount();
      const add = document.getElementById('schedAdd');
      const label = document.getElementById('schedCount');
      if (add) add.disabled = n >= SCHED_MAX_UI;
      if (label) {
        label.textContent = n + ' of ' + SCHED_MAX_UI + ' window' + (SCHED_MAX_UI === 1 ? '' : 's');
        label.classList.toggle('full', n >= SCHED_MAX_UI);
      }
    }

    function addScheduleRow(w) {
      if (!w || w.type === 'click') w = { start: 120, end: 300, days: 127, charge: -1, discharge: -1, force: 1, targetsoc: 0 };
      if (schedRowCount() >= SCHED_MAX_UI) {
        showToast('The device holds ' + SCHED_MAX_UI + ' repeating windows. Remove one to add another.', 'error', 4000);
        return;
      }
      const host = document.getElementById('schedRows');
      const empty = host.querySelector('.sched-empty');
      if (empty) empty.remove();
      const row = document.createElement('div');
      row.className = 'sched-row';
      row.innerHTML = scheduleRowHtml(w);
      host.appendChild(row);
      updateSchedCount();
    }

    function renderSchedule(list) {
      const host = document.getElementById('schedRows');
      if (!host) return;
      host.textContent = '';
      if (!list || list.length === 0) {
        const e = document.createElement('div');
        e.className = 'sched-empty';
        e.textContent = 'No repeating windows yet. Add one, or push a schedule from Home Assistant.';
        host.appendChild(e);
        updateSchedCount();
        return;
      }
      list.forEach(function (w) {
        addScheduleRow({
          start: w.start | 0, end: w.end | 0, days: w.days | 0,
          charge: w.charge === undefined ? -1 : (w.charge ? 1 : 0),
          discharge: w.discharge === undefined ? -1 : (w.discharge ? 1 : 0),
          force: w.forcecharge === undefined ? -1 : (w.forcecharge ? 1 : 0),
          targetsoc: w.targetsoc || 0
        });
      });
      updateSchedCount();
    }

    function saveSchedule() {
      const rows = Array.from(document.querySelectorAll('#schedRows .sched-row'));
      const out = [];
      for (const r of rows) {
        const start = hhmmToMins(r.querySelector('.s-start').value);
        const end = hhmmToMins(r.querySelector('.s-end').value);
        if (start === end) {
          showToast('A window needs different start and end times', 'error', 3500);
          return;
        }
        const w = { start: start, end: end, days: Number(r.querySelector('.s-days').value) };
        const c = r.querySelector('.s-charge').value;
        const d = r.querySelector('.s-discharge').value;
        const f = r.querySelector('.s-force').value;
        if (c !== '-1') w.charge = (c === '1');
        if (d !== '-1') w.discharge = (d === '1');
        if (f !== '-1') w.forcecharge = (f === '1');
        const soc = Number(r.querySelector('.s-soc').value);
        if (soc > 0) w.targetsoc = Math.min(100, soc);
        // A window that changes nothing would silently do nothing at all
        if (w.charge === undefined && w.discharge === undefined && w.forcecharge === undefined) {
          showToast('A window with everything set to Leave would do nothing', 'error', 3500);
          return;
        }
        out.push(w);
      }
      // Wait for the device to echo the stored schedule rather than claiming
      // success on send - the old toast timed out whether it saved or not.
      schedSavePending = out.length;
      websocket.send(JSON.stringify({ schedule: out }));
      showToast(out.length ? 'Saving ' + out.length + ' window(s)...' : 'Clearing schedule...', 'pending', 6000);
      if (schedSaveTimer) clearTimeout(schedSaveTimer);
      schedSaveTimer = setTimeout(function() {
        if (schedSavePending !== null) {
          schedSavePending = null;
          showToast('No confirmation from the device - schedule may not be saved', 'error', 5000);
        }
      }, 6000);
    }

    let schedSavePending = null;
    let schedSaveTimer = null;

    // Called when the device echoes back what it actually stored
    function confirmScheduleSaved(list) {
      if (schedSavePending === null) return;
      const n = list ? list.length : 0;
      if (schedSaveTimer) { clearTimeout(schedSaveTimer); schedSaveTimer = null; }
      if (n !== schedSavePending) {
        showToast('Device stored ' + n + ' of ' + schedSavePending + ' window(s)', 'error', 5000);
      } else {
        showToast(n ? 'Schedule saved - ' + n + ' window(s)' : 'Schedule cleared', 'success', 3000);
      }
      schedSavePending = null;
    }

    function renderSchedStatus() {
      const s = latestState;
      const box = document.getElementById('schedStatus');
      const txt = document.getElementById('schedStatusText');
      if (!box || !txt) return;

      /* Levers something outside has taken off the schedule, and how long is
         left before they come back on their own. Rendered ahead of the clock
         check below, because an override applies whether or not the clock is
         set - it is the schedule that needs the clock, not the override. */
      const ovrBox = document.getElementById('schedOverride');
      if (ovrBox) {
        const held = [];
        if (s.ovrcharge)    held.push('charge');
        if (s.ovrdischarge) held.push('discharge');
        if (s.ovrforce)     held.push('force charge');
        ovrBox.hidden = held.length === 0;
        if (held.length) {
          document.getElementById('schedOverrideText').textContent =
            'Held outside the schedule: ' + held.join(', ');
          document.getElementById('schedOverrideNext').textContent =
            s.ovrsecs > 0 ? 'Reverts to the schedule in ' + fmtDuration(s.ovrsecs) : '';
        }
      }

      // schedclock is false until NTP has actually synced. Windows still save,
      // but nothing runs, so say so plainly instead of looking silently broken.
      const clockOk = s.schedclock !== false;
      const warn = document.getElementById('schedNoClock');
      if (warn) warn.hidden = clockOk;
      if (!clockOk) {
        box.classList.remove('active');
        txt.textContent = 'Waiting for the clock - no window can run yet';
        return;
      }
      const active = !!s.schedactive;
      box.classList.toggle('active', active);
      if (active) {
        txt.textContent = s.schedsource === 'mqtt'
          ? 'Window active, pushed from Home Assistant'
          : 'Window active, from the repeating schedule below';
      } else if (s.schedmqttcount) {
        txt.textContent = s.schedmqttcount + ' Home Assistant window(s) queued, none active right now';
      } else {
        txt.textContent = 'No schedule active - charge on, discharge on, force off';
      }

      // Say when something will actually happen, so a saved schedule is visibly
      // going to do something rather than just sitting there.
      const nxt = document.getElementById('schedNextText');
      if (!nxt) return;
      const ends = s.schedendsin;
      const next = s.schednextin;
      if (active && ends > 0)      nxt.textContent = 'Ends in ' + fmtDuration(ends);
      else if (next > 0)           nxt.textContent = 'Next window starts in ' + fmtDuration(next);
      else if (s.scheduicount || s.schedmqttcount) nxt.textContent = 'Nothing else due';
      else                         nxt.textContent = 'No windows set';
    }

    // The device applies the configured timezone before sending epochs, so this
    // only formats - it does not shift anything.
    function fmtEpoch(e) {
      if (!e) return '--';
      return new Date(e * 1000).toLocaleString(undefined,
        { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function renderMqttWindows(list) {
      const host = document.getElementById('schedMqttList');
      if (!host) return;
      host.textContent = '';
      if (!list || list.length === 0) {
        const e = document.createElement('div');
        e.className = 'sched-empty';
        e.textContent = 'Nothing pushed from Home Assistant.';
        host.appendChild(e);
        return;
      }
      const now = Date.now() / 1000;
      list.forEach(function (w) {
        const row = document.createElement('div');
        row.className = 'sched-mqtt-row' + (now >= w.from && now < w.to ? ' now' : '');
        const when = document.createElement('span');
        when.className = 'when';
        when.textContent = fmtEpoch(w.from) + '  to  ' + fmtEpoch(w.to);
        const what = document.createElement('span');
        what.className = 'what';
        const bits = [];
        if (w.forcecharge !== undefined) bits.push('force ' + (w.forcecharge ? 'on' : 'off'));
        if (w.charge !== undefined) bits.push('charge ' + (w.charge ? 'on' : 'off'));
        if (w.discharge !== undefined) bits.push('discharge ' + (w.discharge ? 'on' : 'off'));
        if (w.targetsoc) bits.push('to ' + w.targetsoc + '%');
        what.textContent = bits.join(', ');
        row.appendChild(when);
        row.appendChild(what);
        host.appendChild(row);
      });
    }

    /* ---------- Timezone ----------
       The dropdown is a convenience over the TZ string; the string is what the
       device actually stores, so it stays visible and editable for anything the
       presets don't cover. */
    function applyTzPreset() {
      const sel = document.getElementById('tzpreset');
      const tz = document.getElementById('timezone');
      if (!sel || !tz) return;
      if (sel.value === '__custom__') { tz.focus(); return; }
      tz.value = sel.value;
      SendQueuedUpdate('timezone');
      validateFields();
    }

    // Point the dropdown at whichever preset matches the stored string, else Custom
    function syncTzPreset() {
      const sel = document.getElementById('tzpreset');
      const tz = document.getElementById('timezone');
      if (!sel || !tz) return;
      const match = Array.from(sel.options).some(function(o) {
        if (o.value === tz.value) { sel.value = o.value; return true; }
        return false;
      });
      if (!match) sel.value = '__custom__';
    }

    /* ---------- Tooltips ---------- */
    var tipPop = null;      // the shared bubble, created on first use
    var tipAnchor = null;   // .tip it currently describes, null while hidden
    var tipPinned = false;  // opened by tap/click rather than hover

    // Places the bubble in viewport coordinates and clamps it inside the screen.
    // Preferred position is above the label; it flips below when there isn't room.
    function positionTip(anchor) {
      const r = anchor.getBoundingClientRect();
      const M = 8;  // clearance from every viewport edge
      const w = tipPop.offsetWidth, h = tipPop.offsetHeight;

      let left = Math.min(r.left, window.innerWidth - w - M);
      if (left < M) left = M;

      let top = r.top - h - 6;
      if (top < M) {
        top = r.bottom + 6;
        if (top + h > window.innerHeight - M) top = Math.max(M, window.innerHeight - h - M);
      }

      tipPop.style.left = left + 'px';
      tipPop.style.top = top + 'px';
    }

    function showTip(anchor, pinned) {
      const text = anchor.getAttribute('data-tip');
      if (!text) return;
      if (!tipPop) {
        tipPop = document.createElement('div');
        tipPop.className = 'tip-pop';
        tipPop.setAttribute('role', 'tooltip');
        document.body.appendChild(tipPop);
      }
      tipPop.textContent = text;   // measured below, so set the text first
      tipPop.classList.add('show');
      tipAnchor = anchor;
      tipPinned = !!pinned;
      positionTip(anchor);
    }

    function hideTip() {
      if (!tipPop || !tipAnchor) return;
      tipPop.classList.remove('show');
      tipAnchor = null;
      tipPinned = false;
    }

    // Delegated so tooltips work on touch, where :hover never fires.
    function initTooltips() {
      document.addEventListener('click', function(e) {
        const tip = e.target.closest ? e.target.closest('.tip') : null;
        if (!tip) { hideTip(); return; }
        e.preventDefault();
        if (tipAnchor === tip && tipPinned) hideTip();
        else showTip(tip, true);
      });
      document.addEventListener('mouseover', function(e) {
        if (tipPinned) return;   // a tapped tooltip stays until dismissed
        const tip = e.target.closest ? e.target.closest('.tip') : null;
        if (tip === tipAnchor) return;   // still over the same label
        if (tip) showTip(tip, false);
        else if (tipAnchor) hideTip();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') hideTip();
      });
      // A fixed bubble does not travel with its anchor, so drop it on any movement.
      window.addEventListener('scroll', hideTip, true);
      window.addEventListener('resize', hideTip);
    }

    function SendJSONUpdate(fieldId) {
      SendQueuedUpdate(fieldId);
    }

    /* ---------- Victron BLE ---------- */
    /* The BLE fields live on the WiFi/BLE/MQTT tab and are always available -
       you need to pair a shunt before it is worth preferring. This only keeps
       the two tabs honest about which source is actually in use, so nobody
       enters a key, sees no adverts, and concludes the key is wrong. */
    function toggleBleConfig() {
      var src = document.getElementById('shuntsource');
      if (!src) return;
      var blePreferred = (src.value === '1');
      var fallback = document.getElementById('blefallback');
      var allowFallback = fallback && fallback.checked;

      var onTab = document.getElementById('bleSourceHint');
      if (onTab) {
        onTab.textContent = blePreferred
          ? 'BLE is the preferred shunt source.' +
            (allowFallback ? ' VE.Direct takes over if adverts stop for 15 seconds.' : '')
          : 'Bluetooth is not running: shunt data is being read over VE.Direct serial. Anything set ' +
            'here is saved straight away, but stays idle until you set Shunt Source to "Prefer BLE" ' +
            'in Settings and reboot - the radio is only started at boot.';
        onTab.classList.add('show');
      }

      var inSettings = document.getElementById('bleSetupHint');
      if (inSettings) {
        inSettings.textContent = blePreferred
          ? 'Device address and encryption key are on the WiFi/BLE/MQTT tab. Reboot to apply a source change.'
          : '';
        inSettings.classList.toggle('show', blePreferred);
      }
    }

    function startBleScan() {
      var btn = document.getElementById('bleScanBtn');
      var status = document.getElementById('bleScanStatus');
      if (btn) { btn.disabled = true; btn.textContent = 'Scanning…'; }
      if (status) { status.textContent = 'Listening for 8 seconds…'; status.classList.add('show'); }
      websocket.send('{"blescan" : true}');
      // The firmware closes the window and pushes results; this is only a
      // backstop so the button cannot stay stuck if that never arrives.
      setTimeout(function() { if (btn && btn.disabled) renderBleFound([], true); }, 12000);
    }

    function renderBleFound(list, timedOut) {
      var btn = document.getElementById('bleScanBtn');
      var status = document.getElementById('bleScanStatus');
      var box = document.getElementById('bleFoundList');
      if (btn) { btn.disabled = false; btn.textContent = 'Scan for Victron devices'; }
      if (!box) return;
      box.textContent = '';

      if (!list || list.length === 0) {
        if (status) {
          status.textContent = timedOut
            ? 'No response from the device — is Bluetooth available on this board?'
            : 'No Victron devices heard. Move closer to the shunt and scan again.';
          status.classList.add('show');
        }
        return;
      }
      if (status) { status.textContent = ''; status.classList.remove('show'); }

      list.forEach(function(d) {
        var row = document.createElement('div');
        row.className = 'checkbox-row';
        var label = document.createElement('span');
        // Signal strength is the only guide to which of several shunts is yours
        label.textContent = d.name + '  ' + d.mac + '  ' + d.rssi + ' dBm' +
                            (d.shunt ? '  (battery monitor)' : '');
        var use = document.createElement('button');
        use.textContent = 'Use';
        use.onclick = function() {
          var mac = document.getElementById('blemac');
          if (mac) { mac.value = d.mac; SendQueuedUpdate('blemac'); }
        };
        row.appendChild(use);
        row.appendChild(label);
        box.appendChild(row);
      });
    }

    function toggleTempConfig() {
      var el = document.getElementById('tempConfigFields');
      if(el) el.style.display = document.getElementById('tempprotection').checked ? '' : 'none';
      toggleMqttTempTopics();
    }

    function toggleMqttTempTopics() {
      var battSrc = document.getElementById('batttempsrc');
      var fanSrc = document.getElementById('fantempsrc');
      var battGroup = document.getElementById('mqttBattTopicGroup');
      var invGroup = document.getElementById('mqttInvTopicGroup');
      var fanSettings = document.getElementById('fanTempSettingsGroup');
      if(battGroup) battGroup.style.display = (battSrc && battSrc.value === '1') ? '' : 'none';
      if(invGroup) invGroup.style.display = (fanSrc && fanSrc.value === '1') ? '' : 'none';
      if(fanSettings) fanSettings.style.display = (fanSrc && fanSrc.value === '1') ? '' : 'none';
    }

    /* ---------- Connection ---------- */
    let reconnectAttempt = 0;
    let reconnectTimer = null;
    let lastDataAt = 0;
    let everConnected = false;
    let logsRequested = false;   // backlog already pulled on this connection

    function initWebSocket() {
      websocket = new WebSocket(gateway);
      websocket.onopen = onOpen;
      websocket.onclose = onClose;
      websocket.onmessage = onMessage;
      websocket.onerror = onError;
    }

    function setConnStatus(connected) {
      const dot = document.getElementById('connDot');
      const txt = document.getElementById('connText');
      const pill = document.getElementById('connPill');
      const content = document.getElementById('content');

      dot.classList.toggle('connected', connected);
      pill.classList.toggle('online', connected);
      txt.textContent = connected ? 'Live' : (everConnected ? 'Reconnecting…' : 'Connecting…');

      // Grey out the dashboard so frozen readings can't be mistaken for live ones.
      // Only meaningful once we have actually had data - on a cold load there is
      // nothing stale to warn about, and "connection lost" would be a lie.
      if (content) content.classList.toggle('stale', !connected && everConnected);

      const since = document.getElementById('staleSince');
      if (since) {
        since.textContent = lastDataAt
          ? new Date(lastDataAt).toLocaleTimeString()
          : 'the last update';
      }
    }

    function onOpen() {
      const wasDown = everConnected;
      everConnected = true;
      reconnectAttempt = 0;
      setConnStatus(true);
      if (wasDown) showToast('Reconnected', 'success');

      /* The backlog is not pulled here, deliberately.

         A reconnect used to re-request it whenever the Logs tab happened to be
         the active one, which put a fifty-message replay into the same 200ms as
         the full status payload - measured at ~24KB of transient heap on an
         ESP32 with none to spare, and the largest single thing the socket does.
         A connection coming up should cost the configuration blob and the live
         readings, nothing else.

         Clearing the flag means the backlog is still one tab click away: switch
         away and back, or open the tab, and switchTab() fetches it. */
      logsRequested = false;
    }

    function onError(event) {
      console.error('WebSocket error:', event);
    }

    function onClose(event) {
      console.log('WebSocket closed. Code:', event.code, 'Reason:', event.reason);
      setConnStatus(false);
      // Exponential backoff capped at 15s, so a device that is off for a while
      // doesn't get hammered once per 2s indefinitely.
      const delay = Math.min(1000 * Math.pow(1.6, reconnectAttempt), 15000);
      reconnectAttempt++;
      if (reconnectTimer) clearTimeout(reconnectTimer);
      reconnectTimer = setTimeout(initWebSocket, delay);
    }

    function onMessage(event) {
      // One malformed frame must not take the handler down with it - everything
      // after this point, dashboard updates included, would stop arriving.
      let obj;
      try {
        obj = JSON.parse(event.data);
      } catch (e) {
        console.warn('Discarded unparseable WebSocket frame:', event.data);
        return;
      }
      let configDirty = false;   // re-validate once settings land, not only on typing
      
      // Handle log messages
      if(obj.hasOwnProperty('log')) {
        addLogEntry(obj.log, obj.level || 'info', obj.age);
        return;
      }
      
      // Log non-log messages only if verbose debugging needed
      // console.log(event.data);

      if(obj.hasOwnProperty('BMS') && obj.BMS) {
        ['chargevoltage','minchargecurr','adjuststep','smartinterval','overvoltage',
         'dischargevoltage','maxchargecurrent','maxdischargecurrent','batterycapacity',
         'floatvoltage','floatcurrent',
         'lowsoclimit','highsoclimit','velooptime'].forEach(function(f) {
          if(obj[f] !== undefined) SetFieldValue(f, obj[f]);
        });
        if(obj.floatvoltageactive !== undefined)
          updateFloatNote(obj.floatvoltageactive, obj.floatvoltageauto);
        // Charge voltage has landed, so the pack can now be worked out from it
        loadBatterySetup();
        if(obj.canbusenabled !== undefined) { document.getElementById('canbusenabled').checked=obj.canbusenabled; AckUpdate('canbusenabled'); }
      }

      if(obj.hasOwnProperty('RealTime') && obj.RealTime) {
        lastDataAt = Date.now();

        // Update battery SOC and visual indicator
        if(obj.hasOwnProperty('battsoc')) {
          const soc = obj.battsoc;

          // Update battery visual
          const batteryLevel = document.getElementById('batteryLevel');
          const batteryPercentage = document.getElementById('batteryPercentage');
          const gauge = document.getElementById('batteryGauge');

          if(batteryLevel && batteryPercentage) {
            batteryLevel.style.width = soc + '%';
            batteryPercentage.textContent = soc + '%';

            // Update battery color based on level
            batteryLevel.className = 'battery-level';
            if(soc <= 20) {
              batteryLevel.classList.add('low');
            } else if(soc <= 50) {
              batteryLevel.classList.add('medium');
            } else {
              batteryLevel.classList.add('high');
            }
          }
          if(gauge) gauge.setAttribute('aria-label', 'Battery state of charge ' + soc + '%');

          latestState.soc = soc;
        }

        if(obj.hasOwnProperty('battvoltage')) document.getElementById('battvoltage').textContent=(obj.battvoltage*0.01).toFixed(1);

        // Update battery current and power flow indicator
        if(obj.hasOwnProperty('battcurrent')) {
          const current = obj.battcurrent * 0.1;
          const battCurrentElem = document.getElementById('battcurrent');
          if(battCurrentElem) {
            battCurrentElem.textContent = current.toFixed(1);
          }

          // Update battery wave animation and power flow indicator
          const batteryWave = document.getElementById('batteryWave');
          const flowText = document.getElementById('powerFlowText');

          if(batteryWave && flowText) {
            batteryWave.className = 'battery-wave';
            flowText.className = 'flow-text';

            if(obj.forcecharge) {
              batteryWave.classList.add('active', 'charging');
              flowText.classList.add('charging', 'v-err');
              flowText.textContent = 'Force Charging';
            } else if(current > 0.5) {
              batteryWave.classList.add('active', 'charging');
              flowText.classList.add('charging', 'v-ok');
              flowText.textContent = 'Charging';
            } else if(current < -0.5) {
              batteryWave.classList.add('active', 'discharging');
              flowText.classList.add('discharging', 'v-warn');
              flowText.textContent = 'Discharging';
            } else {
              flowText.textContent = 'Idle';
            }
          }
        }

        if(obj.hasOwnProperty('battpower')) {
          var powerElem = document.getElementById('battpower');
          if(powerElem) powerElem.textContent = Math.abs(obj.battpower);
        }

        if(obj.hasOwnProperty('timetogo')) {
          var ttgElem = document.getElementById('timetogo');
          if(ttgElem) {
            var ttg = obj.timetogo;
            if(ttg < 0 || ttg >= 65535) { ttgElem.textContent = '--'; }
            else if(ttg >= 1440) { ttgElem.textContent = (ttg / 1440).toFixed(1) + 'd'; }
            else if(ttg >= 60) { ttgElem.textContent = Math.floor(ttg/60) + 'h ' + (ttg%60) + 'm'; }
            else { ttgElem.textContent = ttg + 'm'; }
          }
        }

        if(obj.hasOwnProperty('batttemp')) {
          var tempElem = document.getElementById('batttemp');
          if(tempElem) tempElem.textContent = obj.batttemp;
          latestState.batttemp = obj.batttemp;
        }
        if(obj.hasOwnProperty('mqttinvertertemp')) {
          var e = document.getElementById('mqttinvertertemp');
          if(e) e.textContent = obj.mqttinvertertemp == -127 ? '--' : obj.mqttinvertertemp;
        }
        if(obj.hasOwnProperty('fanpwm')) {
          var e = document.getElementById('fanpwm');
          if(e) e.textContent = obj.fanpwm;
        }

        if(obj.hasOwnProperty('showtempdashboard')) {
          var tempRow = document.getElementById('tempRow');
          if(tempRow) tempRow.hidden = !obj.showtempdashboard;
        }

        if(obj.hasOwnProperty('chargeadjust')) {
          var adjElem = document.getElementById('chargeadjust');
          if(adjElem) adjElem.textContent = (obj.chargeadjust * 0.001).toFixed(0);
        }

        if(obj.hasOwnProperty('chargecurrent')) document.getElementById('chargecurrent').textContent=(obj.chargecurrent*0.001).toFixed(0);
        if(obj.hasOwnProperty('dischargecurrent')) document.getElementById('dischargecurrent').textContent=(obj.dischargecurrent*0.001).toFixed(0);

        if(obj.hasOwnProperty('chargeenabled')) {
          chargeEnabled = obj.chargeenabled;
          latestState.chargeenabled = obj.chargeenabled;
          setToggleState('chargeToggle', 'chargeenabledStatus', obj.chargeenabled);
        }
        if(obj.hasOwnProperty('dischargeenabled')) {
          dischargeEnabled = obj.dischargeenabled;
          latestState.dischargeenabled = obj.dischargeenabled;
          setToggleState('dischargeToggle', 'dischargeenabledStatus', obj.dischargeenabled);
        }
        /* Force charge is driven from MQTT, the schedule and the safety cut as
           well as from here, so the toggle only ever follows the device - it is
           never set locally on click. */
        if(obj.hasOwnProperty('forcecharge')) {
          setToggleState('forceToggle', 'forcechargeStatus', obj.forcecharge);
        }

        if(obj.hasOwnProperty('chargephase')) {
          let phaseElem = document.getElementById('chargephaseStatus');
          if(phaseElem) {
            const PHASE_CLASS = { Bulk: 'v-ok', Absorption: 'v-warn', Float: 'v-ok', Complete: 'v-info' };
            phaseElem.textContent = obj.chargephase;
            phaseElem.className = 'stat-value sm ' + (PHASE_CLASS[obj.chargephase] || 'v-accent');
          }
          latestState.chargephase = obj.chargephase;
        }

        ['forcecharge','requestfullcharge','requestflagsactive','soctrickactive',
         'battvoltage','battcurrent','reportedsoc','socoverride',
         'absorbelapsed','absorbmax','tailheld','tailneed','tailactive','tailthreshold',
         'tailvoltok','tailvoltmin',
         'schedactive','schedsource','schedmqttcount','scheduicount','schednext','schedclock',
         'schednextin','schedendsin',
         'ovrcharge','ovrdischarge','ovrforce','ovrsecs',
         'maxchargecurrent','maxdischargecurrent','reqchargecurrent','reqdischargecurrent',
         'reqchargeage','reqdischargeage','effchargecurrent','effdischargecurrent'
        ].forEach(function(k) {
          if (obj.hasOwnProperty(k)) latestState[k] = obj[k];
        });
        renderControllerRequest();
        renderSchedStatus();
        updateAbsorption();
        updateSOCOverride();
        updateWarnings();

        // Update last update timestamp
        const lastUpdateElem = document.getElementById('lastUpdate');
        if(lastUpdateElem) lastUpdateElem.textContent = new Date().toLocaleTimeString();
      }

      ['soctrickenabled','requestflagsenabled','never100soc','autocharge'].forEach(function(f) {
        if(obj[f] !== undefined) { document.getElementById(f).checked=obj[f]; AckUpdate(f); }
      });
      // Live state rather than a saved setting, so it is mirrored without an ack
      if(obj.requestfullcharge !== undefined) {
        const rfc = document.getElementById('requestfullcharge');
        if(rfc) rfc.checked = obj.requestfullcharge;
      }
      if(obj.hasOwnProperty('wifissidhex') || obj.hasOwnProperty('wifissid')) {
        // Hex identifies the network; wifissid is only what the user reads
        var savedHex = obj.wifissidhex || ssidTextToHex(obj.wifissid || '');
        var savedName = obj.wifissid || ssidHexToText(savedHex);
        savedWifiSSID = savedHex;
        console.log("Updated saved WiFi SSID: " + savedName);
        // Set the selected SSID in dropdown
        var select = document.getElementById('wifissid');
        select.value = savedHex;
        // If dropdown is empty or doesn't have this SSID option, create it
        if(savedHex && select.value !== savedHex) {
          var el = document.createElement('option');
          el.textContent = savedName;
          el.value = savedHex;
          el.selected = true;
          select.appendChild(el);
        }
        AckUpdate('wifissid');
      }
      ['wifipass','wifihostname','victronrxpin','victrontxpin',
       'mqttport','mqttserverip','mqttclientid','mqtttopic','mqttuser','mqttpass',
       'slowchargesoc1','slowchargesoc2','slowchargesoc1div','slowchargesoc2div',
       'tailduration','maxabsorptiontime','rechargesoc',
       'chargehightemp','chargelowtemp','dischargehightemp','dischargelowtemp',
       'mqttbatttopic','mqttinvtopic','fanofftemp','fanfulltemp',
       'ntpserver','timezone','syslogserver','syslogport','overridetimeout','requesttimeout',
       'tailcurrent','rechargevoltageoffset'].forEach(function(f) {
        if(obj[f] !== undefined) { SetFieldValue(f, obj[f]); configDirty = true; }
      });
      {{CAN_FIELD_HANDLERS}}
      if(obj.ntpfromdhcp !== undefined) { document.getElementById('ntpfromdhcp').checked=obj.ntpfromdhcp; AckUpdate('ntpfromdhcp'); }
      if(obj.tempprotection !== undefined) { document.getElementById('tempprotection').checked=obj.tempprotection; AckUpdate('tempprotection'); toggleTempConfig(); }
      if(obj.showtempdashboard !== undefined) { document.getElementById('showtempdashboard').checked=obj.showtempdashboard; AckUpdate('showtempdashboard'); }
      if(obj.canprotocol !== undefined) { document.getElementById('canprotocol').value=obj.canprotocol; AckUpdate('canprotocol'); }
      if(obj.pylonversion !== undefined && obj.canprotocol === undefined) { document.getElementById('canprotocol').value=obj.pylonversion; AckUpdate('canprotocol'); }
      if(obj.batttempsrc !== undefined) { document.getElementById('batttempsrc').value=obj.batttempsrc; AckUpdate('batttempsrc'); toggleMqttTempTopics(); }
      if(obj.fantempsrc !== undefined) { document.getElementById('fantempsrc').value=obj.fantempsrc; AckUpdate('fantempsrc'); toggleMqttTempTopics(); }
      if(obj.lcdenabled !== undefined) { document.getElementById('lcdenabled').checked=obj.lcdenabled; AckUpdate('lcdenabled'); }
      if(obj.syslogenabled !== undefined) { document.getElementById('syslogenabled').checked=obj.syslogenabled; AckUpdate('syslogenabled'); validateFields(); }
      // Runtime only - deliberately absent from EXPORT_FIELDS, see the firmware handler.
      // Only follow the filter on an actual change of state, so the firmware's
      // 30-minute auto-off restores the log view, but a routine config broadcast
      // does not keep dragging the dropdown back while a capture is being read.
      if(obj.cansniffer !== undefined) {
        const snifBox = document.getElementById('cansniffer');
        const snifChanged = snifBox.checked !== obj.cansniffer;
        snifBox.checked = obj.cansniffer;
        AckUpdate('cansniffer');
        if (snifChanged) syncSnifferFilter('can');
      }
      if(obj.blesniffer !== undefined) {
        const bs = document.getElementById('blesniffer');
        const bsChanged = bs.checked !== obj.blesniffer;
        bs.checked = obj.blesniffer;
        AckUpdate('blesniffer');
        if (bsChanged) syncSnifferFilter('ble');
      }
      if(obj.shuntsource !== undefined) {
        document.getElementById('shuntsource').value = obj.shuntsource;
        AckUpdate('shuntsource'); toggleBleConfig();
      }
      // toggleBleConfig again here: the hint text depends on both fields, and
      // shuntsource is handled above, before this one has been set
      if(obj.blefallback !== undefined) { document.getElementById('blefallback').checked = obj.blefallback; AckUpdate('blefallback'); toggleBleConfig(); }
      if(obj.blemac !== undefined) { document.getElementById('blemac').value = obj.blemac; AckUpdate('blemac'); }
      if(obj.blekeyset !== undefined) {
        // The key itself never comes back, so report whether one is held
        var ks = document.getElementById('bleKeyState');
        if (ks) {
          ks.textContent = obj.blekeyset ? 'A key is stored. Type a new one to replace it.'
                                         : 'No key stored yet — adverts cannot be decoded.';
          ks.classList.add('show');
          ks.classList.toggle('warn', !obj.blekeyset);
        }
        AckUpdate('blekey');
      }
      if(obj.blefound !== undefined && !obj.blescanning) renderBleFound(obj.blefound, false);
      if(obj.bleadverts !== undefined) {
        var e = document.getElementById('bleAdverts');
        if (e) e.textContent = obj.bleadverts;
      }
      if(obj.blefailures !== undefined) {
        var e = document.getElementById('bleFailures');
        if (e) e.textContent = obj.blefailures;
      }
      if(obj.blefresh !== undefined) {
        var e = document.getElementById('bleStatus');
        if (e) {
          var ago = obj.blelastseen;
          // The radio only runs when BLE is the preferred source, or while a
          // scan/sniff has started it. Saying "nothing received" when it was
          // never switched on reads as a fault rather than a setting.
          var srcSel = document.getElementById('shuntsource');
          var snif = document.getElementById('blesniffer');
          var running = (srcSel && srcSel.value === '1') || obj.blescanning || (snif && snif.checked);
          if (obj.blefresh) { e.textContent = 'Receiving (' + obj.blesoc.toFixed(1) + '%)'; e.className = 'stat-value sm v-ok'; }
          else if (ago >= 0) { e.textContent = 'Stale, ' + ago + 's ago'; e.className = 'stat-value sm v-warn'; }
          else if (!running) { e.textContent = 'Not started'; e.className = 'stat-value sm v-dim'; }
          else { e.textContent = 'Nothing received'; e.className = 'stat-value sm v-dim'; }
        }
      }
      if(obj.timezone !== undefined) syncTzPreset();
      if(obj.schedui !== undefined) { renderSchedule(obj.schedui); confirmScheduleSaved(obj.schedui); }
      if(obj.schedmqtt !== undefined) renderMqttWindows(obj.schedmqtt);
      if(obj.mqtttopic !== undefined) {
        var st=document.getElementById('schedTopic');
        if(st) st.textContent = obj.mqtttopic + '/set/Schedule';
      }
      {{FAN_PIN_HANDLER}}

      var devFields = {modelstring:'devModel',fwversion:'devFW',serialnumber:'devSerial',pidstring:'devPID'};
      for(var k in devFields) { if(obj[k] !== undefined) { var e=document.getElementById(devFields[k]); if(e) e.textContent=obj[k]||'--'; } }
      /* Uptime rides in the frequent payload alongside the heap figures, and is
         the first thing to read when a board is behaving oddly: a device that
         says minutes when it should say days restarted while nobody was
         watching, and the heap low-water marks beside it say whether that was
         the reason. Flagged under a minute: on a device meant to run for months,
         an uptime in seconds is the single most interesting thing on the tab -
         including for the minute after you deliberately restarted it. */
      if(obj.hasOwnProperty('uptime')) {
        var e=document.getElementById('uptimeInfo');
        if(e) {
          e.textContent = fmtDuration(obj.uptime);
          e.className = 'stat-value sm ' + (obj.uptime < 60 ? 'v-warn' : '');
        }
      }
      if(obj.hasOwnProperty('freeheap') && obj.hasOwnProperty('totalheap')) {
        var e=document.getElementById('heapInfo');
        if(e) e.textContent=(obj.freeheap/1024).toFixed(0) + 'K / ' + (obj.totalheap/1024).toFixed(0) + 'K';
      }
      if(obj.hasOwnProperty('ntpsyncago')) {
        var e=document.getElementById('ntpSyncInfo');
        if(e) {
          var a = obj.ntpsyncago;
          // -2 = no NTP server set, -1 = configured but never synced yet
          if (a === -2)      { e.textContent = 'Disabled'; e.className = 'stat-value sm v-dim'; }
          else if (a === -1) { e.textContent = 'Never';    e.className = 'stat-value sm v-warn'; }
          else {
            e.textContent = fmtDuration(a) + ' ago';
            // The SNTP client re-polls every 3 hours; well past that means it has
            // stopped getting answers even though the clock was set once.
            e.className = 'stat-value sm ' + (a > 14400 ? 'v-warn' : 'v-ok');
          }
        }
      }
      if(obj.hasOwnProperty('cantotalfails')) {
        var e=document.getElementById('canFailInfo');
        if(e) {
          e.textContent=obj.cantotalfails;
          e.className = 'stat-value sm ' + (obj.cantotalfails > 0 ? 'v-warn' : '');
        }
      }
      if(obj.hasOwnProperty('inverterpresent')) {
        var row=document.getElementById('inverterStatusRow');
        var dot=document.getElementById('inverterDot');
        if(row) row.hidden = !obj.inverterpresent;
        if(dot) dot.classList.toggle('connected', !!obj.inverterpresent);
        latestState.inverterpresent = obj.inverterpresent;
      }
      if(obj.hasOwnProperty('victrondata')) {
        var dot=document.getElementById('shuntDot');
        if(dot) dot.classList.toggle('connected', !!obj.victrondata);
        latestState.victrondata = obj.victrondata;
      }
      if(obj.hasOwnProperty('mqttconnected')) {
        var dot=document.getElementById('mqttDot');
        if(dot) dot.classList.toggle('connected', !!obj.mqttconnected);
      }
      if(obj.hasOwnProperty('fwversion_bms')) {
        var e=document.getElementById('fwVersionBms');
        if(e) e.textContent=obj.fwversion_bms;
        // Mirror into the header so you can tell two devices apart at a glance
        var h=document.getElementById('fwHeader');
        if(h) { h.textContent=obj.fwversion_bms; document.getElementById('fwMeta').hidden = false; }
        fwLink.from = obj.fwversion_bms; updateFwDownloadLink();
      }
      if(obj.hasOwnProperty('fwbuild')) {
        var e=document.getElementById('fwBuild');
        if(e) e.textContent=obj.fwbuild;
      }
      if(obj.hasOwnProperty('pioenv')) { fwLink.env = obj.pioenv; updateFwDownloadLink(); }
      if(obj.hasOwnProperty('apppartkb')) {
        var e=document.getElementById('fwPartition');
        if(e) e.textContent = obj.apppartkb ? (obj.apppartkb/1024).toFixed(2) + ' MB' : '--';
        fwLink.slot = obj.apppartkb; updateFwDownloadLink();
      }
      if(obj.hasOwnProperty('legacypartitions')) {
        var w=document.getElementById('partitionWarn');
        if(w) w.hidden = !obj.legacypartitions;
      }
      if(obj.hasOwnProperty('wifihostname') && obj.wifihostname) {
        var h=document.getElementById('hostName');
        if(h) { h.textContent=obj.wifihostname; document.getElementById('hostMeta').hidden = false; }
      }

      // Handle WiFi scan results from WebSocket
      if(obj.hasOwnProperty('wifinetworks')) {
        PopulateWifiList(obj.wifinetworks);
      }

      if(obj.hasOwnProperty('Message')) showToast(obj.Message, 'success', 4000);
      if(obj.hasOwnProperty('ERROR')) showToast(obj.ERROR, 'error', 6000);

      // Surface cross-field problems as soon as the config arrives, so a bad
      // combination is visible on load rather than only after an edit.
      if (configDirty) validateFields();
    }

    function onLoad() {
      initTheme();
      initTabKeys();
      initTooltips();
      initValidation();
      // Restore the tab from the URL so refresh/bookmark lands in the same place
      switchTab((location.hash || '#home').slice(1), true);
      window.addEventListener('hashchange', function() {
        switchTab((location.hash || '#home').slice(1), true);
      });
      setConnStatus(false);
      initWebSocket();
    }

    function setUpdateButtonsDisabled(disabled) {
      document.querySelectorAll('.button-group button, .wifi-controls button')
        .forEach(function(button) { button.disabled = disabled; });
    }

    /* ---------- Unsaved-changes tracking ---------- */
    // Field edits are applied to the running device immediately but are only durable
    // once written to EEPROM, so surface that gap rather than leaving it implicit.
    let hasUnsaved = false;

    function markUnsaved() {
      hasUnsaved = true;
      const bar = document.getElementById('unsavedBar');
      if (bar) bar.classList.add('show');
    }

    function clearUnsaved() {
      hasUnsaved = false;
      const bar = document.getElementById('unsavedBar');
      if (bar) bar.classList.remove('show');
    }

    function saveAll() {
      setUpdateButtonsDisabled(true);
      showFeedback('Saving configuration…');
      websocket.send('{"saveall" : true}');
      clearUnsaved();
      setTimeout(() => setUpdateButtonsDisabled(false), 2000);
    }

    function setToggleState(btnId, labelId, on) {
      const btn = document.getElementById(btnId);
      const lbl = document.getElementById(labelId);
      if (btn) btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      if (lbl) lbl.textContent = on ? 'ON' : 'OFF';
    }

    // Settings export/import - reads from DOM, sends via existing WebSocket handlers
    const EXPORT_FIELDS = {
      checkboxes: ['canbusenabled','can16mhz','soctrickenabled','requestflagsenabled','never100soc',
                   'autocharge','tempprotection','showtempdashboard','lcdenabled','syslogenabled',
                   'blefallback','ntpfromdhcp'],
      numbers: ['lowsoclimit','highsoclimit','smartinterval','tailduration',
                'maxabsorptiontime','rechargesoc','chargehightemp','chargelowtemp',
                'dischargehightemp','dischargelowtemp','fanofftemp','fanfulltemp',
                'slowchargesoc1','slowchargesoc2','slowchargesoc1div','slowchargesoc2div',
                'velooptime','mqttport','syslogport','overridetimeout','requesttimeout'],
      // Exported in display units (V/A/Ah); import re-scales on send
      converted: UNIT_CONVERT_FIELDS,
      /* blekey is deliberately absent. The firmware never sends it back to the
         browser, so it could not be exported anyway - and a settings file that
         quietly carried the shunt's only credential is not something to hand
         out when asking for help with a config. It is re-entered by hand. */
      strings: ['ntpserver','timezone','syslogserver','mqttserverip','mqttclientid','mqtttopic','mqttuser',
                'mqttpass','mqttbatttopic','mqttinvtopic','wifihostname','blemac'],
      selects: ['canprotocol','batttempsrc','fantempsrc','shuntsource'],
      pins: ['victronrxpin','victrontxpin','can_rx_pin','can_tx_pin','can_en_pin',
             'canbuscspin','fanpin','onewirepin']
    };

    function exportSettings() {
      var settings = { _exportVersion: 2, _exportDate: new Date().toISOString() };
      EXPORT_FIELDS.checkboxes.forEach(function(f) {
        var el = document.getElementById(f);
        if (el) settings[f] = el.checked;
      });
      EXPORT_FIELDS.numbers.forEach(function(f) {
        var el = document.getElementById(f);
        if (el && el.value !== '') settings[f] = Number(el.value);
      });
      for (var f in EXPORT_FIELDS.converted) {
        var el = document.getElementById(f);
        if (el && el.value !== '') settings[f] = Number(el.value);
      }
      EXPORT_FIELDS.strings.forEach(function(f) {
        var el = document.getElementById(f);
        if (el) settings[f] = el.value;
      });
      EXPORT_FIELDS.selects.forEach(function(f) {
        var el = document.getElementById(f);
        if (el) settings[f] = Number(el.value);
      });
      EXPORT_FIELDS.pins.forEach(function(f) {
        var el = document.getElementById(f);
        if (el && el.value !== '' && Number(el.value) > 0) settings[f] = Number(el.value);
      });
      // WiFi SSID from select - exported as hex so a name in any encoding
      // restores as the same bytes on any device
      var ssid = document.getElementById('wifissid');
      if (ssid && ssid.value) settings.wifissidhex = ssid.value;
      var wpass = document.getElementById('wifipass');
      if (wpass && wpass.value) settings.wifipass = wpass.value;

      var blob = new Blob([JSON.stringify(settings, null, 2)], {type: 'application/json'});
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      var hostname = document.getElementById('wifihostname');
      a.download = (hostname && hostname.value ? hostname.value : 'diybms') + '-settings.json';
      a.click();
      URL.revokeObjectURL(a.href);
      showToast('Settings exported', 'success');
    }

    // v1 exports held these in raw mV/mA; v2 onwards holds display units (V/A/Ah)
    const LEGACY_RAW_FIELDS = ['chargevoltage','dischargevoltage','overvoltage','maxchargecurrent',
                               'maxdischargecurrent','minchargecurr','adjuststep','batterycapacity'];

    function importSettings(input) {
      var file = input.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function(e) {
        try {
          var settings = JSON.parse(e.target.result);
          askConfirm({
            title: 'Import Settings',
            body: 'Import ' + Object.keys(settings).length + ' settings from ' + file.name +
                  '? This overwrites your current configuration and reboots the device.',
            okLabel: 'Import'
          }).then(function(ok) {
            input.value = '';
            if (ok) applyImportedSettings(settings);
          });
        } catch(err) {
          showToast('Invalid settings file: ' + err.message, 'error', 5000);
          input.value = '';
        }
      };
      reader.readAsText(file);
    }

    function applyImportedSettings(settings) {
        try {
          var count = 0;
          var skip = ['_exportVersion', '_exportDate'];
          var exportVersion = settings._exportVersion || 1;

          // For converted fields, set DOM value as display units (server expects raw via SendQueuedUpdate)
          for (var key in settings) {
            if (skip.indexOf(key) >= 0) continue;
            // wifissidhex has no field of its own - it fills the network dropdown
            var isSsid = (key === 'wifissid' || key === 'wifissidhex');
            var el = document.getElementById(isSsid ? 'wifissid' : key);
            if (!el) continue;
            // ...and the queued update always goes out under the field's own id
            var sendKey = isSsid ? 'wifissid' : key;

            if (el.type === 'checkbox') {
              el.checked = !!settings[key];
            } else if (isSsid) {
              // Files exported before 3.0 carry the name as text; convert so the
              // option value is hex either way
              var ssidHex = (key === 'wifissidhex') ? settings[key] : ssidTextToHex(settings[key]);
              // Ensure option exists in select
              if (el.value !== ssidHex) {
                var opt = document.createElement('option');
                opt.textContent = ssidHexToText(ssidHex);
                opt.value = ssidHex;
                el.appendChild(opt);
              }
              el.value = ssidHex;
            } else {
              var value = settings[key];
              // Rescale legacy raw-unit exports into the display units the field now expects
              if (exportVersion < 2 && LEGACY_RAW_FIELDS.indexOf(key) >= 0) {
                value = (Number(value) / 1000).toFixed(UNIT_DECIMALS);
              }
              el.value = value;
            }
            // Queue the update to send to server via existing WebSocket mechanism
            // Use a staggered delay to avoid flooding
            (function(k) {
              setTimeout(function() { SendQueuedUpdate(k); }, count * 150);
            })(sendKey);
            count++;
          }
          showToast('Importing ' + count + ' settings…', 'pending', (count * 150) + 2000);
          // Reboot after all settings have been sent
          var rebootDelay = (count * 150) + 2000;
          setTimeout(function() {
            showToast('Rebooting to apply settings…', 'success', 4000);
            websocket.send('{"reboot" : true}');
          }, rebootDelay);
        } catch(err) {
          showToast('Could not apply settings: ' + err.message, 'error', 5000);
        }
    }

    /* ---------- Modal dialog (replaces blocking confirm/alert) ---------- */
    let modalResolve = null;

    // opts: { title, body, okLabel, danger, requirePhrase }
    function askConfirm(opts) {
      return new Promise(function(resolve) {
        modalResolve = resolve;
        const back = document.getElementById('modalBackdrop');
        const ok = document.getElementById('modalOk');
        const wrap = document.getElementById('modalConfirmWrap');
        const input = document.getElementById('modalConfirmInput');

        document.getElementById('modalTitle').textContent = opts.title || 'Confirm';
        document.getElementById('modalBody').textContent = opts.body || '';
        ok.textContent = opts.okLabel || 'Confirm';
        ok.className = opts.danger ? 'btn-danger' : 'btn-primary';

        // Irreversible actions require the phrase to be typed out in full
        if (opts.requirePhrase) {
          document.getElementById('modalPhrase').textContent = opts.requirePhrase;
          input.value = '';
          wrap.hidden = false;
          ok.disabled = true;
          input.oninput = function() {
            ok.disabled = input.value.trim().toUpperCase() !== opts.requirePhrase.toUpperCase();
          };
        } else {
          wrap.hidden = true;
          ok.disabled = false;
          input.oninput = null;
        }

        back.classList.add('show');
        setTimeout(function() { (opts.requirePhrase ? input : ok).focus(); }, 40);
      });
    }

    function closeModal(result) {
      document.getElementById('modalBackdrop').classList.remove('show');
      const r = modalResolve;
      modalResolve = null;
      if (r) r(result);
    }

    document.addEventListener('keydown', function(e) {
      if (!modalResolve) return;
      if (e.key === 'Escape') closeModal(false);
      else if (e.key === 'Enter' && !document.getElementById('modalOk').disabled) closeModal(true);
    });

    function eraseAll() {
      askConfirm({
        title: 'Factory Reset',
        body: 'This erases every stored setting, including WiFi credentials. The device will need to be reconfigured from scratch. This cannot be undone.',
        okLabel: 'Erase Everything', danger: true, requirePhrase: 'ERASE'
      }).then(function(ok) {
        if (!ok) return;
        setUpdateButtonsDisabled(true);
        showFeedback('Erasing configuration…');
        websocket.send('{"eraseall" : true}');
        setTimeout(() => setUpdateButtonsDisabled(false), 2000);
      });
    }

    function erasekeepwifi() {
      askConfirm({
        title: 'Factory Reset, Keep WiFi',
        body: 'This erases all settings except your WiFi credentials, so the device will stay reachable on the network. This cannot be undone.',
        okLabel: 'Erase Settings', danger: true, requirePhrase: 'ERASE'
      }).then(function(ok) {
        if (!ok) return;
        setUpdateButtonsDisabled(true);
        showFeedback('Erasing configuration (keeping WiFi)…');
        websocket.send('{"erasekeepwifi" : true}');
        setTimeout(() => setUpdateButtonsDisabled(false), 2000);
      });
    }

    function rebootBMS() {
      askConfirm({
        title: 'Reboot Device',
        body: hasUnsaved
          ? 'You have unsaved changes. Rebooting now will discard them - save to EEPROM first if you want to keep them.'
          : 'The BMS will restart. Charge and discharge control is unavailable for a few seconds.',
        okLabel: 'Reboot', danger: hasUnsaved
      }).then(function(ok) {
        if (!ok) return;
        setUpdateButtonsDisabled(true);
        showFeedback('Rebooting device…');
        websocket.send('{"reboot" : true}');
        setTimeout(() => setUpdateButtonsDisabled(false), 3000);
      });
    }

    // Track current charge/discharge enable states
    let chargeEnabled = false;
    let dischargeEnabled = false;

    // Give the schedule its levers back now rather than waiting out the timeout
    function clearOverride() {
      websocket.send('{"clearoverride" : true}');
      showFeedback('Returning control to the schedule…');
    }

    function toggleChargeEnable() {
      chargeEnabled = !chargeEnabled;
      console.log('Toggling Charge Enable to: ' + chargeEnabled);
      showFeedback(chargeEnabled ? 'Enabling charge...' : 'Disabling charge...');
      websocket.send(JSON.stringify({"manualallowcharge": chargeEnabled}));
    }

    function toggleDischargeEnable() {
      dischargeEnabled = !dischargeEnabled;
      console.log('Toggling Discharge Enable to: ' + dischargeEnabled);
      showFeedback(dischargeEnabled ? 'Enabling discharge...' : 'Disabling discharge...');
      websocket.send(JSON.stringify({"manualallowdischarge": dischargeEnabled}));
    }

    /* Live state rather than a saved setting, so no update queue here either.
       Flips from the last state the device reported rather than a local mirror:
       MQTT, the schedule and the safety cut all move this lever, and a mirror
       kept here would send the wrong value after any of them. */
    function toggleForceCharge() {
      const btn = document.getElementById('forceToggle');
      const now = latestState.forcecharge !== undefined
                  ? latestState.forcecharge
                  : (btn && btn.getAttribute('aria-pressed') === 'true');
      const on = !now;
      showFeedback(on ? 'Forcing charge...' : 'Clearing force charge...');
      websocket.send(JSON.stringify({"forcecharge": on}));
    }

    /* Not a saved setting, so it does not go through the update queue - the
       "Saved" toast that queue shows would be a lie. It clears on reboot. */
    function toggleRequestFullCharge(on) {
      showFeedback(on ? 'Requesting full charge...' : 'Clearing full charge request...');
      websocket.send(JSON.stringify({"requestfullcharge": on}));
    }

    function showFeedback(message) {
      showToast(message, 'pending', 2500);
    }

    /* The three things the download page needs, which arrive together in the
       static payload but are read by three separate handlers above - so keep
       what has been seen and rebuild the link whenever another piece lands.
       Only the env is required. Without it the site cannot tell which of the
       builds this board is running, and a link that guesses at that is worse
       than no link: the wrong image flashes cleanly and does not boot. A
       firmware built before this define existed simply never shows the row. */
    var fwLink = { env: '', from: '', slot: 0 };

    function updateFwDownloadLink() {
      var row = document.getElementById('fwDownloadRow');
      var a = document.getElementById('fwDownloadLink');
      if (!row || !a) return;
      if (!fwLink.env) { row.hidden = true; return; }
      var q = 'env=' + encodeURIComponent(fwLink.env);
      if (fwLink.from) q += '&from=' + encodeURIComponent(fwLink.from);
      if (fwLink.slot) q += '&slot=' + encodeURIComponent(fwLink.slot);
      a.href = 'https://diy.power-pilot.uk/update.html?' + q;
      row.hidden = false;
      checkForNewFirmware();
    }

    /* Is there anything newer published?
     *
     * THE BOARD DOES NOT ASK. This runs in the browser looking at this page,
     * which already has an internet connection, a TLS stack and memory to
     * spare - none of which the device has going spare. A board with no PSRAM
     * has roughly 50KB of internal heap free and a TLS session wants most of
     * it, which is why the firmware has no HTTPS client and why this is not one
     * either: it is thirty lines of the page you are already looking at, and it
     * works the same on every board.
     *
     * The device supplies what only it knows - which build it is running - and
     * the browser supplies the network. Nothing is sent anywhere: it is a GET
     * of a public file, and the file says nothing about who asked.
     *
     * Silent on failure, deliberately. Plenty of these devices sit on networks
     * with no route out, and a red "cannot check for updates" on an appliance
     * that is working perfectly is a fault report about nothing. The plain link
     * stays, and it still works the moment someone with a connection clicks it. */
    var fwCheckDone = false;

    /* Newest first, matching the ordering the website uses: numbers compare as
       numbers so 3.0.10 beats 3.0.9, and a plain release beats its own
       pre-release, so 3.0.0 is newer than 3.0.0-BETA1. */
    function fwNewer(a, b) {
      function split(v) {
        var parts = String(v).split('-');
        var core = parts.shift();
        return { nums: core.split('.').map(function (n) { return parseInt(n, 10) || 0; }),
                 pre: parts.length ? parts.join('-') : null };
      }
      var A = split(a), B = split(b);
      for (var i = 0; i < Math.max(A.nums.length, B.nums.length); i++) {
        var d = (A.nums[i] || 0) - (B.nums[i] || 0);
        if (d) return d > 0;
      }
      if (A.pre === B.pre) return false;
      if (!A.pre) return true;   // 3.0.0 is newer than 3.0.0-BETA1
      if (!B.pre) return false;
      return A.pre > B.pre;
    }

    function checkForNewFirmware() {
      if (fwCheckDone || !fwLink.env || !fwLink.from) return;
      fwCheckDone = true;

      fetch('https://diy.power-pilot.uk/firmware/releases.json', { cache: 'no-cache' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (index) { if (index) showFirmwareVerdict(index); })
        .catch(function () { /* no route out - leave the plain link alone */ });
    }

    function showFirmwareVerdict(index) {
      var a = document.getElementById('fwDownloadLink');
      var note = document.getElementById('fwDownloadNote');
      if (!a || !note) return;

      /* A device on a pre-release is on the beta channel by choice, so it is
         told about betas. One on a release build is not: offering it a beta
         because the beta is numerically newer is how someone ends up testing
         firmware on a battery they rely on without having agreed to. */
      var channels = /-/.test(fwLink.from) ? ['beta', 'release'] : ['release'];

      /* Only versions that actually published a build for THIS env count. A
         release that skipped this board is not an update for this board, and
         saying otherwise sends someone to a page with nothing on it. */
      var newest = null;
      for (var c = 0; c < channels.length; c++) {
        var versions = (index.channels && index.channels[channels[c]]) || [];
        for (var i = 0; i < versions.length; i++) {
          var v = versions[i];
          var hasEnv = (v.builds || []).some(function (b) { return b.env === fwLink.env; });
          if (hasEnv && (!newest || fwNewer(v.version, newest))) newest = v.version;
        }
      }
      if (!newest) return;

      var isNew = fwNewer(newest, fwLink.from);

      if (isNew) {
        a.textContent = 'Version ' + newest + ' is available - download it for this board';
        note.textContent = 'You are running ' + fwLink.from + '. Opens diy.power-pilot.uk; choose the downloaded file below.';
        note.className = 'fw-download-note new';
      }
      else {
        a.textContent = 'Download ' + newest + ' again for this board';
        note.textContent = 'You are running ' + fwLink.from + ', which is the newest published for this board.';
        note.className = 'fw-download-note';
      }

      /* The same fact as a figure beside the running version, because that is
         where someone looks to compare the two. Amber only when it is actually
         newer - colouring it whenever it differs from nothing would make "up to
         date" look like a warning. */
      var box = document.getElementById('fwDownloadable');
      if (box) {
        box.innerHTML = '';
        var link = document.createElement('a');
        link.href = a.href;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = newest;
        box.appendChild(link);
        box.className = 'stat-value sm' + (isNew ? ' v-warn' : '');
      }
    }

    function uploadFirmware() {
      var fileInput = document.getElementById('firmwareFile');
      var file = fileInput.files[0];
      if (!file) { showToast('Please select a firmware file', 'error'); return; }
      if (!file.name.endsWith('.bin') && !file.name.endsWith('.bin.gz')) {
        showToast('Invalid file type. Use .bin or .bin.gz', 'error'); return;
      }
      if (file.size > 4194304) { showToast('File too large (max 4MB)', 'error'); return; }

      askConfirm({
        title: 'Flash Firmware',
        body: 'Write ' + file.name + ' (' + (file.size / 1024).toFixed(0) + ' KB) to the device? ' +
              'Do not power off during the update - an interrupted flash can leave the BMS unbootable.',
        okLabel: 'Flash', danger: true
      }).then(function(ok) { if (ok) doUploadFirmware(file); });
    }

    function doUploadFirmware(file) {
      var btn = document.getElementById('firmwareBtn');
      btn.disabled = true;
      var progressDiv = document.getElementById('fwProgress');
      var progressBar = document.getElementById('fwProgressBar');
      progressDiv.hidden = false;
      progressBar.className = 'progress-bar';

      var formData = new FormData();
      formData.append('firmware', file);

      var xhr = new XMLHttpRequest();
      xhr.open('POST', 'update?name=firmware', true);

      xhr.upload.onprogress = function(e) {
        if (e.lengthComputable) {
          var pct = Math.round((e.loaded / e.total) * 100);
          progressBar.style.width = pct + '%';
          progressBar.textContent = pct + '%';
        }
      };

      xhr.onload = function() {
        if (xhr.status === 200 && xhr.responseText.indexOf('Success') !== -1) {
          progressBar.style.width = '100%';
          progressBar.textContent = 'Flashed! Waiting for reboot...';
          progressBar.className = 'progress-bar ok';
          showToast('Update successful! Waiting for device to reconnect...', 'success', 60000);
          waitForReconnect(60);
        } else {
          progressBar.className = 'progress-bar err';
          progressBar.textContent = 'Failed';
          showToast('Update failed: ' + xhr.responseText, 'error', 5000);
          btn.disabled = false;
        }
      };

      xhr.onerror = function() {
        progressBar.className = 'progress-bar err';
        progressBar.textContent = 'Error';
        showToast('Upload failed - connection error', 'error', 5000);
        btn.disabled = false;
      };

      xhr.ontimeout = function() {
        progressBar.className = 'progress-bar err';
        progressBar.textContent = 'Timeout';
        showToast('Upload timed out', 'error', 5000);
        btn.disabled = false;
      };

      xhr.timeout = 120000; // 2 minutes
      showToast('Uploading firmware...', 'pending', 60000);
      xhr.send(formData);
    }

    function waitForReconnect(maxSeconds) {
      var progressBar = document.getElementById('fwProgressBar');
      var elapsed = 0;
      var interval = setInterval(function() {
        elapsed++;
        var remaining = maxSeconds - elapsed;
        if (progressBar) progressBar.textContent = 'Reconnecting... ' + remaining + 's';
        // Try to reach the device
        fetch('/', { method: 'HEAD', cache: 'no-store' }).then(function(r) {
          if (r.ok) {
            clearInterval(interval);
            if (progressBar) progressBar.textContent = 'Reconnected!';
            showToast('Device is back online!', 'success', 3000);
            setTimeout(function() { location.reload(); }, 1500);
          }
        }).catch(function() {}); // ignore errors, keep waiting
        if (elapsed >= maxSeconds) {
          clearInterval(interval);
          if (progressBar) { progressBar.textContent = 'Timeout - try refreshing manually'; progressBar.className = 'progress-bar warn'; }
          showToast('Device did not reconnect within ' + maxSeconds + 's', 'error', 5000);
          var btn = document.getElementById('firmwareBtn');
          btn.disabled = false;
        }
      }, 1000);
    }

    function showToast(message, status = 'success', duration = 1800) {
      const toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.remove('success', 'pending', 'error');
      toast.classList.add(status, 'show');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('show'), duration);
    }

    function HandleEnter(event, fieldId) {
      if (event.key === 'Enter') {
        event.preventDefault();
        if(fieldId === 'SaveWifiConfig') {
          SaveWifiConfig();
        } else {
          SendQueuedUpdate(fieldId);
        }
      }
    }

    function SaveWifiConfig() {
      // Collect WiFi configuration values
      const wifissidhex = document.getElementById('wifissid').value;  // hex, not text
      const wifipass = document.getElementById('wifipass').value;
      const wifihostname = document.getElementById('wifihostname').value;

      // Validate that at least SSID is provided
      if(!wifissidhex || wifissidhex.trim() === '') {
        showToast('Please select a WiFi network', 'error');
        return;
      }

      // Send WiFi configuration via JSON
      const payload = {
        wifissidhex: wifissidhex,
        wifipass: wifipass,
        wifihostname: wifihostname
      };
      
      const jsonString = JSON.stringify(payload);
      console.log('Saving WiFi config: ' + jsonString);
      showToast('Saving WiFi configuration...', 'pending');
      
      // Send directly to WebSocket without queuing
      if(websocket && websocket.readyState === WebSocket.OPEN) {
        websocket.send(jsonString);
      } else {
        showToast('WebSocket not connected', 'error');
      }
    }

    function EnqueueUpdate(fieldId) {
      if (debounceTimers[fieldId]) clearTimeout(debounceTimers[fieldId]);
      debounceTimers[fieldId] = setTimeout(() => SendQueuedUpdate(fieldId), DEBOUNCE_DELAY);
    }

    function SendQueuedUpdate(fieldId) {
      if (debounceTimers[fieldId]) clearTimeout(debounceTimers[fieldId]);
      delete debounceTimers[fieldId];

      const element = document.getElementById(fieldId);
      if (!element) {
        console.log('Element not found: ' + fieldId);
        return;
      }

      const rawValue = element.value;
      const trimmed = (rawValue === undefined || rawValue === null) ? '' : rawValue.toString().trim();
      const isPinField = PIN_FIELDS.includes(fieldId);
      const isOptionalPin = OPTIONAL_PIN_FIELDS.includes(fieldId);

      let payload;

      if (fieldId === 'wifissid') {
        // The option value is hex - send it under the key that means hex
        payload = { wifissidhex: element.options[element.selectedIndex].value };
      } else if (element.type === 'checkbox') {
        payload = { [fieldId]: element.checked };
      } else {
        if (trimmed === '') {
          if (isOptionalPin) {
            payload = { [fieldId]: 0 };  // clearing the field unassigns the pin
          } else if (element.type === 'number' || isPinField) {
            console.log('Ignoring empty value for ' + fieldId);
            return;
          } else {
            payload = { [fieldId]: '' };
          }
        } else {
          if (isPinField) {
            const parsedPin = Number(trimmed);
            if (!Number.isFinite(parsedPin) || parsedPin < (isOptionalPin ? 0 : 1)) {
              console.log('Ignoring invalid/zero pin value for ' + fieldId);
              return;
            }
          }

          let numericValue = Number(trimmed);
          if (!Number.isNaN(numericValue)) {
            if (UNIT_CONVERT_FIELDS[fieldId]) numericValue = Math.round(numericValue * UNIT_CONVERT_FIELDS[fieldId]);
            payload = { [fieldId]: numericValue };
          } else {
            payload = { [fieldId]: trimmed };
          }
        }
      }

      const item = {
        id: fieldId,
        payload: payload,
        retries: 0
      };

      /* Live-but-not-persisted controls have nothing to save, so they must not
         raise the bar. The Logs tab is matched by where the control sits rather
         than by name: it is a diagnostics pane, so nothing on it is
         configuration, and anything added there later is covered by default. */
      if (!TRANSIENT_FIELDS.includes(fieldId) && !element.closest('#logs')) markUnsaved();

      sendQueue.push(item);
      ProcessQueue();
    }

    function ProcessQueue() {
      if (sendQueue.length === 0) return;
      if (Object.keys(pendingAcks).length > 0) return; // Wait for current ack

      const item = sendQueue.shift();
      const jsonString = JSON.stringify(item.payload);
      console.log('Sending to WebSocket: ' + jsonString);
      showToast('Saving...', 'pending');

      pendingAcks[item.id] = {
        timeout: setTimeout(() => {
          delete pendingAcks[item.id];
          if (item.retries < MAX_RETRIES) {
            item.retries++;
            sendQueue.unshift(item);
            console.log('Retry ' + item.retries + ' for ' + item.id);
            ProcessQueue();
          } else {
            showToast('Failed to save ' + item.id, 'error', 2500);
            ProcessQueue();
          }
        }, ACK_TIMEOUT),
        item: item
      };

      websocket.send(jsonString);
    }

    function AckUpdate(fieldId) {
      if (pendingAcks[fieldId]) {
        clearTimeout(pendingAcks[fieldId].timeout);
        delete pendingAcks[fieldId];
        showToast('Saved', 'success');
        ProcessQueue();
      }
    }

    // Rolling snapshot of device state, so a warning can be explained using values
    // that arrived in an earlier frame rather than only what is in this message.
    const latestState = {};

    function numField(id) {
      const el = document.getElementById(id);
      if (!el || el.value === '') return null;
      const n = Number(el.value);
      return Number.isFinite(n) ? n : null;
    }

    /* ---------- Battery setup recommender ----------
       Everything on this tab is really a function of three things: chemistry,
       cells in series, and capacity. Voltages are per-cell figures multiplied
       up; currents are C-rates. Each entry is [recommended, low, high] - the
       band is deliberately wider than the recommendation, so a considered
       choice is not nagged at and only a genuinely odd value is flagged. */
    const CHEM = {
      // The cutoff lows are operating limits, not cell datasheet minimums. 2.50 V
      // is where a LiFePO4 cell is empty and being damaged, so a cutoff set there
      // has to be flagged rather than accepted as the bottom of a normal range.
      lfp: { name: 'LiFePO4',          charge: [3.45,  3.35, 3.60], flt: [3.40,  3.30, 3.45],
             ovp: [3.60,  3.50, 3.70], cut: [2.90, 2.80, 3.10] },
      nmc: { name: 'Li-ion (NMC/NCA)', charge: [4.10,  3.95, 4.20], flt: [4.05,  3.90, 4.15],
             ovp: [4.25,  4.15, 4.30], cut: [3.00, 2.90, 3.30] },
      lto: { name: 'LTO',              charge: [2.70,  2.60, 2.80], flt: [2.65,  2.55, 2.75],
             ovp: [2.80,  2.75, 2.90], cut: [1.80, 1.75, 2.00] }
    };

    // The firmware works a float target out when the field is left at 0, so say
    // what it settled on - a bare 0 otherwise reads as "no float stage".
    function updateFloatNote(activeMv, isAuto) {
      const el = document.getElementById('note_floatvoltage');
      if (!el) return;
      if (!activeMv) {
        el.textContent = 'Float stage off: the charge ends at Complete with a 0 A limit.';
      } else if (isAuto) {
        el.textContent = 'Automatic: holding ' + (activeMv / 1000).toFixed(2) + ' V.';
      } else {
        el.textContent = '';
      }
    }

    function batterySetup() {
      const el = document.getElementById('batchem');
      const chem = (el && CHEM[el.value]) ? el.value : 'lfp';
      return { chem: chem, c: CHEM[chem], cells: numField('batcells'), cap: numField('batterycapacity') };
    }

    // id -> {v: recommended, lo/hi: usual band, d: decimals, opt: 0 means "off"}
    // Entries without v are band-only: warned about, never filled in.
    function recommendations() {
      const s = batterySetup(), r = {};
      const scale = function(t, n, d) { return { v: t[0]*n, lo: t[1]*n, hi: t[2]*n, d: d }; };

      if (s.cells > 0) {
        r.chargevoltage         = scale(s.c.charge, s.cells, 1);
        r.floatvoltage          = scale(s.c.flt,    s.cells, 1); r.floatvoltage.opt = true;
        r.overvoltage           = scale(s.c.ovp,    s.cells, 1);
        r.dischargevoltage      = scale(s.c.cut,    s.cells, 1);
        r.rechargevoltageoffset = { v: 0.09*s.cells, lo: 0.04*s.cells, hi: 0.20*s.cells, d: 1 };
      }
      if (s.cap > 0) {
        r.tailcurrent   = { v: 0.01*s.cap,  lo: 0.004*s.cap, hi: 0.05*s.cap, d: 1 };
        r.floatcurrent  = { v: 0.01*s.cap,  lo: 0.002*s.cap, hi: 0.10*s.cap, d: 1, opt: true };
        r.minchargecurr = { v: Math.max(5, 0.005*s.cap), lo: 0.002*s.cap, hi: 0.05*s.cap, d: 1 };
        r.adjuststep    = { v: Math.max(1, s.cap/500),   lo: 0.2,         hi: 0.02*s.cap, d: 1 };
        // Charge and discharge ceilings are inverter limits, not battery ones -
        // flag an implausible C-rate but never fill them in.
        r.maxchargecurrent    = { lo: 0.05*s.cap, hi: 0.5*s.cap, d: 1 };
        r.maxdischargecurrent = { lo: 0.05*s.cap, hi: 1.0*s.cap, d: 1 };
      }
      r.tailduration      = { v: 240, lo: 60, hi: 900, d: 0 };
      r.maxabsorptiontime = { v: 90,  lo: 15, hi: 360, d: 0 };
      r.rechargesoc       = { v: 90,  lo: 70, hi: 95,  d: 0 };
      r.lowsoclimit       = { v: 15,  lo: 5,  hi: 40,  d: 0 };
      r.highsoclimit      = { v: 100, lo: 80, hi: 100, d: 0 };
      r.slowchargesoc1    = { v: 90,  lo: 70, hi: 97,  d: 0 };
      r.slowchargesoc1div = { v: 12,  lo: 2,  hi: 50,  d: 0 };
      r.slowchargesoc2    = { v: 95,  lo: 85, hi: 99,  d: 0 };
      r.slowchargesoc2div = { v: 24,  lo: 4,  hi: 100, d: 0 };
      return r;
    }

    function fmtRec(n, d) { return d ? n.toFixed(d) : String(Math.round(n)); }

    // Not every field was built with a message slot; make one rather than
    // adding a dozen empty divs to the markup.
    function hintSlot(id) {
      let slot = document.getElementById('err_' + id);
      if (slot) return slot;
      const el = document.getElementById(id);
      if (!el || !el.parentNode) return null;
      slot = document.createElement('div');
      slot.className = 'field-error';
      slot.id = 'err_' + id;
      el.parentNode.appendChild(slot);
      return slot;
    }

    // Runs last in validateFields, so a real error or advisory already occupying
    // a slot always wins over the generic guidance.
    function renderRecommendations() {
      const rec = recommendations();
      Object.keys(rec).forEach(function(id) {
        const el = document.getElementById(id);
        if (!el) return;
        const r = rec[id], slot = hintSlot(id);
        if (!slot || slot.classList.contains('show')) return;

        const cur = numField(id);
        let msg = (r.v !== undefined) ? 'Recommended ' + fmtRec(r.v, r.d) : '';
        let cls = 'info';
        // 0 is a deliberate special case for these fields - off, or "work it out"
        // for the float voltage - rather than an out-of-range value
        const off = r.opt && cur === 0;
        if (cur !== null && !off && r.lo !== undefined && (cur < r.lo || cur > r.hi)) {
          msg = 'Unusual - most setups are between ' + fmtRec(r.lo, r.d) + ' and ' + fmtRec(r.hi, r.d) +
                (r.v !== undefined ? ', typically ' + fmtRec(r.v, r.d) : '');
          cls = 'warn';
        }
        if (!msg) return;
        slot.textContent = msg;
        slot.className = 'field-error show ' + cls;
      });
    }

    /* An external controller can ask for less current than is configured. Say so
       plainly, because the symptom that prompted this was operators watching
       their own Max Charge setting apparently change by itself. */
    function renderControllerRequest() {
      const box = document.getElementById('ctrlRequestBox');
      if (!box) return;
      const s = latestState;
      const parts = [];
      const line = function(what, req, age, cfg) {
        if (req === undefined || req === null || req < 0) return;
        const a = (age === undefined || age === null) ? '' : ' (' + age + 's ago)';
        let t = 'limiting ' + what + ' to ' + (req * 0.001).toFixed(1) + ' A' + a;
        if (cfg !== undefined && cfg !== null) t += ', your configured ' + (cfg * 0.001).toFixed(1) + ' A is unchanged';
        parts.push(t);
      };
      line('charge', s.reqchargecurrent, s.reqchargeage, s.maxchargecurrent);
      line('discharge', s.reqdischargecurrent, s.reqdischargeage, s.maxdischargecurrent);

      if (!parts.length) { box.hidden = true; return; }
      box.hidden = false;
      box.textContent = 'An external controller is ' + parts.join('; ') +
        '. Nothing here has been overwritten - if the controller stops, the configured values return on their own.';
    }

    function renderSetupSummary() {
      const box = document.getElementById('setupSummary');
      if (!box) return;
      const s = batterySetup();
      if (!(s.cells > 0)) {
        box.textContent = 'Set the chemistry and cells in series, and every field below gets a recommended value.';
        return;
      }
      const at = function(t) { return (t[0] * s.cells).toFixed(1); };
      let txt = s.cells + 'S ' + s.c.name + ' at ' + s.c.charge[0] + ' V/cell: charge ' + at(s.c.charge) +
                ' V, float ' + at(s.c.flt) + ' V, over-voltage ' + at(s.c.ovp) +
                ' V, discharge cutoff ' + at(s.c.cut) + ' V.';
      if (s.cap > 0) {
        txt += ' At ' + s.cap + ' Ah: tail and float current ' + (0.01 * s.cap).toFixed(1) +
               ' A, slow charge ' + (s.cap / 12).toFixed(0) + ' A then ' + (s.cap / 24).toFixed(0) + ' A.';
      } else {
        txt += ' Add the capacity for the current recommendations.';
      }
      box.textContent = txt;
    }

    // Chemistry and cell count are not stored on the device - they describe the
    // pack rather than change its behaviour. Remember them per browser, and fall
    // back to working them out from the charge voltage already configured.
    // A pack voltage on its own is ambiguous - 57.0 V is 16S LiFePO4 at 3.56 V/cell
    // but equally 14S NMC at 4.07, and on pure closeness the NMC reading wins. So
    // the chemistries are tried in order of how likely they are on this device and
    // the first one that fits at all is taken, rather than the arithmetically
    // nearest. It is a starting point the summary shows back for checking, not a
    // detection - anything the user picks is remembered instead.
    const CHEM_LIKELIHOOD = ['lfp', 'nmc', 'lto'];
    // Series counts people actually build, most common first. Picking purely on
    // closeness reads 57.0 V as 17S at 3.353 V/cell, because that is nearer 3.45
    // than 16S at 3.5625 - arithmetically true, and not a pack anyone owns.
    const COMMON_CELLS = [16, 8, 15, 4, 24, 20, 14, 13, 12, 10, 7, 6];

    function inferSetup() {
      const cv = numField('chargevoltage');
      if (!(cv > 0)) return null;
      for (let i = 0; i < CHEM_LIKELIHOOD.length; i++) {
        const k = CHEM_LIKELIHOOD[i], per = CHEM[k].charge;
        const fits = function(n) { const v = cv / n; return v >= per[1] && v <= per[2]; };
        for (let j = 0; j < COMMON_CELLS.length; j++) {
          if (fits(COMMON_CELLS[j])) return { chem: k, cells: COMMON_CELLS[j] };
        }
        let best = null;
        for (let n = 3; n <= 32; n++) {
          if (!fits(n)) continue;
          const err = Math.abs(cv / n - per[0]);
          if (!best || err < best.err) best = { chem: k, cells: n, err: err };
        }
        if (best) return best;
      }
      return null;
    }

    function loadBatterySetup() {
      let chem = null, cells = null;
      try { chem = localStorage.getItem('bmsChem'); cells = localStorage.getItem('bmsCells'); } catch (e) {}
      if (!chem || !cells) {
        const guess = inferSetup();
        if (guess) { chem = guess.chem; cells = guess.cells; }
      }
      const ce = document.getElementById('batchem'), ne = document.getElementById('batcells');
      if (ce && chem && CHEM[chem]) ce.value = chem;
      if (ne && cells && !ne.value) ne.value = cells;
      renderSetupSummary();
      validateFields();
    }

    function onBatterySetupChange() {
      try {
        localStorage.setItem('bmsChem', document.getElementById('batchem').value);
        localStorage.setItem('bmsCells', document.getElementById('batcells').value);
      } catch (e) {}
      renderSetupSummary();
      validateFields();
    }

    function applyRecommended() {
      const rec = recommendations(), changes = [];
      Object.keys(rec).forEach(function(id) {
        const r = rec[id], el = document.getElementById(id);
        if (!el || r.v === undefined) return;
        const want = r.d ? Number(r.v.toFixed(r.d)) : Math.round(r.v);
        const cur = numField(id);
        if (cur !== null && Math.abs(cur - want) < (r.d ? 0.05 : 0.5)) return;
        changes.push({ id: id, from: (cur === null ? 'empty' : cur), to: want, d: r.d });
      });

      if (!changes.length) {
        showToast('Everything already matches the recommendations', 'success');
        return;
      }
      const label = function(id) {
        const l = document.querySelector('label[for="' + id + '"]');
        return l ? l.textContent.replace(/:\s*$/, '') : id;
      };
      askConfirm({
        title: 'Apply Recommended Values',
        body: changes.length + ' settings will change:\n\n' +
              changes.map(function(c) { return '• ' + label(c.id) + ':  ' + c.from + '  →  ' + c.to; }).join('\n') +
              '\n\nMax charge and discharge currents are left alone - those are inverter limits, not battery ones.',
        okLabel: 'Apply'
      }).then(function(ok) {
        if (!ok) return;
        changes.forEach(function(c) {
          const el = document.getElementById(c.id);
          el.value = c.d ? c.to.toFixed(c.d) : c.to;
          EnqueueUpdate(c.id);
        });
        validateFields();
        showToast('Applied ' + changes.length + ' values - Save to EEPROM to keep them', 'success', 5000);
      });
    }

    // Work out WHY charge or discharge is inhibited. The device reports the outcome;
    // this reconstructs the most likely cause from the configured limits so the user
    // isn't left guessing. Ordered most-specific first.
    function inhibitReason(kind) {
      const s = latestState;
      const soc = s.soc;
      const temp = s.batttemp;
      const tempOn = document.getElementById('tempprotection') &&
                     document.getElementById('tempprotection').checked;

      if (kind === 'charge') {
        const high = numField('highsoclimit');
        if (high !== null && high < 100 && soc >= high) return 'SOC has reached the ' + high + '% charge limit';
        if (tempOn && temp !== undefined && temp !== null) {
          const hi = numField('chargehightemp'), lo = numField('chargelowtemp');
          if (hi !== null && temp >= hi) return 'battery at ' + temp + '°C, above the ' + hi + '°C charge limit';
          if (lo !== null && temp <= lo) return 'battery at ' + temp + '°C, below the ' + lo + '°C charge limit';
        }
        const ov = numField('overvoltage');
        if (ov !== null && s.battvoltage !== undefined && (s.battvoltage * 0.01) >= ov) {
          return 'pack at ' + (s.battvoltage * 0.01).toFixed(1) + 'V, at or above the ' + ov + 'V cutoff';
        }
        if (s.chargephase === 'Complete') return 'charge cycle complete';
        return 'manually disabled or inhibited by the BMS';
      }

      const low = numField('lowsoclimit');
      if (low !== null && low > 0 && soc <= low) return 'SOC has reached the ' + low + '% discharge floor';
      if (tempOn && temp !== undefined && temp !== null) {
        const hi = numField('dischargehightemp'), lo = numField('dischargelowtemp');
        if (hi !== null && temp >= hi) return 'battery at ' + temp + '°C, above the ' + hi + '°C discharge limit';
        if (lo !== null && temp <= lo) return 'battery at ' + temp + '°C, below the ' + lo + '°C discharge limit';
      }
      return 'manually disabled or inhibited by the BMS';
    }

    /* ---------- Absorption progress ---------- */
    function fmtDuration(s) {
      s = Math.max(0, Math.round(s));
      if (s < 60) return s + 's';
      const m = Math.floor(s / 60), r = s % 60;
      if (m < 60) return r ? m + 'm ' + r + 's' : m + 'm';
      const h = Math.floor(m / 60);
      // Days, matching what fmtDuration() in Diagnostics.cpp prints to serial,
      // so uptime reads the same in both places. A board up for a fortnight
      // saying "336h" is a number nobody converts in their head.
      if (h < 24) return (m % 60) ? h + 'h ' + (m % 60) + 'm' : h + 'h';
      const d = Math.floor(h / 24);
      return (h % 24) ? d + 'd ' + (h % 24) + 'h' : d + 'd';
    }

    function updateAbsorption() {
      const panel = document.getElementById('absorbPanel');
      if (!panel) return;

      const s = latestState;
      if (s.chargephase !== 'Absorption') { panel.hidden = true; return; }
      panel.hidden = false;

      const tailHeld = s.tailheld || 0;
      const tailNeed = s.tailneed || 0;
      const elapsed  = s.absorbelapsed || 0;
      const maxAbs   = s.absorbmax || 0;
      const running  = !!s.tailactive;

      // Tail-current hold
      const tailBar = document.getElementById('tailBar');
      const tailPct = tailNeed > 0 ? Math.min(100, (tailHeld / tailNeed) * 100) : 0;
      tailBar.style.width = tailPct + '%';
      tailBar.classList.toggle('running', running);
      document.getElementById('tailVal').textContent =
        tailNeed > 0 ? fmtDuration(tailHeld) + ' / ' + fmtDuration(tailNeed) : 'off';

      // Max absorption safety timeout
      const absBar = document.getElementById('absorbBar');
      const absPct = maxAbs > 0 ? Math.min(100, (elapsed / maxAbs) * 100) : 0;
      absBar.style.width = absPct + '%';
      document.getElementById('absorbVal').textContent =
        maxAbs > 0 ? fmtDuration(elapsed) + ' / ' + fmtDuration(maxAbs) : fmtDuration(elapsed);

      // Headline: whichever race finishes first
      const tailLeft = tailNeed > 0 && running ? tailNeed - tailHeld : null;
      const absLeft  = maxAbs > 0 ? maxAbs - elapsed : null;
      let summary;
      if (tailLeft !== null && (absLeft === null || tailLeft <= absLeft)) {
        summary = 'Complete in ' + fmtDuration(tailLeft) + ' if current stays low';
      } else if (absLeft !== null) {
        summary = 'Times out in ' + fmtDuration(absLeft);
      } else {
        summary = 'Running for ' + fmtDuration(elapsed);
      }
      document.getElementById('absorbSummary').textContent = summary;

      // Explain the tail timer. It needs BOTH a low current and the pack still
      // held near the charge target, so name whichever one is actually blocking -
      // reporting only the current sends people hunting the wrong number.
      const thresholdA = (s.tailthreshold || 0) / 1000;
      const currentA = (s.battcurrent || 0) * 0.1;
      const voltOK = s.tailvoltok !== false;
      const voltMin = (s.tailvoltmin || 0) / 100;
      const voltNow = (s.battvoltage || 0) / 100;
      const note = document.getElementById('absorbNote');

      if (tailNeed <= 0) {
        note.textContent = 'Tail current detection is disabled, so absorption will run until the max absorption time is reached.';
      } else if (running) {
        note.textContent = 'Charge current is below the ' + thresholdA.toFixed(1) +
          ' A tail threshold and the pack is at charge voltage. If either stops being true, this timer resets to zero.';
      } else if (currentA >= thresholdA) {
        note.textContent = 'Waiting for charge current to fall below the ' + thresholdA.toFixed(1) +
          ' A tail threshold - currently ' + currentA.toFixed(1) + ' A.';
      } else if (!voltOK && voltMin > 0) {
        note.textContent = 'Current is already low enough at ' + currentA.toFixed(1) +
          ' A, but the pack must also be at ' + voltMin.toFixed(2) + ' V or above for it to count as tail current - currently ' +
          voltNow.toFixed(2) + ' V. Absorption will end on the timeout instead.';
      } else {
        note.textContent = 'Waiting for charge current to fall below the ' + thresholdA.toFixed(1) +
          ' A tail threshold. The hold timer starts once it does.';
      }
    }

    /* ---------- SOC override ----------
       Must stay in step with enum SOCOverride in CANBUS.h. */
    const SOC_OVERRIDE_WHY = {
      1: 'Force charge is active and the SOC trick is enabled, so the inverter is sent one tenth of the real SOC to make it charge harder.',
      2: 'The Smart Shunt is reporting 100% but full charge voltage has not been reached.',
      3: '"Never send 100% SOC" is enabled, so 99% is sent to stop the inverter shutting down solar export.'
    };

    function updateSOCOverride() {
      const box = document.getElementById('socOverride');
      const gauge = document.getElementById('batteryGauge');
      if (!box) return;

      const reason = latestState.socoverride || 0;
      const reported = latestState.reportedsoc;

      // Only worth showing when what we send actually differs from what we display
      const differs = reason !== 0 && reported !== undefined && reported !== latestState.soc;
      box.hidden = !differs;
      if (gauge) gauge.classList.toggle('overridden', differs);

      if (!differs) return;
      document.getElementById('reportedSocValue').textContent = reported + '%';
      document.getElementById('socOverrideWhy').textContent = SOC_OVERRIDE_WHY[reason] || '';
      if (gauge) {
        gauge.setAttribute('aria-label',
          'Battery state of charge ' + latestState.soc + '%, reported to inverter as ' + reported + '%');
      }
    }

    function updateWarnings() {
      const warningsDiv = document.getElementById('statusWarnings');
      const warningText = document.getElementById('warningText');
      if (!warningsDiv || !warningText) return;

      const s = latestState;
      const soc = s.soc;
      const warnings = [];
      let critical = false;

      if (soc !== undefined) {
        if (soc <= 10) { warnings.push(['Critically low battery: ' + soc + '%', '']); critical = true; }
        else if (soc <= 20) { warnings.push(['Low battery: ' + soc + '%', '']); }
      }

      // No SOC gating here: a disabled charge at 85% is exactly the case the old
      // `soc < 80` guard hid, and it is the one most worth reporting.
      if (s.chargeenabled === false) {
        warnings.push(['Charging disabled', inhibitReason('charge')]);
      }
      if (s.dischargeenabled === false) {
        warnings.push(['Discharge disabled', inhibitReason('discharge')]);
        critical = critical || (soc !== undefined && soc > 20);
      }
      /* Force charge and the full charge request both travel in 0x35C. With that
         message switched off, or on a protocol that does not carry it, setting
         them changes nothing on the wire - a silent no-op that used to leave
         people watching a battery that never charged. The SOC trick is a
         separate lever, so force charge still does something without the flags. */
      if (s.forcecharge) {
        if (s.requestflagsactive === false && !s.soctrickactive) {
          warnings.push(['Force charge is not reaching the inverter',
                         'the 0x35C request flags are off, or this CAN protocol does not send them']);
        } else {
          warnings.push(['Force charge active', 'the inverter is being told to charge at maximum']);
        }
      }
      if (s.requestfullcharge) {
        warnings.push(s.requestflagsactive === false
          ? ['Full charge request is not reaching the inverter',
             'it is only sent with Request Flags enabled on Pylontech 1.2 or Growatt']
          : ['Full charge requested', 'the inverter has been asked to charge to 100% next time']);
      }
      if (s.victrondata === false) {
        warnings.push(['No shunt data', 'voltage, current and SOC are not being updated']);
        critical = true;
      }

      if (warnings.length === 0) { warningsDiv.hidden = true; return; }

      warningText.textContent = '';
      warnings.forEach(function(w) {
        const row = document.createElement('div');
        row.textContent = w[0];
        if (w[1]) {
          const why = document.createElement('span');
          why.className = 'why';
          why.textContent = ' — ' + w[1];
          row.appendChild(why);
        }
        warningText.appendChild(row);
      });
      warningsDiv.className = 'status-warnings' + (critical ? ' error' : '');
      warningsDiv.hidden = false;
    }

    /* ---------- Cross-field validation ---------- */
    // Pairs where one value must not cross another. These are safety-relevant:
    // nothing in the firmware stops you setting a charge target above the
    // over-voltage cutoff, so flag it at the point of entry.
    const FIELD_RULES = [
      { a: 'chargevoltage',     b: 'overvoltage',        cmp: '<',  msg: 'Charge voltage must be below the over-voltage cutoff.' },
      { a: 'dischargevoltage',  b: 'chargevoltage',      cmp: '<',  msg: 'Discharge voltage must be below the charge voltage.' },
      { a: 'lowsoclimit',       b: 'highsoclimit',       cmp: '<',  msg: 'Low SOC limit must be below the high SOC limit.' },
      { a: 'minchargecurr',     b: 'maxchargecurrent',   cmp: '<=', msg: 'Min charge current cannot exceed max charge current.' },
      { a: 'floatvoltage',      b: 'chargevoltage',      cmp: '<',  msg: 'Float voltage must be below the charge voltage, or the float stage is ignored.' },
      { a: 'chargelowtemp',     b: 'chargehightemp',     cmp: '<',  msg: 'Charge low temp must be below charge high temp.' },
      { a: 'dischargelowtemp',  b: 'dischargehightemp',  cmp: '<',  msg: 'Discharge low temp must be below discharge high temp.' },
      { a: 'fanofftemp',        b: 'fanfulltemp',        cmp: '<',  msg: 'Fan off temp must be below fan full-speed temp.' }
    ];

    function validateFields() {
      document.querySelectorAll('.field-error').forEach(function(e) {
        e.classList.remove('show', 'warn', 'info'); e.textContent = '';
      });
      document.querySelectorAll('input.invalid, input.warn').forEach(function(e) {
        e.classList.remove('invalid', 'warn');
      });

      let bad = 0;
      FIELD_RULES.forEach(function(rule) {
        const av = numField(rule.a), bv = numField(rule.b);
        if (av === null || bv === null) return;
        const ok = rule.cmp === '<' ? av < bv : av <= bv;
        if (ok) return;
        bad++;
        [rule.a, rule.b].forEach(function(id) {
          const el = document.getElementById(id);
          if (el) el.classList.add('invalid');
        });
        const slot = document.getElementById('err_' + rule.a);
        if (slot) { slot.textContent = rule.msg; slot.classList.add('show'); }
      });

      // --- Recharge advisories ---
      // These are accepted values that produce surprising charge behaviour, so
      // they warn (amber) rather than invalidate. They do not block saving.
      const rsoc = numField('rechargesoc');
      const roff = numField('rechargevoltageoffset');

      function advise(id, msg) {
        const el = document.getElementById(id);
        const slot = document.getElementById('err_' + id);
        if (el) el.classList.add('warn');
        if (slot) { slot.textContent = msg; slot.classList.add('show', 'warn'); }
      }

      if (rsoc === 0 && roff === 0) {
        // Both exit conditions from the Complete phase are disabled, so charging
        // would never restart until the device is rebooted.
        advise('rechargesoc', 'With both this and Recharge V Offset at 0, charging will never restart after it completes. Set at least one.');
        advise('rechargevoltageoffset', 'Set either this or Recharge SOC above 0, or the charge cycle cannot restart.');
      } else if (rsoc === 100) {
        // Voltage sags once charging stops, so SOC dips below 100 immediately and
        // the pack would re-enter Bulk forever instead of resting.
        advise('rechargesoc', 'At 100 the pack restarts charging as soon as it finishes, and never rests. 90-95 is typical.');
      }

      if (roff !== null && roff > 0 && roff < 0.1) {
        advise('rechargevoltageoffset', 'Below 0.10 V leaves too little margin against the phase-change threshold. The firmware will clamp it to 0.06 V.');
      }

      // --- Float advisories ---
      // A float stage that allows no current is the same instruction the Complete
      // phase gives, which is what the float stage exists to avoid.
      const fv = numField('floatvoltage');
      const fc = numField('floatcurrent');
      const dv = numField('dischargevoltage');

      if (fv !== null && fv > 0) {
        if (fc === 0) {
          advise('floatcurrent', 'At 0 A the inverter is told to hold a voltage it may not charge towards. Some inverters discharge the pack to obey that. Allow at least 1-2 A.');
        }
        if (dv !== null && fv <= dv) {
          advise('floatvoltage', 'At or below the discharge voltage, so the pack would float at its cutoff. Set it between the discharge and charge voltages.');
        }
      }

      // A malformed POSIX TZ string doesn't error - the C library just falls back
      // to UTC - so catch the common mistake of entering an IANA zone name.
      const tzEl = document.getElementById('timezone');
      if (tzEl) {
        const v = tzEl.value.trim();
        if (v.indexOf('/') >= 0 && !/,M\d/.test(v)) {
          advise('timezone', 'This looks like an IANA name (Europe/London). The device needs a POSIX TZ string - pick your region from the dropdown instead.');
        } else if (v.length === 0) {
          advise('timezone', 'Empty - the device will fall back to ' + 'GMT0BST,M3.5.0/1,M10.5.0' + '.');
        }
      }

      // Syslog only accepts a literal IPv4 address - the firmware never resolves
      // hostnames, so a name here would silently send nothing at all.
      const sysEn = document.getElementById('syslogenabled');
      const sysSrv = document.getElementById('syslogserver');
      if (sysEn && sysSrv && sysEn.checked) {
        const v = sysSrv.value.trim();
        const ok = /^(\d{1,3}\.){3}\d{1,3}$/.test(v) &&
                   v.split('.').every(function(o) { return Number(o) <= 255; });
        if (!ok) {
          bad++;
          sysSrv.classList.add('invalid');
          const slot = document.getElementById('err_syslogserver');
          if (slot) {
            slot.textContent = v ? 'Must be an IPv4 address such as 192.168.1.10 - hostnames are not resolved.'
                                 : 'Enter the IP address of your syslog collector, or turn remote logging off.';
            slot.classList.add('show');
          }
        }
      }

      // Last, so anything above has already claimed the slots it needs
      renderRecommendations();

      return bad === 0;
    }

    function initValidation() {
      const ids = { syslogserver: 1, rechargesoc: 1, rechargevoltageoffset: 1, timezone: 1,
                    floatvoltage: 1, floatcurrent: 1, dischargevoltage: 1 };
      FIELD_RULES.forEach(function(r) { ids[r.a] = 1; ids[r.b] = 1; });
      // Every field the recommender has an opinion on re-checks as it is typed
      Object.keys(recommendations()).forEach(function(id) { ids[id] = 1; });
      Object.keys(ids).forEach(function(id) {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', validateFields);
      });
      const sysEn = document.getElementById('syslogenabled');
      if (sysEn) sysEn.addEventListener('change', validateFields);
    }

    const LOG_RANK = { debug: 0, info: 1, warning: 2, error: 3 };
    const LOG_CAP = 500;

    /* Sniffer output is picked out by the shape of the message, because both
       sniffers log at info level and so cannot be separated by rank. The
       firmware owns these formats - SnifferLogFrame() in CANBUS.cpp and
       ParseAdvert() in VictronBLE.cpp - so keep the patterns in step with them. */
    function snifferKind(message) {
      if (/^CAN RX 0x/.test(message)) return 'can';
      if (/^Victron BLE [0-9a-f]{2}:/i.test(message)) return 'ble';
      return '';
    }

    function logVisible(level, kind) {
      const sel = document.getElementById('loglevel');
      const want = sel ? sel.value : 'all';
      if (want === 'can' || want === 'ble') return kind === want;
      if (want === 'all') return true;
      return (LOG_RANK[level] || 0) >= (LOG_RANK[want] || 0);
    }

    function applyLogFilter() {
      document.querySelectorAll('#logviewer .log-entry').forEach(function(e) {
        const lvl = (e.className.match(/log-entry (\w+)/) || [])[1] || 'info';
        e.classList.toggle('hidden', !logVisible(lvl, e.dataset.kind || ''));
      });
    }

    /* Ticking a sniffer switches the view to its output, which is what it was
       ticked for; unticking restores whatever was selected before. The dropdown
       stays usable throughout - this only moves it on the transition. */
    let preSnifferLevel = null;
    function syncSnifferFilter(kind) {
      const box = document.getElementById(kind === 'ble' ? 'blesniffer' : 'cansniffer');
      const sel = document.getElementById('loglevel');
      if (!box || !sel) return;
      if (box.checked) {
        if (sel.value !== 'can' && sel.value !== 'ble') preSnifferLevel = sel.value;
        sel.value = kind;
      } else if (sel.value === kind) {
        // Hand over to the other sniffer if it is still running, rather than
        // dropping the user back to a firehose they did not ask for.
        const other = kind === 'ble' ? 'cansniffer' : 'blesniffer';
        const otherBox = document.getElementById(other);
        sel.value = (otherBox && otherBox.checked) ? (kind === 'ble' ? 'can' : 'ble')
                                                   : (preSnifferLevel || 'all');
        if (!otherBox || !otherBox.checked) preSnifferLevel = null;
      }
      applyLogFilter();
    }

    // ageMs, when present, is how long before now the device logged the line -
    // replayed backlog. Without it every replayed line took the arrival time and
    // a six-minute history collapsed onto a single second.
    function addLogEntry(message, level, ageMs) {
      if(document.getElementById('logpause').checked) return;

      const logViewer = document.getElementById('logviewer');
      const entry = document.createElement('div');
      const kind = snifferKind(message);
      entry.className = 'log-entry ' + level;
      if (kind) entry.dataset.kind = kind;
      if (!logVisible(level, kind)) entry.classList.add('hidden');

      const when = (typeof ageMs === 'number' && ageMs >= 0)
        ? new Date(Date.now() - ageMs)
        : new Date();
      const timestamp = when.toLocaleTimeString('en-GB', { hour12: false });
      entry.textContent = '[' + timestamp + '] ' + message;

      logViewer.appendChild(entry);

      // Ring-buffer the view. The cap is deliberate, so say so rather than
      // silently dropping the oldest lines.
      let dropped = 0;
      while(logViewer.children.length > LOG_CAP) {
        logViewer.removeChild(logViewer.firstChild);
        dropped++;
      }
      if (dropped && !logViewer.dataset.trimmed) {
        logViewer.dataset.trimmed = '1';
        console.info('Log view capped at ' + LOG_CAP + ' entries; older lines dropped from the browser only.');
      }

      if(document.getElementById('autoscroll').checked) {
        logViewer.scrollTop = logViewer.scrollHeight;
      }
    }

    function logsAsText() {
      return Array.from(document.querySelectorAll('#logviewer .log-entry'))
        .filter(function(e) { return !e.classList.contains('hidden'); })
        .map(function(e) { return e.textContent; })
        .join('\n');
    }

    function copyLogs() {
      const text = logsAsText();
      if (!text) { showToast('No log entries to copy', 'error'); return; }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text)
          .then(function() { showToast('Logs copied to clipboard', 'success'); })
          .catch(function() { showToast('Clipboard blocked - use Download instead', 'error', 3500); });
      } else {
        // Non-secure origins (plain http on a LAN IP) have no Clipboard API
        showToast('Clipboard unavailable over http - use Download', 'error', 3500);
      }
    }

    function downloadLogs() {
      const text = logsAsText();
      if (!text) { showToast('No log entries to download', 'error'); return; }
      const host = document.getElementById('wifihostname');
      const blob = new Blob([text], { type: 'text/plain' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = (host && host.value ? host.value : 'diybms') + '-log.txt';
      a.click();
      URL.revokeObjectURL(a.href);
      showToast('Log downloaded', 'success');
    }

    function clearLogs() {
      const v = document.getElementById('logviewer');
      v.textContent = '';
      delete v.dataset.trimmed;
    }
    
    function GetWifiList() {
      console.log("Requesting WiFi scan");
      // Save the currently selected SSID before clearing
      var select = document.getElementById('wifissid');
      if(select.value && select.value !== 'Please Wait...') {
        savedWifiSSID = select.value;
        console.log("Saved current WiFi SSID: " + savedWifiSSID);
      }
      // Show "Please Wait" in the dropdown - make it selected so it displays
      select.innerHTML = '';
      var el = document.createElement('option');
      el.textContent = 'Please Wait...';
      el.disabled = true;
      el.selected = true;  // Make it selected so it shows
      select.appendChild(el);
      // Send request via WebSocket
      websocket.send('GetWifiScan()');
      // The results will arrive asynchronously via the wifinetworks message
    }
    
    function DedupeNetworks(networks) {
      // Create a map to store the best signal strength for each SSID
      const ssidMap = {};
      
      networks.forEach(network => {
        const key = networkKey(network);
        if(key) {
          // Keep the network with the strongest signal (highest RSSI value)
          if(!ssidMap[key] || network.rssi > ssidMap[key].rssi) {
            ssidMap[key] = network;
          }
        }
      });
      
      // Convert map back to array and sort by signal strength (strongest first)
      const deduped = Object.values(ssidMap).sort((a, b) => {
        // Sort by RSSI in descending order (higher signal strength first)
        return b.rssi - a.rssi;
      });
      
      console.log("Deduplicated networks: " + networks.length + " -> " + deduped.length);
      return deduped;
    }
    
    // Key by the bytes, never the name: two networks whose names both decode to
    // the same unreadable placeholder are still two different networks.
    function networkKey(network) {
      return network.ssidhex || ssidTextToHex(network.ssid || '');
    }

    function PopulateWifiList(networks) {
      console.log("Populating WiFi list with " + networks.length + " networks");
      
      // Deduplicate networks, keeping the one with best signal for each SSID
      const deduped = DedupeNetworks(networks);
      
      var select = document.getElementById("wifissid");
      document.getElementById('wifissid').innerHTML = '';

      deduped.forEach(network => {
        var el = document.createElement("option");
        const key = networkKey(network);
        // RSSI is already known here - showing it beats making the user guess
        // which of two similarly-named networks is the reachable one.
        el.textContent = (network.ssid || ssidHexToText(key)) + '   ' + signalBars(network.rssi) + ' ' + network.rssi + ' dBm';
        el.value = key;   // hex, so selecting it saves the exact broadcast bytes

        if(key === savedWifiSSID) el.selected = true;
        select.appendChild(el);
      });

      if(deduped.length === 0) {
        var none = document.createElement('option');
        none.textContent = 'No networks found';
        none.disabled = true;
        none.selected = true;
        select.appendChild(none);
        showToast('No WiFi networks found', 'error');
      } else {
        showToast('Found ' + deduped.length + ' networks', 'success');
      }
    }

    function signalBars(rssi) {
      if (rssi >= -55) return '||||';
      if (rssi >= -67) return '|||.';
      if (rssi >= -78) return '||..';
      return '|...';
    }
  </script>
</body>
</html>
