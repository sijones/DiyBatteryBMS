# Web flasher. site/ is a deploy directory, not a source directory: app.js is
# the esbuild bundle of web/src, and firmware/ is filled by build-manifests.mjs
# from .pio/build. Both are rebuilt by `npm run deploy` before wrangler uploads
# them, so git tracks what they are built from and nothing else.
